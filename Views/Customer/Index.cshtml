                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Email nhận thông báo kho</label>
                        <input type="email" name="email" id="editEmail" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-muted">Địa chỉ nhận hàng / Giao kho</label>
                        <input type="text" name="address" id="editAddress" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold text-muted">Ghi chú / Hạn mức công nợ</label>
                        <textarea name="note" id="editNote" class="form-control form-control-sm" rows="2"></textarea>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editIsActive" />
                            <label class="form-check-label small fw-semibold" for="editIsActive">Đang hoạt động</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

