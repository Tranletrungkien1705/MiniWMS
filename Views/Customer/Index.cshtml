@section Scripts {
<script>
function openEditModal(id, code, name, type, contactName, contactPhone, phone, email, address, province, areaCode, customerGrpCode, taxCode, note, isActive) {
    document.getElementById('editId').value = id;
    document.getElementById('editCode').value = code;
    document.getElementById('editName').value = name;
    document.getElementById('editCustomerType').value = type || 'Đại lý phân phối';
    document.getElementById('editContactName').value = contactName;
    document.getElementById('editContactPhone').value = contactPhone;
    document.getElementById('editPhone').value = phone;
    document.getElementById('editEmail').value = email;
    document.getElementById('editAddress').value = address;
    document.getElementById('editProvince').value = province;
    document.getElementById('editAreaCode').value = areaCode || '';
    document.getElementById('editCustomerGrpCode').value = customerGrpCode || '';
    document.getElementById('editTaxCode').value = taxCode;
    document.getElementById('editNote').value = note;
    document.getElementById('editIsActive').checked = isActive;
    new bootstrap.Modal(document.getElementById('editCustomerModal')).show();
}

async function openDetailModal(id) {
    const modalEl = document.getElementById('customerDetailModal');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    document.getElementById('tableBodyStockDoc').innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Đang tải...</td></tr>';
    document.getElementById('tableBodyOutFG').innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Đang tải...</td></tr>';
    document.getElementById('tableBodyReturn').innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Đang tải...</td></tr>';

    try {
        const res = await fetch(`/Customer/Detail/${id}`);
        if (!res.ok) throw new Error('Không tải được thông tin khách hàng');
        const data = await res.json();
        const c = data.customer;

        document.getElementById('detailCustomerTitle').innerHTML = `<i class="bi bi-person-lines-fill me-1"></i> ${c.name} <span class="badge bg-primary ms-1">${c.code}</span>`;
        document.getElementById('detailCustomerSub').innerText = `${c.customerType} · Người liên hệ: ${c.contactName || '—'} · Địa chỉ: ${c.address || '—'}`;
        document.getElementById('detailTaxCode').innerText = c.taxCode || '—';
        document.getElementById('detailPhone').innerText = c.phone || c.contactPhone || '—';
        document.getElementById('detailTotalOut').innerText = (data.totalOutQty || 0).toLocaleString('vi-VN');
        document.getElementById('detailTotalReturn').innerText = (data.totalReturnQty || 0).toLocaleString('vi-VN');

        document.getElementById('countStockDoc').innerText = data.outDocs ? data.outDocs.length : 0;
        document.getElementById('countOutFG').innerText = data.outFGDocs ? data.outFGDocs.length : 0;
        document.getElementById('countReturn').innerText = data.returns ? data.returns.length : 0;

        // Render StockDoc
        if (data.outDocs && data.outDocs.length > 0) {
            document.getElementById('tableBodyStockDoc').innerHTML = data.outDocs.map(d => `
                <tr>
                    <td class="fw-semibold font-monospace">${d.code}</td>
                    <td>${d.warehouse}</td>
                    <td class="small text-muted">${d.date}</td>
                    <td class="text-end fw-bold text-primary">${d.totalQty.toLocaleString('vi-VN')}</td>
                    <td class="small">${d.refNo || '—'}</td>
                    <td><span class="badge ${d.status === 'Posted' ? 'bg-success' : 'bg-secondary'}">${d.status}</span></td>
                    <td class="text-end"><a href="/Doc/Detail/${d.id}" class="btn btn-xs btn-outline-primary py-0 px-2" target="_blank"><i class="bi bi-eye"></i></a></td>
                </tr>
            `).join('');
        } else {
            document.getElementById('tableBodyStockDoc').innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Chưa có phiếu xuất kho thông thường nào.</td></tr>';
        }

        // Render OutFG
        if (data.outFGDocs && data.outFGDocs.length > 0) {
            document.getElementById('tableBodyOutFG').innerHTML = data.outFGDocs.map(f => `
                <tr>
                    <td class="fw-semibold font-monospace">${f.code}</td>
                    <td>${f.warehouse}</td>
                    <td class="small text-muted">${f.date}</td>
                    <td class="text-end fw-bold text-primary">${f.totalQty.toLocaleString('vi-VN')}</td>
                    <td class="small text-truncate" style="max-width:180px;">${f.deliveryAddress || '—'}</td>
                    <td class="small">${f.plateNo || '—'}</td>
                    <td><span class="badge ${f.status === 'Approved' ? 'bg-success' : 'bg-warning text-dark'}">${f.status}</span></td>
                    <td class="text-end"><a href="/InventoryOutFG/Detail/${f.id}" class="btn btn-xs btn-outline-primary py-0 px-2" target="_blank"><i class="bi bi-eye"></i></a></td>
                </tr>
            `).join('');
        } else {
            document.getElementById('tableBodyOutFG').innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Chưa có phiếu xuất thành phẩm nào.</td></tr>';
        }

        // Render Return
        if (data.returns && data.returns.length > 0) {
            document.getElementById('tableBodyReturn').innerHTML = data.returns.map(r => `
                <tr>
                    <td class="fw-semibold font-monospace">${r.code}</td>
                    <td>${r.warehouse}</td>
                    <td class="small text-muted">${r.date}</td>
                    <td class="text-end fw-bold text-danger">${r.totalQty.toLocaleString('vi-VN')}</td>
                    <td class="small">${r.invoiceNo || '—'}</td>
                    <td class="small text-truncate" style="max-width:180px;">${r.reason || '—'}</td>
                    <td><span class="badge ${r.status === 'Approved' ? 'bg-success' : 'bg-secondary'}">${r.status}</span></td>
                    <td class="text-end"><a href="/CustomerReturn/Detail/${r.id}" class="btn btn-xs btn-outline-primary py-0 px-2" target="_blank"><i class="bi bi-eye"></i></a></td>
                </tr>
            `).join('');
        } else {
            document.getElementById('tableBodyReturn').innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">Chưa có phiếu khách trả lại nào.</td></tr>';
        }

    } catch (err) {
        document.getElementById('tableBodyStockDoc').innerHTML = `<tr><td colspan="7" class="text-danger text-center py-3">${err.message}</td></tr>`;
    }
}
</script>
}
