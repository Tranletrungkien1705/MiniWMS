@model InventoryInTypeReport
@{
    ViewData["Title"] = "Loại nhập kho";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
    var statisticOnly = (bool?)ViewBag.StatisticOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-box-arrow-in-down-right text-primary me-2"></i>Danh mục Loại hình & Lý do Nhập kho</h5>
        <div class="text-muted small">Port từ <code>Mst_InvInType</code> (Skycic) — Chuẩn hóa danh mục hình thức và lý do nhập kho (Nhập mua NCC, Nhập thành phẩm SX KCS, Nhập khách hàng đổi trả, Nhập nhận điều chuyển, Nhập cân bằng kiểm kê thừa, Nhập hàng mẫu), quản lý cờ tính thống kê luân chuyển (<code>FlagStatistic</code>) và trạng thái áp dụng</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/InventoryInType/ExportCsv?q=@keyword&activeOnly=@activeOnly&statisticOnly=@statisticOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/Doc?type=In" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-journal-text me-1"></i> Phiếu nhập kho
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createInventoryInTypeModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Loại nhập kho
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG SỐ LOẠI NHẬP</span>
                    <i class="bi bi-box-arrow-in-down-right text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalTypes</div>
                <div class="small text-muted">Quy chuẩn hình thức nhập kho WMS</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Khả dụng khi tạo phiếu nhập kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TÍNH THỐNG KÊ (FLAG)</span>
                    <i class="bi bi-graph-up-arrow text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary">@Model.StatisticCount</div>
                <div class="small text-muted">Tính vào chỉ tiêu mua hàng / chi phí</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">NGỪNG ÁP DỤNG</span>
                    <i class="bi bi-pause-circle text-warning fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-warning">@Model.InactiveCount</div>
                <div class="small text-muted">Tạm khóa / Dự phòng hệ thống</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Tìm kiếm theo mã loại nhập, tên loại hoặc quy trình..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Trạng thái: Tất cả --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Ngừng áp dụng</!option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="statisticOnly" class="form-select form-select-sm">
                    <option value="">-- Cờ thống kê: Tất cả --</option>
                    <!option value="true" @(statisticOnly == true ? "selected" : "")>Có tính thống kê mua/SL</!option>
                    <!option value="false" @(statisticOnly == false ? "selected" : "")>Không tính thống kê</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/InventoryInType" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Loại nhập kho -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th style="width: 140px;">Mã loại nhập</th>
                        <th>Tên loại nhập kho</th>
                        <th>Quy trình / Diễn giải nghiệp vụ</th>
                        <th class="text-center" style="width: 150px;">Cờ thống kê</th>
                        <th class="text-center" style="width: 130px;">Số phiếu</th>
                        <th class="text-end" style="width: 120px;">Tổng SL nhập</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy loại nhập kho nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@(stt++)</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">@row.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@row.Name</div>
                                    <div class="small text-muted">Ngày tạo: @row.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(row.Remark) ? "—" : row.Remark)</span>
                                </td>
                                <td class="text-center">
                                    <form method="post" asp-action="ToggleStatistic" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi cờ tính thống kê cho loại @row.Code?');">
                                        @Html.AntiForgeryToken()
                                        @if (row.FlagStatistic)
                                        {
                                            <button type="submit" class="btn btn-sm btn-link text-decoration-none p-0" title="Bấm để tắt tính thống kê">
                                                <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                    <i class="bi bi-check2-square me-1"></i>Tính thống kê
                                                </span>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-link text-decoration-none p-0" title="Bấm để bật tính thống kê">
                                                <span class="badge bg-light text-muted border px-2 py-1">
                                                    <i class="bi bi-square me-1"></i>Không tính
                                                </span>
                                            </button>
                                        }
                                    </form>
                                </td>
                                <td class="text-center">
                                    @if (row.TotalDocsCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" onclick="viewDocs(@row.Id, '@row.Code', '@row.Name')">
                                            <i class="bi bi-journal-check me-1"></i>@row.TotalDocsCount phiếu
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">0 phiếu</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(row.TotalQtyIn > 0 ? "text-dark" : "text-muted")">@row.TotalQtyIn.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-dash-circle me-1"></i>Ngừng áp dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" title="Sửa thông tin" onclick="editInventoryInType(@row.Id, '@row.Code', '@row.Name', @(row.FlagStatistic.ToString().ToLower()), '@(row.Remark?.Replace("'", "\\'") ?? "")', @(row.IsActive.ToString().ToLower()))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="Toggle" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái áp dụng loại nhập @row.Code?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-@(row.IsActive ? "warning" : "success")" title="@(row.IsActive ? "Ngừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(row.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa loại nhập kho @row.Code? (Nếu đã phát sinh phiếu kho sẽ chuyển sang Ngừng áp dụng)');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa loại nhập kho">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Loại nhập kho -->
<div class="modal fade" id="createInventoryInTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Loại nhập kho mới</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã loại nhập kho (InvInType) <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control text-uppercase font-monospace" placeholder="Ví dụ: IN_BUY, IN_PROD, IN_RETURN, IN_TRANSFER..." required maxlength="30" />
                        <div class="form-text small">Viết tắt in hoa, không trùng lặp (port từ Mst_InvInType Skycic).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên loại nhập kho (InvInTypeName) <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: Nhập mua hàng Nhà cung cấp, Nhập thành phẩm SX..." required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú / Quy trình chứng từ (Remark)</label>
                        <textarea name="remark" class="form-control" rows="3" placeholder="Mô tả mục đích nhập kho, hóa đơn hoặc căn cứ kèm theo..."></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="flagStatistic" value="true" id="createFlagStatistic" checked />
                        <label class="form-check-label small fw-semibold" for="createFlagStatistic">Tính vào thống kê mua hàng & sản lượng (FlagStatistic)</label>
                        <div class="form-text small">Bật nếu giao dịch này làm tăng giá trị mua hàng/doanh thu thuần. Tắt đối với nhập điều chuyển hoặc cân bằng kiểm kê.</div>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="createIsActive" checked />
                        <label class="form-check-label small fw-semibold" for="createIsActive">Kích hoạt áp dụng ngay</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu loại nhập kho</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Loại nhập kho -->
<div class="modal fade" id="editInventoryInTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Update" id="editInventoryInTypeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Chỉnh sửa Loại nhập kho</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã loại nhập kho (InvInType)</label>
                        <input type="text" id="editCode" class="form-control bg-light font-monospace" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên loại nhập kho (InvInTypeName) <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú / Quy trình chứng từ (Remark)</label>
                        <textarea name="remark" id="editRemark" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="flagStatistic" value="true" id="editFlagStatistic" />
                        <label class="form-check-label small fw-semibold" for="editFlagStatistic">Tính vào thống kê mua hàng & sản lượng (FlagStatistic)</label>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editIsActive" />
                        <label class="form-check-label small fw-semibold" for="editIsActive">Kích hoạt áp dụng</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem danh sách Phiếu nhập thuộc Loại nhập kho -->
<div class="modal fade" id="viewDocsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">
                    <i class="bi bi-journal-text text-primary me-2"></i>
                    Phiếu nhập kho thuộc loại: <span id="modalTypeTitle" class="text-primary font-monospace"></span>
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded">
                    <div>
                        <span class="text-muted small">Tổng số phiếu liên quan:</span>
                        <span id="modalTotalDocs" class="fw-bold ms-1 text-dark">0</span>
                    </div>
                    <div>
                        <span class="text-muted small">Tổng số lượng hàng nhập:</span>
                        <span id="modalTotalQty" class="fw-bold ms-1 text-primary">0</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Ngày lập</th>
                                <th>Kho nhập</th>
                                <th class="text-end">Số lượng</th>
                                <th>Ghi chú / Tham chiếu</th>
                                <th class="text-end">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody id="modalDocsTableBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">Đang tải dữ liệu...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editInventoryInType(id, code, name, flagStatistic, remark, isActive) {
        document.getElementById('editId').value = id;
        document.getElementById('editCode').value = code;
        document.getElementById('editName').value = name;
        document.getElementById('editFlagStatistic').checked = flagStatistic;
        document.getElementById('editRemark').value = remark;
        document.getElementById('editIsActive').checked = isActive;
        new bootstrap.Modal(document.getElementById('editInventoryInTypeModal')).show();
    }

    async function viewDocs(id, code, name) {
        document.getElementById('modalTypeTitle').textContent = `${name} (${code})`;
        const tbody = document.getElementById('modalDocsTableBody');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang tải dữ liệu...</td></tr>';
        
        const modal = new bootstrap.Modal(document.getElementById('viewDocsModal'));
        modal.show();

        try {
            const res = await fetch(`/InventoryInType/Detail?id=${id}`);
            if (!res.ok) throw new Error('Không thể tải dữ liệu.');
            const data = await res.json();

            document.getElementById('modalTotalDocs').textContent = data.totalDocs + ' phiếu';
            document.getElementById('modalTotalQty').textContent = Number(data.totalQtyIn).toLocaleString('vi-VN');

            if (!data.docs || data.docs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">Chưa có phiếu nhập kho nào phát sinh theo loại này.</td></tr>';
                return;
            }

            let html = '';
            data.docs.forEach(d => {
                html += `<tr>
                    <td><code>${d.code}</code></td>
                    <td class="small text-muted">${d.date}</td>
                    <td class="fw-semibold">${d.warehouseName}</td>
                    <td class="text-end fw-bold">${Number(d.totalQty).toLocaleString('vi-VN')}</td>
                    <td class="small text-muted">${d.note || d.refNo || '—'}</td>
                    <td class="text-end">
                        <a href="/Doc/${d.id}" class="btn btn-sm btn-outline-primary py-0 px-2">
                            <i class="bi bi-eye me-1"></i>Xem
                        </a>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = html;
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-3">${err.message}</td></tr>`;
        }
    }
</script>
}
