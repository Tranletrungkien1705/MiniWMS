@model SpecUnitReport
@{
    ViewData["Title"] = "Quy cách đóng gói theo ĐVT";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var specCodeFilter = (string)(ViewBag.SpecCode ?? "");
    var unitCodeFilter = (string)(ViewBag.UnitCode ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
    var specs = ViewBag.Specs as List<ProductSpec> ?? [];
    var units = ViewBag.Units as List<PartUnit> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-arrow-left-right text-primary me-2"></i>Quy cách Đóng gói theo Đơn vị tính</h5>
        <div class="text-muted small">Port từ <code>OS_PrdCenter_Mst_SpecUnit</code> / <code>Mst_SpecUnit</code> (Skycic) — Gắn Quy cách sản phẩm (SpecCode) với Đơn vị tính đóng gói (UnitCode) kèm số lượng quy đổi, kích thước Dài x Rộng x Cao, thể tích (m3), khối lượng (kg) và đơn vị chuẩn quy đổi</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/SpecUnit/ExportCsv?q=@keyword&specCode=@specCodeFilter&unitCode=@unitCodeFilter&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/ProductSpec" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-card-checklist me-1"></i> Quy cách SP
        </a>
        <a href="/PartUnit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-rulers me-1"></i> Đơn vị tính
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createSpecUnitModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Quy cách đóng gói
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG DÒNG QUY CÁCH</span>
                    <i class="bi bi-arrow-left-right text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalUnits</div>
                <div class="small text-muted">Dòng quy cách đóng gói theo đơn vị</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">@Model.DistinctSpecsCount quy cách / @Model.DistinctUnitsCount đơn vị</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG THỂ TÍCH</span>
                    <i class="bi bi-box text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-info">@Model.TotalVolumeM3.ToString("N4") <span class="fs-6">m³</span></div>
                <div class="small text-muted">Tổng thể tích đóng gói các quy cách</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG KHỐI LƯỢNG</span>
                    <i class="bi bi-speedometer2 text-warning fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-warning">@Model.TotalWeightKg.ToString("N2") <span class="fs-6">kg</span></div>
                <div class="small text-muted">Tổng khối lượng đóng gói các quy cách</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Mã quy cách, đơn vị, mô tả đóng gói..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="specCode" class="form-select form-select-sm">
                    <option value="">-- Quy cách sản phẩm --</option>
                    @foreach (var s in specs)
                    {
                        <!option value="@s.Code" @(string.Equals(specCodeFilter, s.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@s.Code — @s.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="unitCode" class="form-select form-select-sm">
                    <option value="">-- Đơn vị tính --</option>
                    @foreach (var u in units)
                    {
                        <!option value="@u.Name" @(string.Equals(unitCodeFilter, u.Name, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@u.Name (@u.Code)</!option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <select name="activeOnly" class="form-select form-select-sm" title="Trạng thái">
                    <option value="">-- Trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Tạm dừng</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/SpecUnit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Quy cách đóng gói theo ĐVT -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 45px;">STT</th>
                        <th style="width: 170px;">Mã quy cách</th>
                        <th>Tên quy cách / Dòng Model</th>
                        <th class="text-center" style="width: 110px;">Đơn vị tính</th>
                        <th class="text-center" style="width: 100px;">ĐVT chuẩn</th>
                        <th class="text-end" style="width: 90px;">SL quy đổi</th>
                        <th class="text-center" style="width: 150px;">Kích thước (D×R×C)</th>
                        <th class="text-end" style="width: 100px;">Thể tích (m³)</th>
                        <th class="text-end" style="width: 100px;">Khối lượng</th>
                        <th class="text-center" style="width: 105px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 135px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy quy cách đóng gói nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@stt</td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace fw-semibold">@r.SpecCode</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@(r.SpecName ?? "--")</div>
                                    @if (!string.IsNullOrWhiteSpace(r.ModelCode))
                                    {
                                        <div class="text-muted small font-monospace"><i class="bi bi-diagram-3 me-1"></i>@r.ModelCode</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.SpecUnitDesc))
                                    {
                                        <div class="text-muted small" title="@r.SpecUnitDesc" style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <i class="bi bi-info-circle me-1"></i>@r.SpecUnitDesc
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-semibold">@r.UnitCode</span>
                                </td>
                                <td class="text-center small">
                                    <span class="badge bg-light text-dark border">@(r.StandardUnitCode ?? "cái")</span>
                                </td>
                                <td class="text-end fw-semibold">@r.Qty.ToString("N2")</td>
                                <td class="text-center small text-muted">
                                    @if (r.Length > 0 || r.Width > 0 || r.Height > 0)
                                    {
                                        <span>@r.Length.ToString("N1") × @r.Width.ToString("N1") × @r.Height.ToString("N1")</span>
                                    }
                                    else
                                    {
                                        <span>--</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (r.Volume > 0)
                                    {
                                        <span class="fw-semibold text-info">@r.Volume.ToString("N4")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (r.Weight > 0)
                                    {
                                        <span class="fw-semibold text-warning">@r.Weight.ToString("N2") kg</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Đang áp dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-primary" title="Sửa quy cách đóng gói" onclick="openEditSpecUnitModal(@r.Id, '@(r.StandardUnitCode ?? "cái")', '@Html.Raw(Html.Encode(r.SpecUnitDesc ?? ""))', @r.Qty, @r.Length, @r.Width, @r.Height, @r.Volume, @r.Weight, @(r.IsActive ? "true" : "false"), '@Html.Raw(Html.Encode(r.Remark ?? ""))')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" action="/SpecUnit/ToggleStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-@(r.IsActive ? "warning" : "success")" title="@(r.IsActive ? "Tạm dừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(r.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="/SpecUnit/Delete" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa quy cách đóng gói \'@r.SpecCode\' / \'@r.UnitCode\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa quy cách đóng gói">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Quy cách đóng gói -->
<div class="modal fade" id="createSpecUnitModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/SpecUnit/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm mới Quy cách đóng gói theo Đơn vị tính (Mst_SpecUnit)</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Quy cách sản phẩm (SpecCode) <span class="text-danger">*</span></label>
                            <select name="specCode" class="form-select form-select-sm" required>
                                <option value="">-- Chọn quy cách sản phẩm --</option>
                                @foreach (var s in specs)
                                {
                                    <option value="@s.Code">@s.Code — @s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Đơn vị tính (UnitCode) <span class="text-danger">*</span></label>
                            <input type="text" name="unitCode" class="form-control form-control-sm" placeholder="vd: hộp, thùng, pallet" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Đơn vị chuẩn quy đổi</label>
                            <select name="standardUnitCode" class="form-select form-select-sm">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Name">@u.Name (@u.Code)</option>
                                }
                                @if (units.Count == 0)
                                {
                                    <option value="cái">cái</option>
                                    <option value="chiếc">chiếc</option>
                                    <option value="bộ">bộ</option>
                                    <option value="can">can</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Số lượng quy đổi (Qty)</label>
                            <input type="number" step="0.0001" min="0" name="qty" class="form-control form-control-sm" value="1" />
                            <div class="form-text text-muted small">Số đơn vị chuẩn trong 1 đơn vị đóng gói</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Dài (cm)</label>
                            <input type="number" step="0.01" min="0" name="length" class="form-control form-control-sm" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Rộng (cm)</label>
                            <input type="number" step="0.01" min="0" name="width" class="form-control form-control-sm" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Cao (cm)</label>
                            <input type="number" step="0.01" min="0" name="height" class="form-control form-control-sm" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Thể tích (m³)</label>
                            <input type="number" step="0.0001" min="0" name="volume" class="form-control form-control-sm" value="0" />
                            <div class="form-text text-muted small">Để 0 sẽ tự tính từ D×R×C</div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Khối lượng (kg)</label>
                            <input type="number" step="0.01" min="0" name="weight" class="form-control form-control-sm" value="0" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="addSpecUnitIsActive" checked>
                                <label class="form-check-label small" for="addSpecUnitIsActive">Áp dụng</label>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Mô tả quy cách đóng gói (SpecUnitDesc)</label>
                            <textarea name="specUnitDesc" class="form-control form-control-sm" rows="2" placeholder="vd: Thùng 12 hộp xếp 2 lớp, đóng đai nhựa, dán tem QR..."></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Ghi chú (Remark)</label>
                            <textarea name="remark" class="form-control form-control-sm" rows="2" placeholder="Tiêu chuẩn đóng gói, điều kiện bảo quản, hướng dẫn xếp kho..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu Quy cách đóng gói</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Quy cách đóng gói -->
<div class="modal fade" id="editSpecUnitModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/SpecUnit/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editSpecUnitId" />
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa Quy cách đóng gói theo Đơn vị tính</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đơn vị chuẩn quy đổi</label>
                            <select name="standardUnitCode" id="editSpecUnitStdUnit" class="form-select form-select-sm">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Name">@u.Name (@u.Code)</option>
                                }
                                @if (units.Count == 0)
                                {
                                    <option value="cái">cái</option>
                                    <option value="chiếc">chiếc</option>
                                    <option value="bộ">bộ</option>
                                    <option value="can">can</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Số lượng quy đổi (Qty)</label>
                            <input type="number" step="0.0001" min="0" name="qty" id="editSpecUnitQty" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editSpecUnitIsActive">
                                <label class="form-check-label small" for="editSpecUnitIsActive">Áp dụng</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Dài (cm)</label>
                            <input type="number" step="0.01" min="0" name="length" id="editSpecUnitLength" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Rộng (cm)</label>
                            <input type="number" step="0.01" min="0" name="width" id="editSpecUnitWidth" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Cao (cm)</label>
                            <input type="number" step="0.01" min="0" name="height" id="editSpecUnitHeight" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Thể tích (m³)</label>
                            <input type="number" step="0.0001" min="0" name="volume" id="editSpecUnitVolume" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Khối lượng (kg)</label>
                            <input type="number" step="0.01" min="0" name="weight" id="editSpecUnitWeight" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Mô tả quy cách đóng gói (SpecUnitDesc)</label>
                            <textarea name="specUnitDesc" id="editSpecUnitDesc" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Ghi chú (Remark)</label>
                            <textarea name="remark" id="editSpecUnitRemark" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditSpecUnitModal(id, stdUnit, desc, qty, length, width, height, volume, weight, active, remark) {
        document.getElementById('editSpecUnitId').value = id;
        document.getElementById('editSpecUnitStdUnit').value = stdUnit;
        document.getElementById('editSpecUnitDesc').value = desc;
        document.getElementById('editSpecUnitQty').value = qty;
        document.getElementById('editSpecUnitLength').value = length;
        document.getElementById('editSpecUnitWidth').value = width;
        document.getElementById('editSpecUnitHeight').value = height;
        document.getElementById('editSpecUnitVolume').value = volume;
        document.getElementById('editSpecUnitWeight').value = weight;
        document.getElementById('editSpecUnitIsActive').checked = active;
        document.getElementById('editSpecUnitRemark').value = remark;

        new bootstrap.Modal(document.getElementById('editSpecUnitModal')).show();
    }
</script>
}