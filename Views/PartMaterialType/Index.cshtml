@model PartMaterialTypeReport
@{
    ViewData["Title"] = "Nhóm chất liệu";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-palette2 text-primary me-2"></i>Danh mục Nhóm chất liệu / Vật liệu hàng hóa kho</h5>
        <div class="text-muted small">Port từ <code>Mst_PartMaterialType</code> (Skycic) — Quản lý phân loại nhóm chất liệu & vật tư sản phẩm (PMType, PMTypeName), chuẩn hóa thuộc tính vật liệu cấu thành (Cotton, Kaki, Da thuộc, Denim, Lụa, Nhựa, Kim loại...), theo dõi số lượng mặt hàng và tổng tồn kho theo từng chất liệu</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/PartMaterialType/ExportCsv?q=@keyword&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/Product" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> Danh sách mặt hàng
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createMaterialModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Nhóm chất liệu
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG NHÓM CHẤT LIỆU</span>
                    <i class="bi bi-palette2 text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalMaterialTypes</div>
                <div class="small text-muted">Nhóm cấu thành vật liệu trong hệ thống</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Khả dụng gán cho mặt hàng và phiếu kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">NGỪNG ÁP DỤNG</span>
                    <i class="bi bi-pause-circle text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-muted">@Model.InactiveCount</div>
                <div class="small text-muted">Tạm ngưng phân loại cho sản phẩm mới</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">MẶT HÀNG ĐÃ GÁN</span>
                    <i class="bi bi-boxes text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary">@Model.TotalProductsMapped</div>
                <div class="small text-muted">Sản phẩm trong kho đã xác định chất liệu</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Tìm kiếm theo mã, tên chất liệu hoặc ghi chú tiêu chuẩn kỹ thuật..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Ngừng áp dụng</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/PartMaterialType" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Nhóm chất liệu -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th style="width: 150px;">Mã chất liệu</th>
                        <th>Tên nhóm chất liệu / vật liệu</th>
                        <th>Ghi chú / Tiêu chuẩn bảo quản</th>
                        <th class="text-center" style="width: 140px;">Số mặt hàng</th>
                        <th class="text-end" style="width: 140px;">Tổng tồn kho</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy nhóm chất liệu nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@(stt++)</td>
                                <td>
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle font-monospace px-2 py-1">@row.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@row.Name</div>
                                    <div class="small text-muted">Ngày tạo: @row.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(row.Remark) ? "—" : row.Remark)</span>
                                </td>
                                <td class="text-center">
                                    @if (row.ProductCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-0" onclick="viewMaterialProducts(@row.Id, '@row.Code', '@row.Name')">
                                            <i class="bi bi-box me-1"></i>@row.ProductCount sp
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">0 sp</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(row.TotalStockQty > 0 ? "text-dark" : "text-muted")">@row.TotalStockQty.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-dash-circle me-1"></i>Ngừng áp dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" title="Sửa thông tin" onclick="editMaterial(@row.Id, '@row.Code', '@row.Name', '@(row.Remark?.Replace("'", "\\'") ?? "")', @(row.IsActive.ToString().ToLower()))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="Toggle" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái nhóm chất liệu @row.Code?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-@(row.IsActive ? "warning" : "success")" title="@(row.IsActive ? "Ngừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(row.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa nhóm chất liệu @row.Code? (Nếu đã có sản phẩm sẽ chuyển sang Ngừng áp dụng)');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa nhóm chất liệu">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Nhóm chất liệu -->
<div class="modal fade" id="createMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Nhóm chất liệu mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã nhóm chất liệu (PMType)</label>
                        <input type="text" name="code" class="form-control font-monospace" placeholder="VD: COTTON, KAKI, LEATHER, SILK, DENIM, INOX... (để trống tự sinh)" />
                        <div class="form-text">Mã định danh viết hoa không dấu, duy nhất trong hệ thống kho.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên nhóm chất liệu / vật liệu (PMTypeName) <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="VD: Vải sợi Cotton 100%, Da bò thuộc tự nhiên, Thép không gỉ Inox..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú / Đặc tính kỹ thuật & bảo quản (Remark)</label>
                        <textarea name="remark" class="form-control" rows="3" placeholder="Mô tả tiêu chuẩn chất liệu, độ bền, hướng dẫn bảo quản trong kho (thoáng khí, nhiệt độ, chống ẩm)..."></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="createIsActive" value="true" checked>
                        <label class="form-check-label fw-semibold small" for="createIsActive">Kích hoạt áp dụng ngay (FlagActive)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu nhóm chất liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Nhóm chất liệu -->
<div class="modal fade" id="editMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Update" id="editMaterialForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editMaterialId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật Nhóm chất liệu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã nhóm chất liệu</label>
                        <input type="text" id="editMaterialCode" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên nhóm chất liệu / vật liệu <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editMaterialName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú / Tiêu chuẩn bảo quản</label>
                        <textarea name="remark" id="editMaterialRemark" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editMaterialIsActive" value="true">
                        <label class="form-check-label fw-semibold small" for="editMaterialIsActive">Đang áp dụng (FlagActive)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem danh sách sản phẩm thuộc nhóm chất liệu -->
<div class="modal fade" id="materialProductsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0"><i class="bi bi-boxes text-primary me-2"></i>Mặt hàng thuộc chất liệu: <span id="modalMaterialTitle" class="text-primary font-monospace"></span></h5>
                    <div class="text-muted small">Danh sách các mặt hàng trong kho cấu thành từ chất liệu này</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
                    <div>
                        <span class="fw-semibold">Tổng số mặt hàng:</span> <span id="modalTotalProducts" class="badge bg-primary">0</span>
                    </div>
                    <div>
                        <span class="fw-semibold">Tổng tồn kho vật lý:</span> <span id="modalTotalStock" class="badge bg-success">0</span>
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3" style="width: 50px;">STT</th>
                                <th style="width: 140px;">Mã hàng</th>
                                <th>Tên hàng</th>
                                <th style="width: 90px;">ĐVT</th>
                                <th style="width: 110px;">Loại SP</th>
                                <th style="width: 110px;">Thương hiệu</th>
                                <th class="text-end" style="width: 90px;">Tồn Min</th>
                                <th class="text-end" style="width: 90px;">Tồn Max</th>
                                <th class="text-end pe-3" style="width: 120px;">Giá vốn</th>
                            </tr>
                        </thead>
                        <tbody id="modalMaterialProductsBody">
                            <tr><td colspan="9" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editMaterial(id, code, name, remark, isActive) {
        document.getElementById('editMaterialId').value = id;
        document.getElementById('editMaterialCode').value = code;
        document.getElementById('editMaterialName').value = name;
        document.getElementById('editMaterialRemark').value = remark || '';
        document.getElementById('editMaterialIsActive').checked = !!isActive;
        document.getElementById('editMaterialForm').action = '/PartMaterialType/Update/' + id;
        new bootstrap.Modal(document.getElementById('editMaterialModal')).show();
    }

    async function viewMaterialProducts(id, code, name) {
        document.getElementById('modalMaterialTitle').textContent = name + ' (' + code + ')';
        document.getElementById('modalTotalProducts').textContent = '...';
        document.getElementById('modalTotalStock').textContent = '...';
        const tbody = document.getElementById('modalMaterialProductsBody');
        tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</td></tr>';
        
        new bootstrap.Modal(document.getElementById('materialProductsModal')).show();

        try {
            const res = await fetch('/PartMaterialType/Detail/' + id);
            if (!res.ok) throw new Error('Không thể tải chi tiết');
            const data = await res.json();

            document.getElementById('modalTotalProducts').textContent = data.totalProducts;
            document.getElementById('modalTotalStock').textContent = Number(data.totalStockQty).toLocaleString();

            if (!data.products || data.products.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">Chưa có mặt hàng nào thuộc nhóm chất liệu này.</td></tr>';
                return;
            }

            let html = '';
            data.products.forEach((p, idx) => {
                const costPriceFormatted = Number(p.costPrice || 0).toLocaleString() + ' đ';
                const ptBadge = p.partTypeCode ? `<span class="badge bg-info-subtle text-info border border-info-subtle">${p.partTypeCode}</span>` : '—';
                const brandBadge = p.brandCode ? `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">${p.brandCode}</span>` : '—';
                html += `
                    <tr>
                        <td class="ps-3 text-muted">${idx + 1}</td>
                        <td class="fw-semibold font-monospace">${p.code}</td>
                        <td>${p.name}</td>
                        <td><span class="badge bg-light text-dark border font-monospace">${p.uom || ''}</span></td>
                        <td>${ptBadge}</td>
                        <td>${brandBadge}</td>
                        <td class="text-end text-muted">${p.minStock > 0 ? p.minStock : '—'}</td>
                        <td class="text-end text-muted">${p.maxStock > 0 ? p.maxStock : '—'}</td>
                        <td class="text-end pe-3 fw-semibold text-dark">${costPriceFormatted}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Lỗi khi tải dữ liệu: ${err.message}</td></tr>`;
        }
    }
</script>
}
