@model List<Warehouse>
@{
    ViewData["Title"] = "Kho";
    var invTypes = ViewBag.InventoryTypes as List<InventoryType> ?? [];
    var invTypeDict = invTypes.ToDictionary(t => t.Code, t => t.Name, StringComparer.OrdinalIgnoreCase);
    var invLevelTypes = ViewBag.InventoryLevelTypes as List<InventoryLevelType> ?? [];
    var invLevelTypeDict = invLevelTypes.ToDictionary(t => t.Code, t => t.Name, StringComparer.OrdinalIgnoreCase);
    var areas = ViewBag.Areas as List<Area> ?? [];
    var areaDict = areas.ToDictionary(a => a.Code, a => a.Name, StringComparer.OrdinalIgnoreCase);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-building text-primary me-2"></i>Quản lý Danh sách Kho hàng</h5>
        <div class="text-muted small">Cấu hình các kho hàng vật lý, chi nhánh, phân loại theo <code>Mst_Area</code>, <code>Mst_InventoryType</code> & <code>Mst_InventoryLevelType</code> và quản lý vị trí sơ đồ khay kệ</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/Area" class="btn btn-sm btn-outline-success">
            <i class="bi bi-geo-alt me-1"></i> Danh mục Vùng kho
        </a>
        <a href="/InventoryLevelType" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-layers-half me-1"></i> Danh mục Cấp kho
        </a>
        <a href="/InventoryType" class="btn btn-sm btn-outline-info">
            <i class="bi bi-diagram-2-fill me-1"></i> Danh mục Loại kho
        </a>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-4"><div class="card border-0 shadow-sm"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1 text-primary"></i>Thêm kho mới</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control form-control-sm" placeholder="Tên kho *" required /></div>
            <div class="mb-2"><input name="code" class="form-control form-control-sm" placeholder="Mã kho (vd: KHO-HN, KHO-HCM...)" /></div>
            <div class="mb-2">
                <select name="invTypeCode" class="form-select form-select-sm">
                    <option value="">-- Chọn Loại kho (Mst_InventoryType) --</option>
                    @foreach (var it in invTypes) {
                        <option value="@it.Code">@it.Name (@it.Code)</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <select name="invLevelTypeCode" class="form-select form-select-sm">
                    <option value="">-- Chọn Cấp kho (Mst_InventoryLevelType) --</option>
                    @foreach (var lt in invLevelTypes) {
                        <option value="@lt.Code">@lt.Name (@lt.Code)</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <select name="areaCode" class="form-select form-select-sm">
                    <option value="">-- Chọn Vùng / Khu vực kho (Mst_Area) --</option>
                    @foreach (var ar in areas) {
                        <option value="@ar.Code">@ar.Name (@ar.Code)</option>
                    }
                </select>
            </div>
            <div class="mb-2"><input name="address" class="form-control form-control-sm" placeholder="Địa chỉ kho" /></div>
            <div class="mb-3"><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú / Mục đích sử dụng" /></div>
            <button class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>Tạo kho</button>
        </form>
    </div></div></div>
    <div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">Mã kho</th>
                        <th>Tên kho</th>
                        <th style="width: 130px;">Vùng / Khu vực</th>
                        <th style="width: 140px;">Cấp kho</th>
                        <th style="width: 140px;">Loại kho</th>
                        <th>Địa chỉ</th>
                        <th class="text-end" style="width: 120px;">Sơ đồ kho</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var w in Model) {
                    var typeName = !string.IsNullOrEmpty(w.InvTypeCode) && invTypeDict.TryGetValue(w.InvTypeCode, out var tn) ? tn : w.InvTypeCode;
                    var levelName = !string.IsNullOrEmpty(w.InvLevelTypeCode) && invLevelTypeDict.TryGetValue(w.InvLevelTypeCode, out var ln) ? ln : w.InvLevelTypeCode;
                    var areaName = !string.IsNullOrEmpty(w.AreaCode) && areaDict.TryGetValue(w.AreaCode, out var an) ? an : w.AreaCode;
                    <tr>
                        <td class="fw-semibold"><code>@w.Code</code></td>
                        <td>
                            <div class="fw-bold">@w.Name</div>
                            @if (!string.IsNullOrEmpty(w.Remark)) {
                                <div class="text-muted small"><i class="bi bi-info-circle me-1"></i>@w.Remark</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(w.AreaCode)) {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-geo-alt me-1"></i>@areaName
                                </span>
                            } else {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(w.InvLevelTypeCode)) {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="bi bi-layers-half me-1"></i>@levelName
                                </span>
                            } else {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(w.InvTypeCode)) {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                    <i class="bi bi-diagram-2 me-1"></i>@typeName
                                </span>
                            } else {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="small text-muted">@w.Address</td>
                        <td class="text-end">
                            <a href="/InventoryBlock?warehouseId=@w.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-grid-3x3 me-1"></i>Vị trí ô kệ
                            </a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có kho.</td></tr> }
                </tbody>
            </table>
        </div>
    </div></div></div>
</div>
