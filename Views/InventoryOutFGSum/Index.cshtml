@model FGOutSumReport
@{
    ViewData["Title"] = "Báo cáo Tổng hợp Xuất kho Thành phẩm SX";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var selectedWid = (int?)ViewBag.WarehouseId;
    var fromDate = (string)ViewBag.FromDate;
    var toDate = (string)ViewBag.ToDate;
    var keyword = (string)ViewBag.Keyword;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-box-arrow-up-right text-danger me-2"></i>Báo cáo Tổng hợp Xuất kho Thành phẩm Sản xuất</h5>
        <div class="text-muted small">Port từ <code>Rpt_InvFInventoryOutFGSum</code> (Skycic) — Tổng hợp lượng thành phẩm xuất kho (đã duyệt) theo từng kho, mặt hàng &amp; đại lý nhận hàng trong kỳ</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/InventoryOutFGSum/ExportCsv?warehouseId=@selectedWid&fromDate=@fromDate&toDate=@toDate&q=@Uri.EscapeDataString(keyword ?? "")"
           class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-printer me-1"></i> In báo cáo
        </button>
        <a href="/InventoryOutFG" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-box-arrow-up-right me-1"></i> Danh sách phiếu xuất TP
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-body py-3">
        <form method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Kho xuất thành phẩm</label>
                <select name="warehouseId" class="form-select form-select-sm">
                    <option value="">— Tất cả kho —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Từ ngày <span class="text-danger">*</span></label>
                <input type="date" id="inputFromDate" name="fromDate" value="@fromDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Đến ngày <span class="text-danger">*</span></label>
                <input type="date" id="inputToDate" name="toDate" value="@toDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Từ khóa</label>
                <input type="text" name="q" value="@keyword" placeholder="Số phiếu, đại lý, đơn hàng, mã/tên hàng..." class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
                <a href="/InventoryOutFGSum" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
            <div class="col-md-12 mt-2 d-flex gap-2 align-items-center flex-wrap">
                <span class="small text-muted me-1">Kỳ nhanh:</span>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('today')">Hôm nay</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('last7days')">7 ngày qua</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('thisMonth')">Tháng này</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('lastMonth')">Tháng trước</button>
            </div>
        </form>
    </div>
</div>

<!-- 4 Thẻ KPI -->
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Phiếu xuất TP</span>
                    <i class="bi bi-journals text-primary fs-5"></i>
                </div>
                <div class="stat-num text-primary">@Model.TotalDocs.ToString("N0")</div>
                <div class="text-muted small">Phiếu xuất thành phẩm đã duyệt</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng lượng xuất</span>
                    <i class="bi bi-box-seam text-danger fs-5"></i>
                </div>
                <div class="stat-num text-danger">@Model.TotalQtyOut.ToString("N0")</div>
                <div class="text-muted small">Đơn vị thành phẩm xuất kho</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng giá trị xuất</span>
                    <i class="bi bi-cash-stack text-success fs-5"></i>
                </div>
                <div class="stat-num text-success">@Model.TotalAmount.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                <div class="text-muted small">Giá trị thành phẩm xuất kho</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Mặt hàng &amp; Kho</span>
                    <i class="bi bi-tags text-warning fs-5"></i>
                </div>
                <div class="stat-num text-warning">@Model.DistinctProductsCount <span class="fs-6 fw-normal text-muted">SP</span> · @Model.DistinctWarehousesCount <span class="fs-6 fw-normal text-muted">Kho</span></div>
                <div class="text-muted small">Mặt hàng &amp; kho có phát sinh xuất</div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu tổng hợp -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
        <div class="fw-semibold text-dark small text-uppercase">
            <i class="bi bi-table me-1 text-primary"></i> Tổng hợp xuất thành phẩm theo kho, mặt hàng &amp; đại lý (@Model.Rows.Count dòng)
        </div>
        <div class="small text-muted">
            Kỳ báo cáo: <strong class="text-dark">@Model.FromDate.ToString("dd/MM/yyyy")</strong> đến <strong class="text-dark">@Model.ToDate.ToString("dd/MM/yyyy")</strong>
            @if (Model.WarehouseId.HasValue)
            {
                <span class="ms-1">| Kho: <strong class="text-dark">@Model.WarehouseName</strong></span>
            }
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0 font-sans" id="tblFGOutSum" style="font-size:12.5px;">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:40px">STT</th>
                    <th>Kho xuất</th>
                    <th>Mã thành phẩm</th>
                    <th>Tên thành phẩm</th>
                    <th class="text-center">ĐVT</th>
                    <th>Đại lý nhận hàng</th>
                    <th class="text-center">Số phiếu xuất</th>
                    <th class="text-end">Tổng lượng xuất</th>
                    <th class="text-end">Tổng giá trị xuất (đ)</th>
                    <th class="text-end">Tỷ trọng</th>
                </tr>
                @if (Model.Rows.Count > 0)
                {
                    <tr class="table-warning fw-bold text-dark border-bottom-2">
                        <td colspan="7" class="text-end text-uppercase small">Tổng cộng toàn kỳ (@Model.Rows.Count dòng):</td>
                        <td class="text-end font-monospace text-danger">@Model.TotalQtyOut.ToString("N0")</td>
                        <td class="text-end font-monospace text-success">@Model.TotalAmount.ToString("N0")</td>
                        <td class="text-end font-monospace">100%</td>
                    </tr>
                }
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            Không có phát sinh xuất kho thành phẩm nào thỏa mãn điều kiện lọc.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="text-center text-muted small">@stt</td>
                            <td class="small fw-semibold text-dark">@r.WarehouseName</td>
                            <td class="font-monospace fw-semibold text-primary">@r.ProductCode</td>
                            <td class="fw-semibold text-dark">@r.ProductName</td>
                            <td class="text-center text-muted small">@r.Uom</td>
                            <td class="small">
                                @if (!string.IsNullOrWhiteSpace(r.AgentCode))
                                {
                                    <span class="badge bg-light text-dark border font-monospace me-1">@r.AgentCode</span>
                                }
                                @r.AgentName
                            </td>
                            <td class="text-center font-monospace">@r.DocCount</td>
                            <td class="text-end font-monospace fw-bold text-dark">@r.TotalQtyOut.ToString("N0")</td>
                            <td class="text-end font-monospace text-success">@r.TotalAmount.ToString("N0")</td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1">
                                    <div class="progress" style="width:60px;height:6px;">
                                        <div class="progress-bar bg-danger" role="progressbar" style="width:@(r.SharePercent.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                    </div>
                                    <span class="font-monospace small text-muted">@r.SharePercent.ToString("0.0")%</span>
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot class="table-light">
                    <tr class="fw-bold text-dark">
                        <td colspan="7" class="text-end text-uppercase small">Tổng cộng cuối trang:</td>
                        <td class="text-end font-monospace text-danger">@Model.TotalQtyOut.ToString("N0")</td>
                        <td class="text-end font-monospace text-success">@Model.TotalAmount.ToString("N0")</td>
                        <td class="text-end font-monospace">100%</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@section Scripts {
<script>
    function setPeriod(p) {
        const today = new Date();
        const pad = n => n.toString().padStart(2, '0');
        const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

        let from, to = today;

        if (p === 'today') {
            from = today;
        } else if (p === 'last7days') {
            from = new Date();
            from.setDate(today.getDate() - 6);
        } else if (p === 'thisMonth') {
            from = new Date(today.getFullYear(), today.getMonth(), 1);
        } else if (p === 'lastMonth') {
            from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            to = new Date(today.getFullYear(), today.getMonth(), 0);
        }

        if (from) document.getElementById('inputFromDate').value = fmt(from);
        if (to) document.getElementById('inputToDate').value = fmt(to);

        document.getElementById('filterForm').submit();
    }
</script>
}