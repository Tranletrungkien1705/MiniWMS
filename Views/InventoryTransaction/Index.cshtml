@model InventoryTransactionReport
@{
    ViewData["Title"] = "Sổ giao dịch kho / Nhật ký biến động tồn kho";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var prods = (List<Product>)ViewBag.Products;
    var selectedWid = (int?)ViewBag.WarehouseId;
    var selectedPid = (int?)ViewBag.ProductId;
    var selectedType = (InventoryTxnType?)ViewBag.TxnType;
    var fromDate = (string)ViewBag.FromDate;
    var toDate = (string)ViewBag.ToDate;
    var keyword = (string)ViewBag.Keyword;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Kho phát sinh</label>
                <select name="warehouseId" class="form-select form-select-sm">
                    <option value="">— Tất cả kho —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Mặt hàng</label>
                <select name="productId" class="form-select form-select-sm">
                    <option value="">— Tất cả mặt hàng —</option>
                    @foreach (var p in prods)
                    {
                        <option value="@p.Id" selected="@(selectedPid == p.Id)">@p.Code — @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Nghiệp vụ</label>
                <select name="txnType" class="form-select form-select-sm">
                    <option value="">— Tất cả —</option>
                    <option value="@((int)InventoryTxnType.In)" selected="@(selectedType == InventoryTxnType.In)">Nhập kho</option>
                    <option value="@((int)InventoryTxnType.Out)" selected="@(selectedType == InventoryTxnType.Out)">Xuất kho</option>
                    <option value="@((int)InventoryTxnType.Move)" selected="@(selectedType == InventoryTxnType.Move)">Điều chuyển kho</option>
                    <option value="@((int)InventoryTxnType.Audit)" selected="@(selectedType == InventoryTxnType.Audit)">Cân bằng kiểm kê</option>
                    <option value="@((int)InventoryTxnType.ReturnSup)" selected="@(selectedType == InventoryTxnType.ReturnSup)">Trả hàng NCC</option>
                    <option value="@((int)InventoryTxnType.CusReturn)" selected="@(selectedType == InventoryTxnType.CusReturn)">Khách trả hàng</option>
                    <option value="@((int)InventoryTxnType.InFG)" selected="@(selectedType == InventoryTxnType.InFG)">Nhập thành phẩm SX</option>
                    <option value="@((int)InventoryTxnType.OutFG)" selected="@(selectedType == InventoryTxnType.OutFG)">Xuất thành phẩm</option>
                    <option value="@((int)InventoryTxnType.Adjust)" selected="@(selectedType == InventoryTxnType.Adjust)">Điều chỉnh tồn</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Từ ngày</label>
                <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Đến ngày</label>
                <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Tìm kiếm</label>
                <input type="text" name="q" value="@keyword" placeholder="Mã hàng, chứng từ..." class="form-control form-control-sm" />
            </div>
            <div class="col-12 d-flex gap-1 justify-content-end">
                <button type="submit" class="btn btn-sm btn-primary" title="Lọc dữ liệu">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a href="/InventoryTransaction" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
                <a href="/InventoryTransaction/ExportCsv?warehouseId=@selectedWid&productId=@selectedPid&txnType=@(selectedType.HasValue ? (int)selectedType.Value : "")&fromDate=@fromDate&toDate=@toDate&q=@Uri.EscapeDataString(keyword ?? "")"
                   class="btn btn-sm btn-outline-success" title="Xuất file CSV / Excel">
                    <i class="bi bi-file-earmark-excel"></i>
                </a>
                <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark" title="In sổ giao dịch">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG BÚT TOÁN</span>
                    <i class="bi bi-journal-text text-primary fs-5"></i>
                </div>
                <div class="stat-num text-primary">@Model.TotalTransactions.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">Số dòng giao dịch trong kỳ lọc</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG NHẬP (Δ+)</span>
                    <i class="bi bi-box-arrow-in-down text-success fs-5"></i>
                </div>
                <div class="stat-num text-success">@Model.TotalQtyIn.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">@Model.InCount bút toán làm tăng tồn</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG XUẤT (Δ−)</span>
                    <i class="bi bi-box-arrow-up text-danger fs-5"></i>
                </div>
                <div class="stat-num text-danger">@Model.TotalQtyOut.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">@Model.OutCount bút toán làm giảm tồn</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">BIẾN ĐỘNG RÒNG</span>
                    <i class="bi bi-arrow-left-right text-info fs-5"></i>
                </div>
                <div class="stat-num @(Model.NetQtyChange >= 0 ? "text-success" : "text-danger")">
                    @(Model.NetQtyChange >= 0 ? "+" : "")@Model.NetQtyChange.ToString("N0")
                </div>
                <div class="text-muted" style="font-size:11px">@Model.NgCount bút toán liên quan hàng NG</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0 fw-bold"><i class="bi bi-journal-text text-primary me-2"></i>Sổ giao dịch kho / Nhật ký biến động tồn kho</h6>
            <span class="text-muted small">Kho: <b>@Model.WarehouseName</b> — Mặt hàng: <b>@Model.ProductName</b> — Hiển thị <b>@Model.Rows.Count</b> bút toán</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createTxnModal">
                <i class="bi bi-plus-circle me-1"></i> Ghi bút toán điều chỉnh
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:40px">#</th>
                        <th class="text-center">Thời điểm</th>
                        <th>Kho</th>
                        <th>Mã hàng</th>
                        <th>Tên hàng hoá</th>
                        <th class="text-center">Nghiệp vụ</th>
                        <th class="text-center">Chất lượng</th>
                        <th class="text-end">Δ Tồn OK</th>
                        <th class="text-end">Δ Khóa OK</th>
                        <th class="text-end">Δ Tồn NG</th>
                        <th class="text-end">Δ Khóa NG</th>
                        <th class="text-end">Δ Tổng</th>
                        <th class="text-end">Δ Khả dụng</th>
                        <th>Số chứng từ</th>
                        <th>Diễn giải</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count > 0)
                    {
                        int stt = 1;
                        foreach (var r in Model.Rows)
                        {
                            var rowClass = r.Quality == InventoryTxnQuality.NG ? "table-warning" : "";
                            <tr class="@rowClass">
                                <td class="text-center text-muted small">@(stt++)</td>
                                <td class="text-center text-muted small">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><i class="bi bi-building me-1 text-muted"></i>@r.WarehouseName</td>
                                <td class="fw-semibold">
                                    <a href="/WarehouseCard?productId=@r.ProductId&warehouseId=@r.WarehouseId" class="text-decoration-none">
                                        @r.ProductCode
                                    </a>
                                </td>
                                <td>@r.ProductName</td>
                                <td class="text-center"><span class="badge @r.BadgeClass px-2 py-1">@r.TxnTypeLabel</span></td>
                                <td class="text-center">
                                    @if (r.Quality == InventoryTxnQuality.NG)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger">@r.QualityLabel</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">@r.QualityLabel</span>
                                    }
                                </td>
                                <td class="text-end @(r.QtyChTotalOK > 0 ? "text-success" : (r.QtyChTotalOK < 0 ? "text-danger" : "text-muted"))">
                                    @(r.QtyChTotalOK > 0 ? "+" : "")@r.QtyChTotalOK.ToString("N0")
                                </td>
                                <td class="text-end text-muted">@r.QtyChBlockOK.ToString("N0")</td>
                                <td class="text-end text-muted">@r.QtyChTotalNG.ToString("N0")</td>
                                <td class="text-end text-muted">@r.QtyChBlockNG.ToString("N0")</td>
                                <td class="text-end fw-bold @(r.QtyChangeTotal > 0 ? "text-success" : (r.QtyChangeTotal < 0 ? "text-danger" : "text-muted"))">
                                    @(r.QtyChangeTotal > 0 ? "+" : "")@r.QtyChangeTotal.ToString("N0")
                                </td>
                                <td class="text-end fw-semibold @(r.QtyChangeAvail > 0 ? "text-success" : (r.QtyChangeAvail < 0 ? "text-danger" : "text-muted"))">
                                    @(r.QtyChangeAvail > 0 ? "+" : "")@r.QtyChangeAvail.ToString("N0")
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.RefCode00))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace">@r.RefCode00</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small text-muted" style="max-width:220px">
                                    @(r.Remark ?? "—")
                                    <div class="text-muted" style="font-size:10.5px"><i class="bi bi-code-slash me-1"></i>@r.FunctionName</div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="15" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                Không có bút toán giao dịch kho nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Rows.Count > 0)
    {
        <div class="card-footer bg-white py-2 text-muted small d-flex justify-content-between align-items-center">
            <span>Hiển thị <b>@Model.Rows.Count</b> / @Model.TotalTransactions bút toán</span>
            <span>Nhập: <b class="text-success">@Model.TotalQtyIn</b> | Xuất: <b class="text-danger">@Model.TotalQtyOut</b> | Ròng: <b>@Model.NetQtyChange</b> | Hàng NG: <b>@Model.NgCount</b></span>
        </div>
    }
</div>

<!-- Modal Ghi bút toán điều chỉnh -->
<div class="modal fade" id="createTxnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/InventoryTransaction/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Ghi bút toán điều chỉnh tồn kho</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Kho phát sinh <span class="text-danger">*</span></label>
                            <select name="warehouseId" class="form-select" required>
                                <option value="">— Chọn kho hàng —</option>
                                @foreach (var w in whs)
                                {
                                    <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name (@w.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mặt hàng <span class="text-danger">*</span></label>
                            <select name="productId" class="form-select" required>
                                <option value="">— Chọn mặt hàng —</option>
                                @foreach (var p in prods)
                                {
                                    <option value="@p.Id" selected="@(selectedPid == p.Id)">@p.Code — @p.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Nghiệp vụ phát sinh</label>
                            <select name="txnType" class="form-select">
                                <option value="@((int)InventoryTxnType.Adjust)">Điều chỉnh tồn</option>
                                <option value="@((int)InventoryTxnType.In)">Nhập kho</option>
                                <option value="@((int)InventoryTxnType.Out)">Xuất kho</option>
                                <option value="@((int)InventoryTxnType.Audit)">Cân bằng kiểm kê</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Chất lượng hàng</label>
                            <select name="quality" class="form-select">
                                <option value="@((int)InventoryTxnQuality.OK)">Hàng đạt chuẩn (OK)</option>
                                <option value="@((int)InventoryTxnQuality.NG)">Hàng lỗi / hỏng (NG)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted">Δ Tồn OK</label>
                            <input type="number" name="qtyChTotalOK" value="0" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted">Δ Khóa OK</label>
                            <input type="number" name="qtyChBlockOK" value="0" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted">Δ Tồn NG</label>
                            <input type="number" name="qtyChTotalNG" value="0" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold text-muted">Δ Khóa NG</label>
                            <input type="number" name="qtyChBlockNG" value="0" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold text-muted">Loại chứng từ</label>
                            <input type="text" name="refType" class="form-control" placeholder="VD: StockDoc" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold text-muted">Số chứng từ gốc</label>
                            <input type="text" name="refCode00" class="form-control font-monospace" placeholder="VD: PN260330-001" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Diễn giải</label>
                        <textarea name="remark" class="form-control" rows="2" placeholder="Lý do điều chỉnh / ghi chú bút toán..."></textarea>
                    </div>
                    <div class="alert alert-light border py-2 mb-0 small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Bút toán phải có ít nhất một thay đổi số lượng khác 0. Số dương làm tăng tồn, số âm làm giảm tồn.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Ghi bút toán</button>
                </div>
            </form>
        </div>
    </div>
</div>
