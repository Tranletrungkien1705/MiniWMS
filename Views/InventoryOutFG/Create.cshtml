@{
    ViewData["Title"] = "Lập phiếu xuất kho thành phẩm & Vận chuyển";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var prods = (List<Product>)ViewBag.Products;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="d-flex align-items-center gap-2">
        <a href="/InventoryOutFG" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        <h4 class="mb-0 fw-bold text-dark">
            <i class="bi bi-box-arrow-up-right text-primary me-2"></i>Lập phiếu xuất kho thành phẩm mới
        </h4>
    </div>
</div>

<form method="post" action="/InventoryOutFG/Create" id="createFgOutForm">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <!-- Thông tin chung & Đơn vị nhận -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-info-circle me-1"></i> 1. Thông tin xuất kho & Khách hàng nhận
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Kho xuất hàng <span class="text-danger">*</span></label>
                            <select name="warehouseId" class="form-select form-select-sm" required>
                                <option value="">-- Chọn kho xuất --</option>
                                @foreach (var w in whs)
                                {
                                    <option value="@w.Id">@w.Name (@w.Code)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Ngày xuất kho <span class="text-danger">*</span></label>
                            <input type="date" name="date" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Nghiệp vụ xuất <span class="text-danger">*</span></label>
                            <select name="outType" class="form-select form-select-sm" required>
                                <option value="0">Xuất thương mại / Đại lý bán buôn (OUTTHUONGMAI)</option>
                                <option value="1">Xuất khách hàng lẻ / Công trình dự án (OUTENDCUS)</option>
                                <option value="2">Điều chuyển chi nhánh / Showroom (TRANSFER)</option>
                                <option value="3">Xuất bảo hành / Đổi trả / Hủy mẫu (WARRANTY)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Hình thức xuất <span class="text-danger">*</span></label>
                            <select name="formType" class="form-select form-select-sm" required>
                                <option value="0">Xuất theo số lượng thông thường (KHONGMAVACH)</option>
                                <option value="1">Quét mã vạch / Serial cá thể hóa (MAVACH)</option>
                            </select>
                        </div>

                        @{
                            var fgCusts = (List<Customer>?)ViewBag.Customers ?? new List<Customer>();
                        }
                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-muted">Chọn từ danh mục Khách hàng / Đại lý</label>
                            <select class="form-select form-select-sm" onchange="onSelectFGCustomer(this)">
                                <option value="">— Chọn khách hàng / đại lý có sẵn —</option>
                                @foreach (var c in fgCusts)
                                {
                                    <option value="@c.Code" data-name="@c.Name" data-address="@c.Address">@c.Code — @c.Name (@c.CustomerType)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold small text-muted">Khách hàng / Đại lý nhận <span class="text-danger">*</span></label>
                            <input type="text" name="customerName" id="fgCustomerName" class="form-control form-control-sm" placeholder="Tên công ty / Tên đại lý / Khách nhận..." required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-muted">Mã đại lý / MST</label>
                            <input type="text" name="agentCode" id="fgAgentCode" class="form-control form-control-sm" placeholder="vd: DL-HN-001" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold small text-muted">Địa chỉ nhận hàng / Công trình</label>
                            <input type="text" name="deliveryAddress" id="fgDeliveryAddress" class="form-control form-control-sm" placeholder="Địa chỉ giao hàng chi tiết..." />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Số đơn hàng / Hợp đồng</label>
                            <input type="text" name="orderNo" class="form-control form-control-sm" placeholder="vd: DH-2026-0330-01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Diễn giải / Ghi chú</label>
                            <input type="text" name="remark" class="form-control form-control-sm" placeholder="Ghi chú điều kiện giao nhận..." />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thông tin vận chuyển & Phương tiện giao hàng -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-truck me-1"></i> 2. Phương tiện vận chuyển & Lái xe giao nhận
                    </h6>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Biển số xe vận chuyển (PlateNo)</label>
                            <input type="text" name="plateNo" class="form-control form-control-sm font-monospace fw-bold text-dark" placeholder="vd: 29C-888.66" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Số rơ-moóc / Container (MoocNo)</label>
                            <input type="text" name="moocNo" class="form-control form-control-sm font-monospace" placeholder="vd: 29R-012.34" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Tên lái xe giao nhận</label>
                            <input type="text" name="driverName" class="form-control form-control-sm" placeholder="vd: Nguyễn Văn Lái Xe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Số điện thoại liên hệ lái xe</label>
                            <input type="text" name="driverPhone" class="form-control form-control-sm" placeholder="vd: 0912.345.678" />
                        </div>

                        <div class="col-12 mt-3">
                            <div class="p-3 bg-light rounded border">
                                <div class="fw-semibold small text-dark mb-1"><i class="bi bi-shield-check text-success me-1"></i> Quy trình kiểm soát xuất kho WMS:</div>
                                <ul class="small text-muted mb-0 ps-3">
                                    <li>Lập phiếu xuất kho thành phẩm ghi nhận đầy đủ khách hàng và phương tiện.</li>
                                    <li>Sau khi lập, phiếu ở trạng thái <b>Chờ duyệt xuất</b>.</li>
                                    <li>Khi bấm <b>Phê duyệt & Xuất kho</b>, hệ thống tự động kiểm tra tồn kho, trừ tồn thực tế và kích hoạt trạng thái Serial đã xuất kho.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chi tiết các mặt hàng thành phẩm -->
        <div class="col-lg-12">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-list-check me-1"></i> 3. Danh mục mặt hàng thành phẩm xuất kho
                    </h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addRowBtn">
                        <i class="bi bi-plus-lg me-1"></i> Thêm mặt hàng
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0" id="itemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40px;" class="text-center">#</th>
                                    <th style="min-width: 250px;">Mặt hàng thành phẩm <span class="text-danger">*</span></th>
                                    <th style="width: 130px;" class="text-end">SL xuất <span class="text-danger">*</span></th>
                                    <th style="width: 150px;" class="text-end">Đơn giá xuất (VNĐ)</th>
                                    <th style="width: 150px;" class="text-end">Giá vốn (VNĐ)</th>
                                    <th style="width: 160px;" class="text-end">Thành tiền (VNĐ)</th>
                                    <th style="min-width: 180px;">Ghi chú dòng</th>
                                    <th style="width: 50px;" class="text-center">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody">
                                <!-- Dòng mẫu ban đầu -->
                                <tr class="item-row">
                                    <td class="text-center text-muted row-idx">1</td>
                                    <td>
                                        <select name="productIds" class="form-select form-select-sm prod-select" required onchange="onProdChange(this)">
                                            <option value="">-- Chọn sản phẩm --</option>
                                            @foreach (var p in prods)
                                            {
                                                <option value="@p.Id" data-code="@p.Code" data-uom="@p.Uom" data-cost="@p.CostPrice">
                                                    @p.Code - @p.Name (@p.Uom)
                                                </option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" name="qtys" class="form-control form-control-sm text-end qty-input" min="1" value="1" required oninput="calcRow(this)" />
                                    </td>
                                    <td>
                                        <input type="number" name="unitPrices" class="form-control form-control-sm text-end price-input" min="0" step="1000" value="0" oninput="calcRow(this)" />
                                    </td>
                                    <td>
                                        <input type="number" name="unitCosts" class="form-control form-control-sm text-end cost-input" min="0" step="1000" value="0" />
                                    </td>
                                    <td class="text-end fw-bold font-monospace line-amount text-dark">
                                        0 đ
                                    </td>
                                    <td>
                                        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Ghi chú quy cách, kiện..." />
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeRow(this)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="2" class="text-end">TỔNG CỘNG:</td>
                                    <td class="text-end text-primary" id="totalQtySum">1</td>
                                    <td colspan="2"></td>
                                    <td class="text-end text-success font-monospace" id="totalAmountSum">0 đ</td>
                                    <td colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quét / Nhập danh sách Serial / IMEI (Tùy chọn) -->
        <div class="col-lg-12">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-upc-scan me-1"></i> 4. Quét mã Barcode / Serial / IMEI xuất kho (Tùy chọn)
                    </h6>
                    <span class="badge bg-light text-muted border">Tùy chọn xuất theo Serial</span>
                </div>
                <div class="card-body p-3">
                    <p class="small text-muted mb-2">
                        Nếu xuất các sản phẩm quản lý theo Serial/IMEI, hãy dán hoặc dùng máy quét mã vạch nhập danh sách vào ô bên dưới.
                        Mỗi dòng 1 mã Serial. Có thể nhập dạng <code>MÃ_SP:SỐ_SERIAL</code> (vd: <code>SP01:AO2603-001</code>) hoặc chỉ nhập <code>SỐ_SERIAL</code>.
                    </p>
                    <textarea name="serialsInput" class="form-control font-monospace text-primary" rows="4" placeholder="vd:&#10;SP01:AO2603-001&#10;SP01:AO2603-002&#10;SP02:QJ2603-001"></textarea>
                </div>
            </div>
        </div>

        <!-- Nút lưu / hoàn tất -->
        <div class="col-12 d-flex justify-content-end gap-2 mb-5">
            <a href="/InventoryOutFG" class="btn btn-outline-secondary px-4">
                Hủy bỏ
            </a>
            <button type="submit" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-check2-circle me-1"></i> Lập phiếu xuất thành phẩm
            </button>
        </div>
    </div>
</form>

<template id="rowTemplate">
    <tr class="item-row">
        <td class="text-center text-muted row-idx"></td>
        <td>
            <select name="productIds" class="form-select form-select-sm prod-select" required onchange="onProdChange(this)">
                <option value="">-- Chọn sản phẩm --</option>
                @foreach (var p in prods)
                {
                    <option value="@p.Id" data-code="@p.Code" data-uom="@p.Uom" data-cost="@p.CostPrice">
                        @p.Code - @p.Name (@p.Uom)
                    </option>
                }
            </select>
        </td>
        <td>
            <input type="number" name="qtys" class="form-control form-control-sm text-end qty-input" min="1" value="1" required oninput="calcRow(this)" />
        </td>
        <td>
            <input type="number" name="unitPrices" class="form-control form-control-sm text-end price-input" min="0" step="1000" value="0" oninput="calcRow(this)" />
        </td>
        <td>
            <input type="number" name="unitCosts" class="form-control form-control-sm text-end cost-input" min="0" step="1000" value="0" />
        </td>
        <td class="text-end fw-bold font-monospace line-amount text-dark">
            0 đ
        </td>
        <td>
            <input type="text" name="notes" class="form-control form-control-sm" placeholder="Ghi chú quy cách, kiện..." />
        </td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeRow(this)">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
<script>
    function onSelectFGCustomer(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.value) {
            document.getElementById('fgAgentCode').value = opt.value;
            document.getElementById('fgCustomerName').value = opt.getAttribute('data-name') || '';
            document.getElementById('fgDeliveryAddress').value = opt.getAttribute('data-address') || '';
        }
    }

    function updateIndices() {
        document.querySelectorAll('#itemsBody .item-row').forEach((tr, i) => {
            tr.querySelector('.row-idx').textContent = i + 1;
        });
        recalcTotal();
    }

    function onProdChange(select) {
        var opt = select.options[select.selectedIndex];
        var tr = select.closest('tr');
        var cost = opt.getAttribute('data-cost') || 0;
        var costInput = tr.querySelector('.cost-input');
        if (costInput && (!costInput.value || costInput.value == 0)) {
            costInput.value = cost;
        }
        var priceInput = tr.querySelector('.price-input');
        if (priceInput && (!priceInput.value || priceInput.value == 0)) {
            priceInput.value = Math.round(cost * 1.3);
        }
        calcRow(select);
    }

    function calcRow(el) {
        var tr = el.closest('tr');
        var qty = parseFloat(tr.querySelector('.qty-input').value) || 0;
        var price = parseFloat(tr.querySelector('.price-input').value) || 0;
        var amt = qty * price;
        tr.querySelector('.line-amount').textContent = amt.toLocaleString('vi-VN') + ' đ';
        recalcTotal();
    }

    function recalcTotal() {
        var totalQty = 0;
        var totalAmt = 0;
        document.querySelectorAll('#itemsBody .item-row').forEach(tr => {
            var q = parseFloat(tr.querySelector('.qty-input')?.value) || 0;
            var p = parseFloat(tr.querySelector('.price-input')?.value) || 0;
            totalQty += q;
            totalAmt += (q * p);
        });
        document.getElementById('totalQtySum').textContent = totalQty.toLocaleString('vi-VN');
        document.getElementById('totalAmountSum').textContent = totalAmt.toLocaleString('vi-VN') + ' đ';
    }

    document.getElementById('addRowBtn').addEventListener('click', function () {
        var tpl = document.getElementById('rowTemplate');
        var clone = tpl.content.cloneNode(true);
        document.getElementById('itemsBody').appendChild(clone);
        updateIndices();
    });

    function removeRow(btn) {
        var rows = document.querySelectorAll('#itemsBody .item-row');
        if (rows.length <= 1) {
            alert('Cần ít nhất 1 dòng mặt hàng.');
            return;
        }
        btn.closest('tr').remove();
        updateIndices();
    }

    document.addEventListener('DOMContentLoaded', function () {
        updateIndices();
    });
</script>
}
