@model InventoryOutFG
@{
    ViewData["Title"] = $"Phiếu xuất kho thành phẩm {Model.Code}";
    var (statusLabel, badgeClass) = Model.Status switch
    {
        InvOutFGStatus.Pending => ("Chờ duyệt xuất", "bg-warning text-dark"),
        InvOutFGStatus.Approved => ("Đã xuất kho", "bg-success"),
        InvOutFGStatus.Cancelled => ("Đã hủy", "bg-secondary"),
        _ => ("Khác", "bg-light text-dark")
    };

    var outTypeLabel = Model.OutType switch
    {
        InvOutFGType.Commercial => "Xuất thương mại / Đại lý bán buôn (OUTTHUONGMAI)",
        InvOutFGType.EndCustomer => "Xuất khách hàng lẻ / Công trình dự án (OUTENDCUS)",
        InvOutFGType.BranchTransfer => "Điều chuyển chi nhánh / Showroom (TRANSFER)",
        InvOutFGType.WarrantyScrap => "Xuất bảo hành / Đổi trả / Hủy mẫu (WARRANTY)",
        _ => "Khác"
    };

    var formLabel = Model.FormType switch
    {
        InvOutFGFormType.QuantityOnly => "Xuất theo số lượng thông thường (KHONGMAVACH)",
        InvOutFGFormType.BarcodeSerial => "Quét mã vạch / Serial cá thể hóa (MAVACH)",
        _ => "Khác"
    };
}

<style>
    @@media print {
        body * { visibility: hidden; }
        #fgOutPrintArea, #fgOutPrintArea * { visibility: visible; }
        #fgOutPrintArea { position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 20px; background: #fff; }
        .no-print { display: none !important; }
    }
    .barcode-font {
        font-family: 'Courier New', Courier, monospace;
        letter-spacing: 4px;
        font-weight: 800;
    }
</style>

<!-- Tiêu đề & Nút thao tác (no-print) -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 no-print">
    <div class="d-flex align-items-center gap-2">
        <a href="/InventoryOutFG" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        <h4 class="mb-0 fw-bold text-dark">
            <i class="bi bi-box-arrow-up-right text-primary me-2"></i>Phiếu xuất TP: <span class="text-primary font-monospace">@Model.Code</span>
        </h4>
        <span class="badge @badgeClass fs-6 px-3 py-2 ms-2">@statusLabel</span>
    </div>

    <div class="d-flex gap-2">
        <button type="button" onclick="window.print()" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-printer me-1"></i> In phiếu xuất kho A4
        </button>

        @if (Model.Status == InvOutFGStatus.Pending)
        {
            <form method="post" action="/InventoryOutFG/Approve/@Model.Id" class="d-inline" onsubmit="return confirm('Phê duyệt xuất kho thành phẩm @Model.Code? Toàn bộ @Model.TotalQty thành phẩm sẽ được ghi sổ giảm tồn kho và cập nhật Serial xuất bán.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success btn-sm fw-semibold">
                    <i class="bi bi-check-circle me-1"></i> Phê duyệt & Xuất kho
                </button>
            </form>

            <form method="post" action="/InventoryOutFG/Cancel/@Model.Id" class="d-inline" onsubmit="return confirm('Hủy phiếu xuất kho thành phẩm @Model.Code?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-x-circle me-1"></i> Hủy phiếu
                </button>
            </form>
        }
    </div>
</div>

<!-- Alert trạng thái ghi sổ (no-print) -->
@if (Model.Status == InvOutFGStatus.Approved)
{
    <div class="alert alert-success d-flex align-items-center justify-content-between py-2 mb-3 no-print">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>
                Phiếu đã được <b>Phê duyệt & Xuất kho</b> vào lúc <b>@(Model.ApprovedAt?.ToString("dd/MM/yyyy HH:mm"))</b> bởi <b>@Model.ApprovedBy</b>.
                Số lượng thành phẩm đã được ghi sổ giảm tồn kho thực tế và cập nhật Thẻ kho.
            </div>
        </div>
        @if (Model.StockDocId.HasValue)
        {
            <a href="/Doc/Detail/@Model.StockDocId.Value" class="btn btn-sm btn-outline-success bg-white">
                <i class="bi bi-box-arrow-up-right me-1"></i> Xem Phiếu kho liên kết
            </a>
        }
    </div>
}
else if (Model.Status == InvOutFGStatus.Cancelled)
{
    <div class="alert alert-secondary d-flex align-items-center py-2 mb-3 no-print">
        <i class="bi bi-x-circle-fill fs-5 me-2 text-danger"></i>
        <div>Phiếu xuất kho thành phẩm này đã bị <b>Hủy bỏ</b>. Không có biến động tồn kho phát sinh.</div>
    </div>
}

<div class="row g-3 no-print">
    <!-- Thông tin khách hàng & Phiếu xuất -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-primary">
                    <i class="bi bi-building me-1"></i> Thông tin phiếu xuất kho & Đơn vị nhận hàng
                </h6>
            </div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 140px;">Mã phiếu xuất:</td>
                            <td class="fw-bold font-monospace text-primary">@Model.Code</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Kho xuất hàng:</td>
                            <td class="fw-semibold">@Model.Warehouse.Name <span class="badge bg-light text-secondary border">@Model.Warehouse.Code</span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Nghiệp vụ xuất:</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@outTypeLabel</span></td>
                        </tr>
                        <tr>
                            <td class="text-muted">Hình thức xuất:</td>
                            <td>@formLabel</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Đơn vị nhận:</td>
                            <td class="fw-bold text-dark">@Model.CustomerName</td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(Model.AgentCode))
                        {
                            <tr>
                                <td class="text-muted">Mã đại lý / MST:</td>
                                <td class="font-monospace">@Model.AgentCode</td>
                            </tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.DeliveryAddress))
                        {
                            <tr>
                                <td class="text-muted">Địa chỉ nhận:</td>
                                <td><i class="bi bi-geo-alt me-1 text-danger"></i>@Model.DeliveryAddress</td>
                            </tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OrderNo))
                        {
                            <tr>
                                <td class="text-muted">Số đơn hàng / HĐ:</td>
                                <td class="font-monospace fw-semibold">@Model.OrderNo</td>
                            </tr>
                        }
                        <tr>
                            <td class="text-muted">Ngày xuất kho:</td>
                            <td>@Model.Date.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Người lập:</td>
                            <td>@Model.CreatedBy <span class="text-muted small">(@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm"))</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Thông tin vận chuyển & Tài xế -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-primary">
                    <i class="bi bi-truck me-1"></i> Phương tiện vận tải & Lái xe giao nhận
                </h6>
            </div>
            <div class="card-body p-3">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="text-muted" style="width: 140px;">Biển số xe tải:</td>
                            <td class="fw-bold font-monospace fs-6 text-dark">
                                @(string.IsNullOrWhiteSpace(Model.PlateNo) ? "—" : Model.PlateNo)
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Số rơ-moóc / Container:</td>
                            <td class="font-monospace">@(string.IsNullOrWhiteSpace(Model.MoocNo) ? "—" : Model.MoocNo)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Họ tên lái xe:</td>
                            <td class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.DriverName) ? "—" : Model.DriverName)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Số điện thoại lái xe:</td>
                            <td>@(string.IsNullOrWhiteSpace(Model.DriverPhone) ? "—" : Model.DriverPhone)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Diễn giải / Ghi chú:</td>
                            <td>@(string.IsNullOrWhiteSpace(Model.Remark) ? "—" : Model.Remark)</td>
                        </tr>
                        <tr>
                            <td class="text-muted">Phiếu kho liên kết:</td>
                            <td>
                                @if (Model.StockDoc != null)
                                {
                                    <a href="/Doc/Detail/@Model.StockDoc.Id" class="badge bg-success text-decoration-none">
                                        <i class="bi bi-link-45deg me-1"></i>@Model.StockDoc.Code (Đã ghi sổ)
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa sinh phiếu xuất</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row g-2 mt-2 pt-2 border-top text-center">
                    <div class="col-4">
                        <div class="p-2 bg-light rounded">
                            <div class="text-muted small">Mặt hàng</div>
                            <div class="fw-bold text-dark fs-5">@Model.TotalItemsCount</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 bg-light rounded">
                            <div class="text-muted small">Tổng SL xuất</div>
                            <div class="fw-bold text-primary fs-5">@Model.TotalQty.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-2 bg-light rounded">
                            <div class="text-muted small">Tổng tiền</div>
                            <div class="fw-bold text-success fs-5">@Model.TotalAmount.ToString("N0") đ</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách mặt hàng -->
    <div class="col-12">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="mb-0 fw-bold text-primary">
                    <i class="bi bi-box-seam me-1"></i> Bảng kê chi tiết mặt hàng thành phẩm xuất kho
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center" style="width: 40px;">STT</th>
                                <th>Mã sản phẩm</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-center">ĐVT</th>
                                <th class="text-end">Số lượng xuất</th>
                                <th class="text-end">Đơn giá xuất (VNĐ)</th>
                                <th class="text-end">Thành tiền (VNĐ)</th>
                                <th class="text-end">Đơn giá vốn</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int lineIdx = 1; }
                            @foreach (var l in Model.Lines)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(lineIdx++)</td>
                                    <td class="fw-bold font-monospace text-primary">@l.Product.Code</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@l.Product.Name</div>
                                    </td>
                                    <td class="text-center">@l.Product.Uom</td>
                                    <td class="text-end fw-bold text-primary fs-6">@l.Qty.ToString("N0")</td>
                                    <td class="text-end font-monospace">@l.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end fw-bold font-monospace text-dark">@l.Amount.ToString("N0") đ</td>
                                    <td class="text-end text-muted font-monospace">@l.UnitCost.ToString("N0") đ</td>
                                    <td class="small text-muted">@(l.Note ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="4" class="text-end">TỔNG CỘNG:</td>
                                <td class="text-end text-primary fs-6">@Model.TotalQty.ToString("N0")</td>
                                <td></td>
                                <td class="text-end text-success font-monospace fs-6">@Model.TotalAmount.ToString("N0") đ</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Danh sách Barcode / Serial nếu có -->
    @if (Model.Serials.Count > 0)
    {
        <div class="col-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-primary">
                        <i class="bi bi-upc-scan me-1"></i> Danh sách Barcode / Serial / IMEI xuất kho (@Model.Serials.Count mã)
                    </h6>
                    <span class="badge bg-primary">@Model.Serials.Count Serial</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        @foreach (var s in Model.Serials)
                        {
                            <div class="col-md-4 col-lg-3">
                                <div class="p-2 border rounded bg-light d-flex align-items-center justify-content-between">
                                    <div>
                                        <div class="fw-bold font-monospace text-dark">
                                            <i class="bi bi-upc me-1 text-primary"></i>@s.SerialNo
                                        </div>
                                        <div class="small text-muted font-monospace" style="font-size: 11px;">
                                            @s.Product.Code - @s.Product.Name
                                        </div>
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        Xuất kho
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- MẪU IN PHIẾU XUẤT KHO THÀNH PHẨM A4 CHUẨN WMS (fgOutPrintArea) -->
<div id="fgOutPrintArea" class="d-none d-print-block">
    <div style="font-family: 'Times New Roman', Times, serif; color: #000; line-height: 1.4;">
        <!-- Header thông tin công ty -->
        <table style="width: 100%; margin-bottom: 20px;">
            <tr>
                <td style="width: 60%; vertical-align: top;">
                    <div style="font-weight: bold; font-size: 16px; text-transform: uppercase;">CÔNG TY CỔ PHẦN PHẦN MỀM VÀ CÔNG NGHỆ IDOCNET</div>
                    <div style="font-size: 13px;">Địa chỉ: Khu Công Nghệ Cao, Hà Nội, Việt Nam</div>
                    <div style="font-size: 13px;">Kho xuất hàng: <b>@Model.Warehouse.Name</b> (@Model.Warehouse.Code)</div>
                </td>
                <td style="width: 40%; text-align: right; vertical-align: top;">
                    <div style="font-weight: bold; font-size: 14px;">Mẫu số: 02 - VT</div>
                    <div style="font-size: 12px; font-style: italic;">(Ban hành theo Thông tư số 200/2014/TT-BTC)</div>
                    <div style="margin-top: 5px; font-size: 13px;">Mã phiếu: <b class="font-monospace">@Model.Code</b></div>
                    <div style="font-size: 13px;">Ngày xuất: <b>@Model.Date.ToString("dd/MM/yyyy")</b></div>
                </td>
            </tr>
        </table>

        <!-- Tiêu đề phiếu -->
        <div style="text-align: center; margin: 25px 0 15px 0;">
            <div style="font-size: 22px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px;">
                PHIẾU XUẤT KHO THÀNH PHẨM
            </div>
            <div style="font-size: 14px; font-style: italic;">(Kiêm Biên bản bàn giao hàng hóa & vận chuyển nội bộ)</div>
            <div style="margin-top: 5px; font-size: 13px;">Hình thức: <b>@outTypeLabel</b></div>
        </div>

        <!-- Thông tin vận chuyển & Đơn vị nhận -->
        <table style="width: 100%; font-size: 14px; margin-bottom: 15px; border-collapse: collapse;">
            <tr>
                <td style="width: 18%; padding: 4px 0;">Khách hàng / Đại lý:</td>
                <td style="width: 42%; padding: 4px 0; font-weight: bold;">@Model.CustomerName</td>
                <td style="width: 18%; padding: 4px 0;">Mã đại lý / MST:</td>
                <td style="width: 22%; padding: 4px 0; font-weight: bold;">@(Model.AgentCode ?? "—")</td>
            </tr>
            <tr>
                <td style="padding: 4px 0;">Địa chỉ giao hàng:</td>
                <td colspan="3" style="padding: 4px 0;">@(Model.DeliveryAddress ?? "Theo địa chỉ hợp đồng")</td>
            </tr>
            <tr>
                <td style="padding: 4px 0;">Phương tiện vận tải:</td>
                <td style="padding: 4px 0; font-weight: bold;">Biển số xe: @(Model.PlateNo ?? "—") @(!string.IsNullOrWhiteSpace(Model.MoocNo) ? $" / Moóc: {Model.MoocNo}" : "")</td>
                <td style="padding: 4px 0;">Lái xe / SĐT:</td>
                <td style="padding: 4px 0;">@(Model.DriverName ?? "—") @(!string.IsNullOrWhiteSpace(Model.DriverPhone) ? $"({Model.DriverPhone})" : "")</td>
            </tr>
            <tr>
                <td style="padding: 4px 0;">Số đơn hàng / HĐ:</td>
                <td style="padding: 4px 0; font-weight: bold;">@(Model.OrderNo ?? "—")</td>
                <td style="padding: 4px 0;">Kho xuất hàng:</td>
                <td style="padding: 4px 0;">@Model.Warehouse.Name</td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(Model.Remark))
            {
                <tr>
                    <td style="padding: 4px 0;">Diễn giải / Ghi chú:</td>
                    <td colspan="3" style="padding: 4px 0; font-style: italic;">@Model.Remark</td>
                </tr>
            }
        </table>

        <!-- Bảng danh sách hàng hóa -->
        <table style="width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 15px;" border="1">
            <thead>
                <tr style="background-color: #f2f2f2; text-align: center; font-weight: bold;">
                    <th style="padding: 8px 4px; width: 40px;">STT</th>
                    <th style="padding: 8px 6px;">Tên, nhãn hiệu, quy cách phẩm chất thành phẩm</th>
                    <th style="padding: 8px 6px; width: 90px;">Mã số SP</th>
                    <th style="padding: 8px 6px; width: 60px;">ĐVT</th>
                    <th style="padding: 8px 6px; width: 90px;">Số lượng xuất</th>
                    <th style="padding: 8px 6px; width: 100px;">Đơn giá (đ)</th>
                    <th style="padding: 8px 6px; width: 120px;">Thành tiền (đ)</th>
                </tr>
                <tr style="text-align: center; font-size: 11px; font-style: italic;">
                    <td style="padding: 2px;">A</td>
                    <td style="padding: 2px;">B</td>
                    <td style="padding: 2px;">C</td>
                    <td style="padding: 2px;">D</td>
                    <td style="padding: 2px;">1</td>
                    <td style="padding: 2px;">2</td>
                    <td style="padding: 2px;">3 = 1 x 2</td>
                </tr>
            </thead>
            <tbody>
                @{ int printStt = 1; }
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <td style="text-align: center; padding: 6px 4px;">@(printStt++)</td>
                        <td style="padding: 6px 8px; font-weight: bold;">@l.Product.Name</td>
                        <td style="padding: 6px; text-align: center; font-family: monospace;">@l.Product.Code</td>
                        <td style="padding: 6px; text-align: center;">@l.Product.Uom</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: bold;">@l.Qty.ToString("N0")</td>
                        <td style="padding: 6px 8px; text-align: right;">@l.UnitPrice.ToString("N0")</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: bold;">@l.Amount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-weight: bold;">
                    <td colspan="4" style="text-align: right; padding: 8px;">CỘNG:</td>
                    <td style="text-align: right; padding: 8px;">@Model.TotalQty.ToString("N0")</td>
                    <td></td>
                    <td style="text-align: right; padding: 8px;">@Model.TotalAmount.ToString("N0") đ</td>
                </tr>
            </tfoot>
        </table>

        <!-- Danh sách Serial xuất kho đính kèm nếu có -->
        @if (Model.Serials.Count > 0)
        {
            <div style="margin-bottom: 20px; font-size: 12px; border: 1px dashed #666; padding: 8px;">
                <div style="font-weight: bold; margin-bottom: 4px;">Danh sách Barcode / Serial / IMEI xuất kho (@Model.Serials.Count mã):</div>
                <div>
                    @string.Join(", ", Model.Serials.Select(s => s.SerialNo))
                </div>
            </div>
        }

        <!-- Chữ ký 4 bên xác nhận -->
        <table style="width: 100%; margin-top: 30px; font-size: 14px; text-align: center; border-collapse: collapse;">
            <tr>
                <td style="width: 25%; vertical-align: top;">
                    <div style="font-weight: bold;">Người lập phiếu</div>
                    <div style="font-style: italic; font-size: 12px;">(Ký, ghi rõ họ tên)</div>
                    <div style="margin-top: 60px; font-weight: bold;">@Model.CreatedBy</div>
                </td>
                <td style="width: 25%; vertical-align: top;">
