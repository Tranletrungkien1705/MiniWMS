                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{DocDateFull}}')">{{DocDateFull}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{WarehouseName}}')">{{WarehouseName}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{PartnerName}}')">{{PartnerName}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{Deliverer}}')">{{Deliverer}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{Receiver}}')">{{Receiver}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{ItemsTable}}')">{{ItemsTable}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{Signatures}}')">{{Signatures}}</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="insertToken('editBodyHtml', '{{Barcode}}')">{{Barcode}}</button>
