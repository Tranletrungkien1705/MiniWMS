                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tiêu đề chính biểu mẫu <span class="text-danger">*</span></label>
                            <input type="text" id="editHeaderTitle" name="HeaderTitle" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tiêu đề phụ / Căn cứ</label>
