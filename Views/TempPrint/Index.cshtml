            </form>
        </div>
    </div>
</div>

<!-- MODAL QUẢN LÝ LOẠI MẪU IN (MST_TEMPPRINTTYPE) -->
<div class="modal fade" id="typesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light py-2">
                <h6 class="modal-title fw-bold mb-0">
                    <i class="bi bi-tags text-primary me-2"></i>Danh mục Loại mẫu in (Mst_TempPrintType)
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="font-size:13px">
                <div class="card border mb-3">
                    <div class="card-header bg-light py-1 fw-semibold small">
                        <i class="bi bi-plus-circle me-1"></i> Thêm nhanh loại mẫu in mới
                    </div>
                    <div class="card-body p-2">
                        <form method="post" action="/TempPrint/CreateType" class="row g-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <div class="col-md-3">
                                <input type="text" name="Code" class="form-control form-control-sm text-uppercase" placeholder="Mã loại (vd: RETURN)" required />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Name" class="form-control form-control-sm" placeholder="Tên loại mẫu in..." required />
                            </div>
                            <div class="col-md-2">
                                <select name="GroupCode" class="form-select form-select-sm">
                                    <option value="DOC">Chứng từ (DOC)</option>
                                    <option value="LABEL">Tem nhãn (LABEL)</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-sm btn-success w-100">
                                    <i class="bi bi-plus-lg me-1"></i> Thêm loại
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:100px">Mã loại</th>
                                <th>Tên loại mẫu in</th>
                                <th style="width:110px" class="text-center">Nhóm</th>
                                <th>Mô tả quy cách</th>
                                <th style="width:100px" class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tp in types)
                            {
                                <tr>
                                    <td><strong class="font-monospace text-primary">@tp.Code</strong></td>
                                    <td class="fw-semibold">@tp.Name</td>
                                    <td class="text-center">
                                        <span class="badge @(tp.GroupCode == "LABEL" ? "bg-warning text-dark" : "bg-info text-dark")">@tp.GroupCode</span>
                                    </td>
                                    <td class="text-muted small">@tp.Description</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success">Hoạt động</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Hàm chèn token vào vị trí con trỏ trong textarea
    function insertToken(textareaId, token) {
        var textarea = document.getElementById(textareaId);
        if (!textarea) return;
        var start = textarea.selectionStart;
        var end = textarea.selectionEnd;
        var text = textarea.value;
        textarea.value = text.substring(0, start) + token + text.substring(end);
        textarea.focus();
        textarea.selectionStart = textarea.selectionEnd = start + token.length;
    }

    // Mở modal Xem trước (Live Preview)
    async function openPreviewModal(id) {
        try {
            var res = await fetch('/TempPrint/Preview/' + id);
            if (!res.ok) {
                alert('Không thể tải dữ liệu xem trước.');
                return;
            }
            var data = await res.json();
            document.getElementById('previewModalTitle').innerText = data.name + ' (' + data.code + ')';
            document.getElementById('previewModalSub').innerText = 'Loại: ' + data.typeName + ' · Khổ giấy: ' + data.paperSize;

            var paper = document.getElementById('previewPaper');
            paper.setAttribute('style', data.paperSizeCss + '; box-shadow:0 0 15px rgba(0,0,0,0.15);');
            document.getElementById('previewContent').innerHTML = data.renderedHtml;

            var modal = new bootstrap.Modal(document.getElementById('previewModal'));
            modal.show();
        } catch (e) {
            alert('Lỗi: ' + e.message);
        }
    }

    // In trực tiếp nội dung render
    function printRenderedHtml() {
        var content = document.getElementById('previewPaper').innerHTML;
        var printWindow = window.open('', '', 'width=900,height=800');
        printWindow.document.write('<html><head><title>In Biểu Mẫu WMS</title>');
        printWindow.document.write('<style>body{margin:0;padding:10mm;background:#fff;font-family:Arial,sans-serif;} table{border-collapse:collapse;width:100%;} @@media print { @@page { margin: 10mm; } body { padding: 0; } }</style>');
        printWindow.document.write('</head><body>');
        printWindow.document.write(content);
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        setTimeout(function() {
            printWindow.print();
            printWindow.close();
        }, 350);
    }

    // Mở modal Chỉnh sửa
    async function openEditModal(id) {
        try {
            var res = await fetch('/TempPrint/Detail/' + id);
            if (!res.ok) {
                alert('Không thể tải thông tin mẫu in.');
                return;
            }
            var item = await res.json();
            document.getElementById('editForm').action = '/TempPrint/Update/' + item.id;
            document.getElementById('editCodeLabel').innerText = item.code;
            document.getElementById('editName').value = item.name || '';
            document.getElementById('editTypeCode').value = item.typeCode || 'IN';
            document.getElementById('editPaperSize').value = item.paperSize || 'A4_Portrait';
            document.getElementById('editUnitName').value = item.unitName || '';
            document.getElementById('editUnitAddress').value = item.unitAddress || '';
            document.getElementById('editUnitPhone').value = item.unitPhone || '';
            document.getElementById('editUnitEmail').value = item.unitEmail || '';
            document.getElementById('editHeaderTitle').value = item.headerTitle || '';
            document.getElementById('editSubTitle').value = item.subTitle || '';
            document.getElementById('editBodyHtml').value = item.bodyTemplateHtml || '';
            document.getElementById('editNoteFooter').value = item.noteFooter || '';
            document.getElementById('editRemark').value = item.remark || '';
            document.getElementById('editIsDefault').checked = item.isDefault === true;
            document.getElementById('editIsActive').checked = item.isActive === true;

            var modal = new bootstrap.Modal(document.getElementById('editTempPrintModal'));
            modal.show();
        } catch (e) {
            alert('Lỗi: ' + e.message);
        }
    }
</script>
}
