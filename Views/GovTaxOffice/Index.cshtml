@model GovTaxOfficeReport
@{
    ViewData["Title"] = "Cơ quan thuế quản lý";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var parentCodeFilter = (string)(ViewBag.ParentCode ?? "");
    var levelFilter = (int?)ViewBag.Level;
    var activeOnly = (bool?)ViewBag.ActiveOnly;
    var rootOffices = ViewBag.RootOffices as List<GovTaxOffice> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-bank text-primary me-2"></i>Danh mục Cơ quan thuế quản lý</h5>
        <div class="text-muted small">Port từ <code>Mst_GovTaxID</code> (Skycic) — Quản lý danh mục cơ quan thuế quản lý theo phân cấp cây Cục Thuế → Chi cục Thuế → Đội Thuế (GovTaxID, GovTaxIDParent, GovTaxIDBUCode, GovTaxIDLevel, ProvinceCode, DistrictCode, GovTaxName, Address, ContactEmail, ContactPhone, FlagActive), liên kết phân loại khách hàng / NCC theo cơ quan thuế quản lý địa bàn</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/GovTaxOffice/ExportCsv?q=@keyword&parentCode=@parentCodeFilter&level=@levelFilter&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> In danh mục
        </button>
        <a href="/Customer" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-people me-1"></i> Khách hàng / Đại lý
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createOfficeModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Cơ quan thuế
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG SỐ CƠ QUAN THUẾ</span>
                    <i class="bi bi-bank text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalOffices</div>
                <div class="small text-muted">Cơ quan thuế trong hệ thống</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">CỤC THUẾ (CẤP GỐC)</span>
                    <i class="bi bi-diagram-2 text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary">@Model.RootOfficesCount</div>
                <div class="small text-muted">Cục Thuế cấp tỉnh / thành phố</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">CHI CỤC / ĐỘI THUẾ</span>
                    <i class="bi bi-diagram-3 text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-info">@Model.SubOfficesCount</div>
                <div class="small text-muted">Cơ quan thuế trực thuộc cấp dưới</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">KH / NCC GẮN CQT</span>
                    <i class="bi bi-people text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.TotalManagedCustomers</div>
                <div class="small text-muted">Đối tác được gán cơ quan thuế quản lý</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Tìm theo mã, tên cơ quan thuế, địa chỉ, email..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="parentCode" class="form-select form-select-sm">
                    <option value="">-- Tất cả cơ quan cấp trên --</option>
                    <option value="ROOT" selected="@(parentCodeFilter == "ROOT")">★ Chỉ hiển thị Cục Thuế (Cấp gốc)</option>
                    @foreach (var ro in rootOffices)
                    {
                        <!option value="@ro.Code" @(string.Equals(parentCodeFilter, ro.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Cấp dưới của: @ro.Name (@ro.Code)</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="level" class="form-select form-select-sm">
                    <option value="">-- Tất cả cấp bậc --</option>
                    <!option value="0" @(levelFilter == 0 ? "selected" : "")>Cục Thuế</!option>
                    <!option value="1" @(levelFilter == 1 ? "selected" : "")>Chi cục Thuế</!option>
                    <!option value="2" @(levelFilter == 2 ? "selected" : "")>Đội Thuế</!option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Tạm dừng</!option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-funnel"></i></button>
                <a href="/GovTaxOffice" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Cơ quan thuế -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width: 50px;">STT</th>
                    <th style="width: 150px;">Mã cơ quan thuế</th>
                    <th>Tên Cơ quan thuế</th>
                    <th style="width: 130px;">Cấp bậc</th>
                    <th style="width: 180px;">Cơ quan cấp trên</th>
                    <th>Địa chỉ / Liên hệ</th>
                    <th class="text-center" style="width: 110px;">Cấp trực thuộc</th>
                    <th class="text-center" style="width: 120px;">KH / NCC</th>
                    <th class="text-center" style="width: 120px;">Trạng thái</th>
                    <th class="text-end" style="width: 150px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="text-center text-muted small">@idx</td>
                        <td>
                            <span class="badge bg-light text-dark border font-monospace">@r.Code</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">
                                @if (r.Level > 0)
                                {
                                    <span class="text-muted me-1">↳</span>
                                }
                                @r.Name
                            </div>
                        </td>
                        <td>
                            @if (r.Level == 0)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    <i class="bi bi-bank me-1"></i>Cục Thuế
                                </span>
                            }
                            else if (r.Level == 1)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle">
                                    <i class="bi bi-diagram-3 me-1"></i>Chi cục Thuế
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                    <i class="bi bi-diagram-2 me-1"></i>@r.LevelName
                                </span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(r.ParentCode))
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-arrow-return-right me-1 text-muted"></i>@(r.ParentName ?? r.ParentCode)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small"><em>(Cấp gốc)</em></span>
                            }
                        </td>
                        <td>
                            <div class="small text-muted text-truncate" style="max-width: 260px;" title="@r.Address">
                                <i class="bi bi-geo-alt me-1"></i>@(r.Address ?? "—")
                            </div>
                            @if (!string.IsNullOrEmpty(r.ContactPhone) || !string.IsNullOrEmpty(r.ContactEmail))
                            {
                                <div class="small text-muted" style="font-size: 11px;">
                                    @if (!string.IsNullOrEmpty(r.ContactPhone)) { <span class="me-2"><i class="bi bi-telephone"></i> @r.ContactPhone</span> }
                                    @if (!string.IsNullOrEmpty(r.ContactEmail)) { <span><i class="bi bi-envelope"></i> @r.ContactEmail</span> }
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            @if (r.SubOfficeCount > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">
                                    <i class="bi bi-diagram-3 me-1"></i>@r.SubOfficeCount
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">0</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (r.ManagedCustomerCount > 0)
                            {
                                <span class="badge bg-info-subtle text-info border border-info-subtle fw-semibold">
                                    <i class="bi bi-people me-1"></i>@r.ManagedCustomerCount
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">0</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (r.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                    <i class="bi bi-pause-circle me-1"></i>Tạm dừng
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-info" title="Xem chi tiết phân cấp & đối tác quản lý" onclick="openDetailModal(@r.Id)">
                                    <i class="bi bi-info-circle"></i>
                                </button>
                                <button type="button" class="btn btn-outline-primary" title="Chỉnh sửa thông tin" onclick="openEditModal(@r.Id, '@Html.Raw(r.Code)', '@Html.Raw(r.Name)', '@Html.Raw(r.ParentCode ?? "")', '@Html.Raw(r.ProvinceCode ?? "")', '@Html.Raw(r.DistrictCode ?? "")', '@Html.Raw(r.Address ?? "")', '@Html.Raw(r.ContactEmail ?? "")', '@Html.Raw(r.ContactPhone ?? "")', @(r.IsActive ? "true" : "false"))">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form asp-action="Toggle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-outline-secondary" title="@(r.IsActive ? "Tạm dừng áp dụng" : "Kích hoạt áp dụng")">
                                        <i class="bi @(r.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-muted")"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa hoặc ngừng áp dụng cơ quan thuế \'@r.Name\' (@r.Code)?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button type="submit" class="btn btn-outline-danger" title="Xóa cơ quan thuế">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    idx++;
                }
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            Không tìm thấy Cơ quan thuế nào phù hợp với bộ lọc tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm mới Cơ quan thuế -->
<div class="modal fade" id="createOfficeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="Create" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold text-primary mb-0">
                    <i class="bi bi-plus-circle me-1"></i> Thêm mới Cơ quan thuế quản lý
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Mã cơ quan thuế <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control form-control-sm font-monospace text-uppercase" placeholder="vd: 0100231226, 0100231226-001..." required />
                        <div class="form-text small" style="font-size: 11px;">Mã chuẩn hóa (GovTaxID)</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Cơ quan cấp trên</label>
                        <select name="parentCode" class="form-select form-select-sm">
                            <option value="">-- Là Cục Thuế (Cấp gốc) --</option>
                            @foreach (var ro in rootOffices)
                            {
                                <option value="@ro.Code">@ro.Name (@ro.Code)</option>
                            }
                        </select>
                        <div class="form-text small" style="font-size: 11px;">Để trống nếu là cấp gốc</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-muted">Tên Cơ quan thuế <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control form-control-sm" placeholder="vd: Cục Thuế TP Hà Nội, Chi cục Thuế Quận Hoàn Kiếm..." required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Mã tỉnh / thành phố</label>
                        <input type="text" name="provinceCode" class="form-control form-control-sm font-monospace" placeholder="vd: 01, 79..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Mã quận / huyện</label>
                        <input type="text" name="districtCode" class="form-control form-control-sm font-monospace" placeholder="vd: 001, 760..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-muted">Địa chỉ trụ sở</label>
                        <input type="text" name="address" class="form-control form-control-sm" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Email liên hệ</label>
                        <input type="email" name="contactEmail" class="form-control form-control-sm" placeholder="cucthue@example.gov.vn" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Điện thoại liên hệ</label>
                        <input type="text" name="contactPhone" class="form-control form-control-sm" placeholder="024.xxxx.xxxx" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" id="createIsActive" checked />
                            <label class="form-check-label small fw-semibold" for="createIsActive">Kích hoạt áp dụng ngay</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu cơ quan thuế</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Chỉnh sửa Cơ quan thuế -->
<div class="modal fade" id="editOfficeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form asp-action="Update" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="editId" />
            <div class="modal-header bg-light">
                <h6 class="modal-title fw-bold text-primary mb-0">
                    <i class="bi bi-pencil-square me-1"></i> Cập nhật Cơ quan thuế quản lý
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Mã cơ quan thuế</label>
                        <input type="text" id="editCode" class="form-control form-control-sm font-monospace bg-light" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Cơ quan cấp trên</label>
                        <select name="parentCode" id="editParentCode" class="form-select form-select-sm">
                            <option value="">-- Là Cục Thuế (Cấp gốc) --</option>
                            @foreach (var ro in rootOffices)
                            {
                                <option value="@ro.Code">@ro.Name (@ro.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-muted">Tên Cơ quan thuế <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editName" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Mã tỉnh / thành phố</label>
                        <input type="text" name="provinceCode" id="editProvinceCode" class="form-control form-control-sm font-monospace" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Mã quận / huyện</label>
                        <input type="text" name="districtCode" id="editDistrictCode" class="form-control form-control-sm font-monospace" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold text-muted">Địa chỉ trụ sở</label>
                        <input type="text" name="address" id="editAddress" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Email liên hệ</label>
                        <input type="email" name="contactEmail" id="editContactEmail" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted">Điện thoại liên hệ</label>
                        <input type="text" name="contactPhone" id="editContactPhone" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editIsActive" />
                            <label class="form-check-label small fw-semibold" for="editIsActive">Đang áp dụng</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Chi tiết Cơ quan thuế -->
<div class="modal fade" id="officeDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <div>
                    <h6 class="modal-title fw-bold text-primary mb-0" id="detailOfficeTitle">
                        <i class="bi bi-bank me-1"></i> Chi tiết Cơ quan thuế quản lý
                    </h6>
                    <div class="text-muted small" id="detailOfficeSub"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-2 mb-3">
                    <div class="col-4">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="text-muted small" style="font-size: 11px;">Cơ quan trực thuộc</div>
                            <div class="fw-bold text-primary fs-5" id="detailSubOfficeCount">0</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="text-muted small" style="font-size: 11px;">KH / NCC quản lý</div>
                            <div class="fw-bold text-info fs-5" id="detailCustomerCount">0</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded p-2 text-center bg-light">
                            <div class="text-muted small" style="font-size: 11px;">Cấp bậc</div>
                            <div class="fw-bold text-dark fs-6" id="detailLevel">—</div>
                        </div>
                    </div>
                </div>

                <ul class="nav nav-tabs nav-tabs-bordered mb-3" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active btn-sm" data-bs-toggle="tab" data-bs-target="#tab-suboffices" type="button">
                            <i class="bi bi-diagram-3 me-1"></i>Cơ quan trực thuộc (<span id="tabBadgeSubOffices">0</span>)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link btn-sm" data-bs-toggle="tab" data-bs-target="#tab-managedcustomers" type="button">
                            <i class="bi bi-people me-1"></i>KH / NCC quản lý (<span id="tabBadgeCustomers">0</span>)
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="tab-suboffices">
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Mã cơ quan</th>
                                        <th>Tên cơ quan trực thuộc</th>
                                        <th class="text-center">Cấp</th>
                                        <th class="text-center">Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBodySubOffices">
                                    <tr><td colspan="4" class="text-center text-muted py-3">Không có cơ quan trực thuộc.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab-managedcustomers">
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Mã KH</th>
                                        <th>Tên khách hàng / NCC</th>
                                        <th>Phân loại</th>
                                        <th>Mã số thuế</th>
                                    </tr>
                                </thead>
                                <tbody id="tableBodyCustomers">
                                    <tr><td colspan="4" class="text-center text-muted py-3">Không có đối tác thuộc cơ quan thuế này.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openEditModal(id, code, name, parentCode, provinceCode, districtCode, address, contactEmail, contactPhone, isActive) {
    document.getElementById('editId').value = id;
    document.getElementById('editCode').value = code;
    document.getElementById('editName').value = name;
    document.getElementById('editParentCode').value = parentCode;
    document.getElementById('editProvinceCode').value = provinceCode;
    document.getElementById('editDistrictCode').value = districtCode;
    document.getElementById('editAddress').value = address;
    document.getElementById('editContactEmail').value = contactEmail;
    document.getElementById('editContactPhone').value = contactPhone;
    document.getElementById('editIsActive').checked = isActive;
    new bootstrap.Modal(document.getElementById('editOfficeModal')).show();
}

async function openDetailModal(id) {
    const modalEl = document.getElementById('officeDetailModal');
    const modal = new bootstrap.Modal(modalEl);
    modal.show();

    document.getElementById('tableBodySubOffices').innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Đang tải dữ liệu...</td></tr>';
    document.getElementById('tableBodyCustomers').innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Đang tải dữ liệu...</td></tr>';

    try {
        const res = await fetch(`/GovTaxOffice/Detail/${id}`);
        if (!res.ok) throw new Error('Không thể tải thông tin cơ quan thuế.');
        const data = await res.json();

        const levelNames = { 0: 'Cục Thuế', 1: 'Chi cục Thuế', 2: 'Đội Thuế' };
        document.getElementById('detailOfficeTitle').innerHTML = `<i class="bi bi-bank me-1"></i> ${data.name} <span class="badge bg-primary ms-1">${data.code}</span>`;
        document.getElementById('detailOfficeSub').innerText = `${data.parentName ? 'Trực thuộc: ' + data.parentName + ' (' + data.parentCode + ') · ' : 'Cấp gốc · '}${data.address || 'Chưa có địa chỉ'}`;

        document.getElementById('detailSubOfficeCount').innerText = (data.subOffices || []).length;
        document.getElementById('detailCustomerCount').innerText = data.totalManagedCustomers;
        document.getElementById('detailLevel').innerText = levelNames[data.level] || ('Cấp ' + data.level);

        document.getElementById('tabBadgeSubOffices').innerText = (data.subOffices || []).length;
        document.getElementById('tabBadgeCustomers').innerText = data.totalManagedCustomers;

        const subTbody = document.getElementById('tableBodySubOffices');
        if (data.subOffices && data.subOffices.length > 0) {
            subTbody.innerHTML = data.subOffices.map(s => `
                <tr>
                    <td><code>${s.code}</code></td>
                    <td class="fw-semibold">${s.name}</td>
                    <td class="text-center"><span class="badge bg-light text-dark border">${levelNames[s.level] || ('Cấp ' + s.level)}</span></td>
                    <td class="text-center"><span class="badge ${s.isActive ? 'bg-success-subtle text-success' : 'bg-secondary-subtle text-secondary'}">${s.isActive ? 'Áp dụng' : 'Tạm dừng'}</span></td>
                </tr>
            `).join('');
        } else {
            subTbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Không có cơ quan trực thuộc.</td></tr>';
        }

        const custTbody = document.getElementById('tableBodyCustomers');
        if (data.customers && data.customers.length > 0) {
            custTbody.innerHTML = data.customers.map(c => `
                <tr>
                    <td><code>${c.code}</code></td>
                    <td class="fw-semibold">${c.name}</td>
                    <td><span class="badge bg-light text-dark border">${c.customerType}</span></td>
                    <td class="small text-muted font-monospace">${c.taxCode || '—'}</td>
                </tr>
            `).join('');
        } else {
            custTbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-3">Chưa có đối tác nào được gắn cơ quan thuế này.</td></tr>';
        }
    } catch (e) {
        document.getElementById('tableBodySubOffices').innerHTML = `<tr><td colspan="4" class="text-center text-danger py-3">${e.message}</td></tr>`;
        document.getElementById('tableBodyCustomers').innerHTML = `<tr><td colspan="4" class="text-center text-danger py-3">${e.message}</td></tr>`;
    }
}
</script>
}