@model PartUnitReport
@{
    ViewData["Title"] = "Đơn vị tính";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
    var standardOnly = (bool?)ViewBag.StandardOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-rulers text-primary me-2"></i>Danh mục Đơn vị tính hàng hóa / vật tư kho</h5>
        <div class="text-muted small">Port từ <code>Mst_PartUnit</code> (Skycic) — Quản trị danh mục đơn vị tính (UOM), chuẩn hóa đơn vị cơ bản và đơn vị quy đổi, theo dõi số lượng mặt hàng và tồn kho theo từng đơn vị</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/PartUnit/ExportCsv?q=@keyword&activeOnly=@activeOnly&standardOnly=@standardOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/Product" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> Danh sách mặt hàng
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createUnitModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Đơn vị tính
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG ĐƠN VỊ TÍNH</span>
                    <i class="bi bi-rulers text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalUnits</div>
                <div class="small text-muted">Đơn vị đo lường & đóng gói trong hệ thống</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐƠN VỊ CƠ BẢN / CHUẨN</span>
                    <i class="bi bi-shield-check text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-info">@Model.StandardUnitsCount</div>
                <div class="small text-muted">Đơn vị chuẩn hóa cơ bản lưu trữ tồn kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Khả dụng gán cho mặt hàng và phiếu xuất nhập</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">MẶT HÀNG SỬ DỤNG</span>
                    <i class="bi bi-boxes text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary">@Model.TotalProductsMapped</div>
                <div class="small text-muted">Sản phẩm trong kho đã gắn đơn vị tính</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Tìm kiếm theo mã, tên đơn vị tính hoặc ghi chú quy cách..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="standardOnly" class="form-select form-select-sm">
                    <option value="">-- Phân loại chuẩn --</option>
                    <!option value="true" @(standardOnly == true ? "selected" : "")>Đơn vị cơ bản / chuẩn</!option>
                    <!option value="false" @(standardOnly == false ? "selected" : "")>Đơn vị quy đổi / thứ cấp</!option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Ngừng áp dụng</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/PartUnit" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Đơn vị tính -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th style="width: 140px;">Mã ĐVT</th>
                        <th>Tên đơn vị tính</th>
                        <th style="width: 170px;">Phân loại đơn vị</th>
                        <th>Ghi chú / Quy cách</th>
                        <th class="text-center" style="width: 130px;">Số mặt hàng</th>
                        <th class="text-end" style="width: 130px;">Tổng tồn kho</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy đơn vị tính nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@(stt++)</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">@row.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@row.Name</div>
                                    <div class="small text-muted">Ngày tạo: @row.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (row.IsStandard)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-shield-check me-1"></i>Đơn vị cơ bản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-arrow-repeat me-1"></i>Đơn vị quy đổi
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(row.Remark) ? "—" : row.Remark)</span>
                                </td>
                                <td class="text-center">
                                    @if (row.ProductCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-0" onclick="viewUnitProducts(@row.Id, '@row.Code', '@row.Name')">
                                            <i class="bi bi-box me-1"></i>@row.ProductCount sp
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">0 sp</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(row.TotalStockQty > 0 ? "text-dark" : "text-muted")">@row.TotalStockQty.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-dash-circle me-1"></i>Ngừng áp dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" title="Sửa thông tin" onclick="editUnit(@row.Id, '@row.Code', '@row.Name', @(row.IsStandard.ToString().ToLower()), '@(row.Remark?.Replace("'", "\\'") ?? "")', @(row.IsActive.ToString().ToLower()))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="Toggle" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái đơn vị tính @row.Code?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-@(row.IsActive ? "warning" : "success")" title="@(row.IsActive ? "Ngừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(row.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa đơn vị tính @row.Code? (Nếu đã có sản phẩm sẽ chuyển sang Ngừng áp dụng)');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa đơn vị tính">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Đơn vị tính -->
<div class="modal fade" id="createUnitModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Đơn vị tính mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã đơn vị tính (PartUnitCode)</label>
                        <input type="text" name="code" class="form-control font-monospace" placeholder="VD: CAI, HOP, THUNG, KG, MET... (để trống tự sinh)" />
                        <div class="form-text">Mã định danh viết hoa không dấu, duy nhất trong hệ thống kho.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên đơn vị tính (PartUnitName) <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="VD: Cái, Hộp, Thùng, Kilogram, Mét..." required />
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isStandard" id="createIsStandard" value="true" checked>
                        <label class="form-check-label fw-semibold small" for="createIsStandard">Là đơn vị cơ bản / đơn vị chuẩn (FlagUnitStd)</label>
                        <div class="form-text">Tắt nếu đây là đơn vị quy đổi / bao bì thứ cấp (thùng, cuộn, pallet...).</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú / Quy cách quy đổi (Remark)</label>
                        <textarea name="remark" class="form-control" rows="3" placeholder="Mô tả phạm vi sử dụng, quy cách đóng gói hoặc tỷ lệ quy đổi chuẩn..."></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="createIsActive" value="true" checked>
                        <label class="form-check-label fw-semibold small" for="createIsActive">Kích hoạt áp dụng ngay (FlagActive)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu đơn vị tính</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Đơn vị tính -->
<div class="modal fade" id="editUnitModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Update" id="editUnitForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editUnitId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật Đơn vị tính</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã đơn vị tính</label>
                        <input type="text" id="editUnitCode" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên đơn vị tính <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editUnitName" class="form-control" required />
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isStandard" id="editIsStandard" value="true">
                        <label class="form-check-label fw-semibold small" for="editIsStandard">Là đơn vị cơ bản / đơn vị chuẩn (FlagUnitStd)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú / Quy cách quy đổi</label>
                        <textarea name="remark" id="editUnitRemark" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editUnitIsActive" value="true">
                        <label class="form-check-label fw-semibold small" for="editUnitIsActive">Đang áp dụng (FlagActive)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem danh sách sản phẩm sử dụng đơn vị tính -->
<div class="modal fade" id="unitProductsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0"><i class="bi bi-boxes text-primary me-2"></i>Mặt hàng sử dụng đơn vị tính: <span id="modalUnitTitle" class="text-primary font-monospace"></span></h5>
                    <div class="text-muted small">Danh sách các mặt hàng trong kho đang thiết lập đơn vị tính này</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
                    <div>
                        <span class="fw-semibold">Tổng số mặt hàng:</span> <span id="modalTotalProducts" class="badge bg-primary">0</span>
                    </div>
                    <div>
                        <span class="fw-semibold">Tổng tồn kho vật lý:</span> <span id="modalTotalStock" class="badge bg-success">0</span>
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3" style="width: 50px;">STT</th>
                                <th style="width: 140px;">Mã hàng</th>
                                <th>Tên hàng</th>
                                <th style="width: 100px;">ĐVT</th>
                                <th style="width: 120px;">Loại SP</th>
                                <th class="text-end" style="width: 100px;">Tồn Min</th>
                                <th class="text-end" style="width: 100px;">Tồn Max</th>
                                <th class="text-end pe-3" style="width: 130px;">Giá vốn</th>
                            </tr>
                        </thead>
                        <tbody id="modalUnitProductsBody">
                            <tr><td colspan="8" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editUnit(id, code, name, isStandard, remark, isActive) {
        document.getElementById('editUnitId').value = id;
        document.getElementById('editUnitCode').value = code;
        document.getElementById('editUnitName').value = name;
        document.getElementById('editIsStandard').checked = !!isStandard;
        document.getElementById('editUnitRemark').value = remark || '';
        document.getElementById('editUnitIsActive').checked = !!isActive;
        document.getElementById('editUnitForm').action = '/PartUnit/Update/' + id;
        new bootstrap.Modal(document.getElementById('editUnitModal')).show();
    }

    async function viewUnitProducts(id, code, name) {
        document.getElementById('modalUnitTitle').textContent = name + ' (' + code + ')';
        document.getElementById('modalTotalProducts').textContent = '...';
        document.getElementById('modalTotalStock').textContent = '...';
        const tbody = document.getElementById('modalUnitProductsBody');
        tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</td></tr>';
        
        new bootstrap.Modal(document.getElementById('unitProductsModal')).show();

        try {
            const res = await fetch('/PartUnit/Detail/' + id);
            if (!res.ok) throw new Error('Không thể tải chi tiết');
            const data = await res.json();

            document.getElementById('modalTotalProducts').textContent = data.totalProducts;
            document.getElementById('modalTotalStock').textContent = Number(data.totalStockQty).toLocaleString();

            if (!data.products || data.products.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center py-4 text-muted">Chưa có mặt hàng nào sử dụng đơn vị tính này.</td></tr>';
                return;
            }

            let html = '';
            data.products.forEach((p, idx) => {
                const costPriceFormatted = Number(p.costPrice || 0).toLocaleString() + ' đ';
                const ptBadge = p.partTypeCode ? `<span class="badge bg-info-subtle text-info border border-info-subtle">${p.partTypeCode}</span>` : '—';
                html += `
                    <tr>
                        <td class="ps-3 text-muted">${idx + 1}</td>
                        <td class="fw-semibold font-monospace">${p.code}</td>
                        <td>${p.name}</td>
                        <td><span class="badge bg-light text-dark border font-monospace">${p.uom || ''}</span></td>
                        <td>${ptBadge}</td>
                        <td class="text-end text-muted">${p.minStock > 0 ? p.minStock : '—'}</td>
                        <td class="text-end text-muted">${p.maxStock > 0 ? p.maxStock : '—'}</td>
                        <td class="text-end pe-3 font-monospace">${costPriceFormatted}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Lỗi khi tải dữ liệu: ${err.message}</td></tr>`;
        }
    }
</script>
}
