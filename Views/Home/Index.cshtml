@{ ViewData["Title"] = "Bảng điều khiển"; var d = (WmsDash)ViewBag.Dash; }
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><div class="text-muted small">Kho</div><div class="stat-num">@d.Warehouses</div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><a href="/InventoryBlock" class="text-decoration-none text-dark"><div class="text-muted small">Vị trí kho (Ô/Kệ) <i class="bi bi-box-arrow-up-right ms-1"></i></div><div class="stat-num text-primary">@d.TotalBlocks</div></a></div></div></div>
    <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><div class="text-muted small">Mặt hàng</div><div class="stat-num">@d.Products</div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><div class="text-muted small">Tổng tồn</div><div class="stat-num" style="color:#0891b2">@d.TotalOnHand.ToString("N0")</div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><div class="text-muted small">Phiếu ghi sổ</div><div class="stat-num">@d.PostedDocs</div></div></div></div>
    <div class="col-6 col-lg-2"><div class="card"><div class="card-body"><a href="/StockMinimum" class="text-decoration-none"><div class="text-muted small">Dưới định mức <i class="bi bi-box-arrow-up-right ms-1"></i></div><div class="stat-num text-danger">@d.LowStock</div></a></div></div></div>
</div>
<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Tác vụ nhanh</h6>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/Doc/Create?type=0" class="btn btn-outline-primary"><i class="bi bi-box-arrow-in-down me-1"></i>Nhập kho</a>
        <a href="/Doc/Create?type=1" class="btn btn-outline-primary"><i class="bi bi-box-arrow-up me-1"></i>Xuất kho</a>
        <a href="/Doc/Create?type=2" class="btn btn-outline-primary"><i class="bi bi-arrow-left-right me-1"></i>Chuyển kho</a>
        <a href="/MoveOrder" class="btn btn-outline-primary"><i class="bi bi-shuffle me-1"></i>Lệnh điều chuyển</a>
        <a href="/ReturnSup" class="btn btn-outline-primary"><i class="bi bi-arrow-counterclockwise me-1"></i>Trả hàng NCC</a>
        <a href="/CustomerReturn" class="btn btn-outline-primary"><i class="bi bi-arrow-return-left me-1"></i>Khách trả hàng</a>
        <a href="/Audit" class="btn btn-outline-primary"><i class="bi bi-clipboard-check me-1"></i>Kiểm kê kho</a>
        <a href="/Inventory" class="btn btn-outline-primary"><i class="bi bi-clipboard-data me-1"></i>Xem tồn kho</a>
        <a href="/InventoryBlock" class="btn btn-outline-primary"><i class="bi bi-grid-3x3-gap me-1"></i>Vị trí kho (Ô/Kệ)</a>
        <a href="/StockMinimum" class="btn btn-outline-danger"><i class="bi bi-shield-exclamation me-1"></i>Cảnh báo tồn tối thiểu</a>
        <a href="/LotExpiry" class="btn btn-outline-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Lô & Hạn sử dụng</a>
        <a href="/StorageTime" class="btn btn-outline-info text-dark"><i class="bi bi-clock-history me-1"></i>Báo cáo tuổi kho</a>
        <a href="/StockSerial" class="btn btn-outline-primary"><i class="bi bi-upc-scan me-1"></i>Serial / IMEI</a>
        <a href="/CostPrice" class="btn btn-outline-success"><i class="bi bi-calculator me-1"></i>Giá vốn kho</a>
        <a href="/Carton" class="btn btn-outline-secondary"><i class="bi bi-box-seam-fill me-1"></i>Thùng carton / Đóng kiện</a>
        <a href="/InventoryInOut" class="btn btn-primary"><i class="bi bi-graph-up-arrow me-1"></i>Báo cáo NXT</a>
    </div>
    @if (d.DamagedSerials > 0) { <div class="alert alert-danger mt-3 mb-0 small"><i class="bi bi-exclamation-octagon me-1"></i>Có <b>@d.DamagedSerials</b> serial/sản phẩm báo lỗi hỏng (NG) cần thẩm định/bảo hành. <a href="/StockSerial?status=2" class="fw-semibold text-danger text-decoration-underline">Kiểm tra danh sách Serial NG ngay</a></div> }
    @if (d.ExpiringLots > 0) { <div class="alert alert-warning mt-2 mb-0 small"><i class="bi bi-alarm me-1"></i>Có <b>@d.ExpiringLots</b> lô hàng đã hết hạn hoặc cận hạn nguy cấp (&le; 30 ngày). <a href="/LotExpiry" class="fw-semibold text-dark text-decoration-underline">Kiểm tra hạn sử dụng ngay</a></div> }
    @if (d.StagnantItems > 0) { <div class="alert alert-danger mt-2 mb-0 small"><i class="bi bi-clock-history me-1"></i>Có <b>@d.StagnantItems</b> mặt hàng tồn kho lâu ngày (> 90 ngày) đọng vốn lưu động. <a href="/StorageTime?bracket=3" class="fw-semibold text-danger text-decoration-underline">Xem báo cáo tuổi kho ngay</a></div> }
    @if (d.LowStock > 0) { <div class="alert alert-danger mt-2 mb-0 small"><i class="bi bi-shield-exclamation me-1"></i>Có <b>@d.LowStock</b> mặt hàng đang chạm hoặc dưới định mức tồn tối thiểu. <a href="/StockMinimum" class="fw-semibold text-danger text-decoration-underline">Xem cảnh báo ngay</a></div> }
    @if (d.DraftDocs > 0) { <div class="alert alert-warning mt-3 mb-0 small"><i class="bi bi-hourglass-split me-1"></i>Có <b>@d.DraftDocs</b> phiếu Nháp chưa ghi sổ.</div> }
    @if (d.PendingAudits > 0) { <div class="alert alert-info mt-2 mb-0 small"><i class="bi bi-clipboard-check me-1"></i>Có <b>@d.PendingAudits</b> phiếu kiểm kê đang chờ xử lý / cân bằng kho. <a href="/Audit?status=0" class="fw-semibold">Xem ngay</a></div> }
    @if (d.PendingMoveOrders > 0) { <div class="alert alert-primary mt-2 mb-0 small"><i class="bi bi-shuffle me-1"></i>Có <b>@d.PendingMoveOrders</b> lệnh điều chuyển đang chờ duyệt / thực hiện. <a href="/MoveOrder" class="fw-semibold">Xem ngay</a></div> }
    @if (d.PendingReturns > 0) { <div class="alert alert-warning mt-2 mb-0 small"><i class="bi bi-arrow-counterclockwise me-1"></i>Có <b>@d.PendingReturns</b> phiếu xuất trả hàng NCC đang chờ duyệt & xuất kho. <a href="/ReturnSup?status=0" class="fw-semibold">Xem ngay</a></div> }
    @if (d.PendingCustomerReturns > 0) { <div class="alert alert-info mt-2 mb-0 small"><i class="bi bi-arrow-return-left me-1"></i>Có <b>@d.PendingCustomerReturns</b> phiếu khách hàng trả lại đang chờ nhận hàng & nhập kho. <a href="/CustomerReturn?status=0" class="fw-semibold">Xem ngay</a></div> }
</div></div>
