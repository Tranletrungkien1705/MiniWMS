@model InventoryInDtlReport
@{
    ViewData["Title"] = "Báo cáo Chi tiết Nhập kho";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var selectedWid = (int?)ViewBag.WarehouseId;
    var fromDate = (string)ViewBag.FromDate;
    var toDate = (string)ViewBag.ToDate;
    var inType = (string)ViewBag.InType;
    var keyword = (string)ViewBag.Keyword;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-box-arrow-in-down-right text-success me-2"></i>Báo cáo Tổng hợp Nhập kho Chi tiết</h5>
        <div class="text-muted small">Port từ <code>Rpt_InventoryInDtl</code> (Skycic) — Chi tiết từng dòng vật tư/thành phẩm nhập kho theo kỳ, loại nhập, hóa đơn, giá nhập và đối tác giao hàng</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/InventoryInDtl/ExportCsv?warehouseId=@selectedWid&fromDate=@fromDate&toDate=@toDate&inType=@Uri.EscapeDataString(inType ?? "")&q=@Uri.EscapeDataString(keyword ?? "")" 
           class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark">
            <i class="bi bi-printer me-1"></i> In báo cáo
        </button>
        <a href="/Doc/Create?type=0" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-box-arrow-in-down me-1"></i> Nhập kho mới
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card mb-3 border-0 shadow-sm">
    <div class="card-body py-3">
        <form method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Kho nhập hàng</label>
                <select name="warehouseId" class="form-select form-select-sm">
                    <option value="">— Tất cả kho —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Hình thức nhập</label>
                <select name="inType" class="form-select form-select-sm">
                    <option value="">— Tất cả hình thức nhập —</option>
                    <option value="COMMERCIAL" selected="@(inType == "COMMERCIAL")">Nhập mua NCC / Thương mại</option>
                    <option value="IN_FG" selected="@(inType == "IN_FG")">Nhập thành phẩm sản xuất (KCS)</option>
                    <option value="CUS_RETURN" selected="@(inType == "CUS_RETURN")">Nhập khách hàng trả lại</option>
                    <option value="TRANSFER" selected="@(inType == "TRANSFER")">Nhập điều chuyển kho đến</option>
                    <option value="AUDIT_DIFF" selected="@(inType == "AUDIT_DIFF")">Nhập cân bằng thừa kiểm kê</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Từ ngày <span class="text-danger">*</span></label>
                <input type="date" id="inputFromDate" name="fromDate" value="@fromDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Đến ngày <span class="text-danger">*</span></label>
                <input type="date" id="inputToDate" name="toDate" value="@toDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
                <a href="/InventoryInDtl" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
            <div class="col-md-6 mt-2">
                <input type="text" name="q" value="@keyword" placeholder="Tìm theo số phiếu, số hóa đơn, mã hàng, tên hàng, nhà cung cấp, RefNo..." class="form-control form-control-sm" />
            </div>
            <div class="col-md-6 mt-2 d-flex gap-2 align-items-center justify-content-md-end flex-wrap">
                <span class="small text-muted me-1">Kỳ nhanh:</span>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('today')">Hôm nay</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('last7days')">7 ngày qua</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('thisMonth')">Tháng này</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('lastMonth')">Tháng trước</button>
            </div>
        </form>
    </div>
</div>

<!-- 4 Thẻ KPI -->
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Lượt phiếu nhập</span>
                    <i class="bi bi-journals text-primary fs-5"></i>
                </div>
                <div class="stat-num text-primary">@Model.TotalDocsCount.ToString("N0")</div>
                <div class="text-muted small">Phiếu nhập ghi sổ trong kỳ</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng lượng nhập</span>
                    <i class="bi bi-box-seam text-success fs-5"></i>
                </div>
                <div class="stat-num text-success">@Model.TotalQty.ToString("N0")</div>
                <div class="text-muted small">Đơn vị sản phẩm / kiện</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Tổng tiền nhập kho</span>
                    <i class="bi bi-cash-stack text-danger fs-5"></i>
                </div>
                <div class="stat-num text-danger">@Model.TotalAmount.ToString("N0") <span class="fs-6 fw-normal text-muted">đ</span></div>
                <div class="text-muted small">Trước thuế: @Model.TotalBeforeTax.ToString("N0") đ · VAT: @Model.TotalTaxAmount.ToString("N0") đ</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold text-uppercase">Mặt hàng & Đối tác</span>
                    <i class="bi bi-tags text-warning fs-5"></i>
                </div>
                <div class="stat-num text-warning">@Model.DistinctProductsCount <span class="fs-6 fw-normal text-muted">SP</span> · @Model.DistinctSuppliersCount <span class="fs-6 fw-normal text-muted">NCC</span></div>
                <div class="text-muted small">Mặt hàng & nguồn cung phân biệt</div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng dữ liệu chi tiết nhập kho -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
        <div class="fw-semibold text-dark small text-uppercase">
            <i class="bi bi-table me-1 text-primary"></i> Danh sách dòng hàng nhập kho (@Model.Items.Count dòng)
        </div>
        <div class="small text-muted">
            Kỳ báo cáo: <strong class="text-dark">@Model.FromDate.ToString("dd/MM/yyyy")</strong> đến <strong class="text-dark">@Model.ToDate.ToString("dd/MM/yyyy")</strong>
            @if (Model.WarehouseId.HasValue)
            {
                <span class="ms-1">| Kho: <strong class="text-dark">@Model.WarehouseName</strong></span>
            }
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0 font-sans" id="tblInDtl" style="font-size:12.5px;">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:40px">STT</th>
                    <th>Số phiếu</th>
                    <th>Ngày nhập</th>
                    <th>Loại hình nhập</th>
                    <th>Số HĐ / Ký hiệu</th>
                    <th>RefNo / Lệnh gốc</th>
                    <th>Kho nhập</th>
                    <th>Vị trí (Kệ/Ô)</th>
                    <th>Nhà cung cấp / Đối tác</th>
                    <th>Mã hàng</th>
                    <th>Tên hàng hóa</th>
                    <th class="text-center">ĐVT</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Đơn giá (UPIn)</th>
                    <th class="text-center">VAT</th>
                    <th class="text-end">Tiền trước thuế</th>
                    <th class="text-end">Tiền VAT</th>
                    <th class="text-end">Tổng tiền (đ)</th>
                    <th>Người lập</th>
                </tr>
                @if (Model.Items.Count > 0)
                {
                    <tr class="table-warning fw-bold text-dark border-bottom-2">
                        <td colspan="12" class="text-end text-uppercase small">Tổng cộng toàn kỳ (@Model.Items.Count dòng):</td>
                        <td class="text-end font-monospace text-primary">@Model.TotalQty.ToString("N0")</td>
                        <td class="text-end text-muted">—</td>
                        <td class="text-center text-muted">—</td>
                        <td class="text-end font-monospace">@Model.TotalBeforeTax.ToString("N0")</td>
                        <td class="text-end font-monospace text-muted">@Model.TotalTaxAmount.ToString("N0")</td>
                        <td class="text-end font-monospace text-danger">@Model.TotalAmount.ToString("N0")</td>
                        <td></td>
                    </tr>
                }
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="19" class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            Không có phát sinh nhập kho nào thỏa mãn điều kiện lọc.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var item in Model.Items)
                    {
                        var badgeClass = item.InType switch
                        {
                            "COMMERCIAL" => "bg-primary",
                            "IN_FG" => "bg-success",
                            "CUS_RETURN" => "bg-warning text-dark",
                            "TRANSFER" => "bg-info text-dark",
                            "AUDIT_DIFF" => "bg-secondary",
                            _ => "bg-dark"
                        };

                        <tr>
                            <td class="text-center text-muted small">@stt</td>
                            <td class="font-monospace fw-semibold">
                                @if (!string.IsNullOrEmpty(item.DocUrl))
                                {
                                    <a href="@item.DocUrl" class="text-decoration-none fw-bold" title="Xem chi tiết chứng từ">@item.DocNo</a>
                                }
                                else
                                {
                                    <span>@item.DocNo</span>
                                }
                            </td>
                            <td class="small text-nowrap">@item.DocDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge @badgeClass fw-normal">@item.InTypeName</span>
                            </td>
                            <td class="small font-monospace">
                                @(string.IsNullOrWhiteSpace(item.InvoiceNo) ? "—" : item.InvoiceNo)
                                @if (item.InvoiceDate.HasValue)
                                {
                                    <div class="text-muted" style="font-size:10px">@item.InvoiceDate.Value.ToString("dd/MM/yyyy")</div>
                                }
                            </td>
                            <td class="small font-monospace text-muted">
                                @(string.IsNullOrWhiteSpace(item.RefNo) ? "—" : item.RefNo)
                                @if (!string.IsNullOrWhiteSpace(item.RefType))
                                {
                                    <div class="text-muted" style="font-size:10px">@item.RefType</div>
                                }
                            </td>
                            <td class="small fw-semibold text-dark">@item.WarehouseName</td>
                            <td class="small font-monospace text-muted">
                                @(string.IsNullOrWhiteSpace(item.LocationCode) ? "—" : item.LocationCode)
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.SupplierName</div>
                                @if (!string.IsNullOrWhiteSpace(item.SupplierCode))
                                {
                                    <span class="badge bg-light text-secondary border font-monospace" style="font-size:10px">@item.SupplierCode</span>
                                }
                            </td>
                            <td class="font-monospace fw-semibold text-primary">@item.ProductCode</td>
                            <td class="fw-semibold text-dark">
                                @item.ProductName
                                @if (!string.IsNullOrWhiteSpace(item.Note))
                                {
                                    <div class="text-muted small fw-normal" style="font-size:11px"><em>@item.Note</em></div>
                                }
                            </td>
                            <td class="text-center text-muted small">@item.UnitName</td>
                            <td class="text-end font-monospace fw-bold text-dark">@item.Quantity.ToString("N0")</td>
                            <td class="text-end font-monospace text-muted">@item.UnitPrice.ToString("N0")</td>
                            <td class="text-center font-monospace small">@(item.VatPercent > 0 ? $"{item.VatPercent:F0}%" : "0%")</td>
                            <td class="text-end font-monospace">@item.ValBeforeTax.ToString("N0")</td>
                            <td class="text-end font-monospace text-muted">@item.ValTax.ToString("N0")</td>
                            <td class="text-end font-monospace fw-bold text-danger">@item.TotalAmount.ToString("N0")</td>
                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(item.CreatedBy) ? "—" : item.CreatedBy)</td>
                        </tr>
                        stt++;
                    }
                }
            </tbody>
            @if (Model.Items.Count > 0)
            {
                <tfoot class="table-light">
                    <tr class="fw-bold text-dark">
                        <td colspan="12" class="text-end text-uppercase small">Tổng cộng cuối trang:</td>
                        <td class="text-end font-monospace text-primary">@Model.TotalQty.ToString("N0")</td>
                        <td class="text-end text-muted">—</td>
                        <td class="text-center text-muted">—</td>
                        <td class="text-end font-monospace">@Model.TotalBeforeTax.ToString("N0")</td>
                        <td class="text-end font-monospace text-muted">@Model.TotalTaxAmount.ToString("N0")</td>
                        <td class="text-end font-monospace text-danger">@Model.TotalAmount.ToString("N0")</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

@section Scripts {
<script>
    function setPeriod(p) {
        const today = new Date();
        const pad = n => n.toString().padStart(2, '0');
        const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;

        let from, to = today;

        if (p === 'today') {
            from = today;
        } else if (p === 'last7days') {
            from = new Date();
            from.setDate(today.getDate() - 6);
        } else if (p === 'thisMonth') {
            from = new Date(today.getFullYear(), today.getMonth(), 1);
        } else if (p === 'lastMonth') {
            from = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            to = new Date(today.getFullYear(), today.getMonth(), 0);
        }

        if (from) document.getElementById('inputFromDate').value = fmt(from);
        if (to) document.getElementById('inputToDate').value = fmt(to);

        document.getElementById('filterForm').submit();
    }
</script>
}
