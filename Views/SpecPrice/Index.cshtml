@model SpecPriceReport
@{
    ViewData["Title"] = "Bảng giá quy cách sản phẩm";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var specCodeFilter = (string)(ViewBag.SpecCode ?? "");
    var unitCodeFilter = (string)(ViewBag.UnitCode ?? "");
    var currencyCodeFilter = (string)(ViewBag.CurrencyCode ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
    var specs = ViewBag.Specs as List<ProductSpec> ?? [];
    var units = ViewBag.Units as List<PartUnit> ?? [];
    var currencies = ViewBag.Currencies as List<CurrencyExchange> ?? [];
    var vatRates = ViewBag.VATRates as List<VATRate> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-tag-fill text-primary me-2"></i>Quản lý Bảng giá Quy cách Sản phẩm Kho</h5>
        <div class="text-muted small">Port từ <code>OS_PrdCenter_Mst_SpecPrice</code> / <code>Mst_SpecPrice</code> (Skycic) — Thiết lập và theo dõi giá mua dự kiến, giá bán niêm yết theo từng Quy cách sản phẩm &amp; Đơn vị tính, quản lý đa ngoại tệ, thuế suất VAT, chiết khấu định mức và tính toán tỷ suất biên lợi nhuận gộp</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/SpecPrice/ExportCsv?q=@keyword&specCode=@specCodeFilter&unitCode=@unitCodeFilter&currencyCode=@currencyCodeFilter&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In bảng giá
        </button>
        <a href="/ProductSpec" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-card-checklist me-1"></i> Quy cách SP
        </a>
        <a href="/CurrencyEx" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-currency-exchange me-1"></i> Ngoại tệ
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createSpecPriceModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Bảng giá
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG BẢNG GIÁ</span>
                    <i class="bi bi-tags text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalPrices</div>
                <div class="small text-muted">Bảng giá quy cách đã thiết lập</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG HIỆU LỰC</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Sẵn sàng áp dụng cho xuất nhập kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">BẢNG GIÁ NGOẠI TỆ</span>
                    <i class="bi bi-globe text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-info">@Model.ForeignCurrencyCount</div>
                <div class="small text-muted">Bảng giá theo USD, EUR, ngoại tệ</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">GIÁ BÁN BÌNH QUÂN (VND)</span>
                    <i class="bi bi-cash-stack text-warning fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-warning">@Model.AverageSellPrice.ToString("N0") <small class="fs-6 text-muted">₫</small></div>
                <div class="small text-muted">Giá niêm yết bình quân kho</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" action="/SpecPrice" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control form-control-sm border-start-0" placeholder="Tìm mã quy cách, ĐVT, ghi chú..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="specCode" class="form-select form-select-sm">
                    <option value="">-- Tất cả Quy cách SP --</option>
                    @foreach (var s in specs)
                    {
                        <!option value="@s.Code" @(s.Code.Equals(specCodeFilter, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@s.Code - @s.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="unitCode" class="form-select form-select-sm">
                    <option value="">-- Tất cả ĐVT --</option>
                    @foreach (var u in units)
                    {
                        <!option value="@u.Code" @(u.Code.Equals(unitCodeFilter, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@u.Name (@u.Code)</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="currencyCode" class="form-select form-select-sm">
                    <option value="">-- Tất cả Ngoại tệ --</option>
                    @foreach (var c in currencies)
                    {
                        <!option value="@c.Code" @(c.Code.Equals(currencyCodeFilter, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@c.Code (@(c.Symbol ?? c.Code))</!option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">Tất cả</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Tạm dừng</!option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary w-100">Lọc</button>
                @if (!string.IsNullOrEmpty(keyword) || !string.IsNullOrEmpty(specCodeFilter) || !string.IsNullOrEmpty(unitCodeFilter) || !string.IsNullOrEmpty(currencyCodeFilter) || activeOnly.HasValue)
                {
                    <a href="/SpecPrice" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc"><i class="bi bi-x"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu danh sách Bảng giá quy cách -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 13px;">
                <thead class="table-light">
                    <tr>
                        <th class="text-center ps-3" style="width: 45px;">STT</th>
                        <th style="min-width: 200px;">Quy cách sản phẩm</th>
                        <th class="text-center" style="width: 80px;">ĐVT</th>
                        <th class="text-end" style="min-width: 110px;">Giá mua / Vốn</th>
                        <th class="text-end" style="min-width: 120px;">Giá niêm yết</th>
                        <th class="text-end" style="min-width: 100px;">Chiết khấu</th>
                        <th class="text-end" style="min-width: 120px;">Giá ròng (Net)</th>
                        <th class="text-center" style="min-width: 90px;">Biên LN %</th>
                        <th class="text-center" style="width: 85px;">Loại tiền</th>
                        <th class="text-center" style="width: 85px;">VAT</th>
                        <th class="text-center" style="min-width: 110px;">Hiệu lực</th>
                        <th class="text-center" style="width: 110px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="13" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                Chưa có bảng giá quy cách sản phẩm nào phù hợp với điều kiện lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var r in Model.Rows)
                        {
                            var curSymbol = r.CurrencySymbol ?? r.CurrencyCode;
                            var isForeign = !r.CurrencyCode.Equals("VND", StringComparison.OrdinalIgnoreCase);
                            var priceFormat = isForeign ? "N2" : "N0";

                            <tr>
                                <td class="text-center ps-3 text-muted">@(stt++)</td>
                                <td>
                                    <div class="fw-bold text-dark">
                                        <a href="javascript:void(0)" onclick="showPriceDetail(@r.Id)" class="text-decoration-none">
                                            @r.SpecCode
                                        </a>
                                    </div>
                                    <div class="text-muted small">
                                        @(r.SpecName ?? "—")
                                        @if (!string.IsNullOrEmpty(r.Color))
                                        {
                                            <span class="badge bg-light text-secondary border ms-1">@r.Color</span>
                                        }
                                        @if (!string.IsNullOrEmpty(r.ModelName ?? r.ModelCode))
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-dark ms-1">@(r.ModelName ?? r.ModelCode)</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(r.Remark))
                                    {
                                        <div class="text-secondary small fst-italic text-truncate" style="max-width: 280px;" title="@r.Remark">
                                            <i class="bi bi-info-circle me-1"></i>@r.Remark
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@r.UnitCode</span>
                                </td>
                                <td class="text-end">
                                    <span class="text-secondary">@r.BuyPrice.ToString(priceFormat)</span>
                                    <small class="text-muted">@curSymbol</small>
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold text-primary">@r.SellPrice.ToString(priceFormat)</span>
                                    <small class="text-muted">@curSymbol</small>
                                </td>
                                <td class="text-end">
                                    @if (r.DiscountVND > 0)
                                    {
                                        <span class="text-danger">-@r.DiscountVND.ToString(priceFormat)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold text-success">@r.NetSellPrice.ToString(priceFormat)</span>
                                    <small class="text-muted">@curSymbol</small>
                                </td>
                                <td class="text-center">
                                    @if (r.GrossMarginPercent >= 30)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success" title="Lợi nhuận gộp: @r.GrossProfit.ToString(priceFormat) @curSymbol">
                                            +@r.GrossMarginPercent.ToString("F1")%
                                        </span>
                                    }
                                    else if (r.GrossMarginPercent >= 15)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary" title="Lợi nhuận gộp: @r.GrossProfit.ToString(priceFormat) @curSymbol">
                                            +@r.GrossMarginPercent.ToString("F1")%
                                        </span>
                                    }
                                    else if (r.GrossMarginPercent > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning" title="Lợi nhuận gộp: @r.GrossProfit.ToString(priceFormat) @curSymbol">
                                            +@r.GrossMarginPercent.ToString("F1")%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                            @r.GrossMarginPercent.ToString("F1")%
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(isForeign ? "bg-info text-white" : "bg-light text-dark border")">
                                        @r.CurrencyCode
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-secondary border">
                                        @(r.VATRateCode ?? "VAT10")
                                    </span>
                                </td>
                                <td class="text-center small text-muted">
                                    <div>@r.EffectDTimeStart.ToString("dd/MM/yyyy")</div>
                                    @if (r.EffectDTimeEnd.HasValue)
                                    {
                                        <div class="text-danger small">đến @r.EffectDTimeEnd.Value.ToString("dd/MM/yyyy")</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Đang áp dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-info" title="Xem chi tiết & quy đổi ngoại tệ" onclick="showPriceDetail(@r.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" title="Sửa bảng giá" onclick="openEditPriceModal(@r.Id, '@r.SpecCode', '@r.UnitCode', @r.BuyPrice, @r.SellPrice, @r.DiscountVND, '@r.CurrencyCode', '@(r.VATRateCode ?? "VAT10")', '@r.EffectDTimeStart.ToString("yyyy-MM-dd")', '@(r.EffectDTimeEnd.HasValue ? r.EffectDTimeEnd.Value.ToString("yyyy-MM-dd") : "")', @(r.IsActive ? "true" : "false"), '@Html.Raw(Html.Encode(r.Remark ?? ""))')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" action="/SpecPrice/ToggleStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-@(r.IsActive ? "warning" : "success")" title="@(r.IsActive ? "Tạm dừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(r.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="/SpecPrice/Delete" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bảng giá quy cách \'@r.SpecCode\' (@r.UnitCode)?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa bảng giá">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Bảng giá quy cách -->
<div class="modal fade" id="createSpecPriceModal" tabindex="-1" aria-labelledby="createSpecPriceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/SpecPrice/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createSpecPriceModalLabel"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm mới Bảng giá Quy cách Sản phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Quy cách sản phẩm <span class="text-danger">*</span></label>
                            <select name="specCode" id="create_specCode" class="form-select form-select-sm" required onchange="onSpecSelectChange(this)">
                                <option value="">-- Chọn quy cách kỹ thuật --</option>
                                @foreach (var s in specs)
                                {
                                    <option value="@s.Code" data-unit="@(s.StandardUnitCode ?? "cái")" data-name="@s.Name">@s.Code — @s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đơn vị tính <span class="text-danger">*</span></label>
                            <input type="text" name="unitCode" id="create_unitCode" class="form-control form-control-sm" list="unitList" placeholder="vd: cái, hộp, thùng..." required />
                            <datalist id="unitList">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Code">@u.Name</option>
                                }
                            </datalist>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá mua / Giá vốn dự kiến</label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" name="buyPrice" id="create_buyPrice" class="form-control form-control-sm text-end" value="0" required oninput="calcCreatePreview()" />
                                <span class="input-group-text currencyLabel">VND</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá bán niêm yết <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" name="sellPrice" id="create_sellPrice" class="form-control form-control-sm text-end" value="0" required oninput="calcCreatePreview()" />
                                <span class="input-group-text currencyLabel">VND</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Chiết khấu định mức</label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" name="discountVND" id="create_discountVND" class="form-control form-control-sm text-end" value="0" oninput="calcCreatePreview()" />
                                <span class="input-group-text currencyLabel">VND</span>
                            </div>
                        </div>

                        <!-- Hộp tính toán xem trước lợi nhuận -->
                        <div class="col-12">
                            <div class="p-2 rounded bg-light border d-flex justify-content-around text-center small">
                                <div>
                                    <span class="text-muted d-block">Giá bán sau chiết khấu (Net):</span>
                                    <span id="create_previewNet" class="fw-bold text-success fs-6">0</span>
                                </div>
                                <div class="border-start ps-3">
                                    <span class="text-muted d-block">Lợi nhuận gộp định mức:</span>
                                    <span id="create_previewProfit" class="fw-bold text-primary fs-6">0</span>
                                </div>
                                <div class="border-start ps-3">
                                    <span class="text-muted d-block">Tỷ suất biên lợi nhuận %:</span>
                                    <span id="create_previewMargin" class="fw-bold fs-6">0.0%</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Loại tiền tệ</label>
                            <select name="currencyCode" id="create_currencyCode" class="form-select form-select-sm" onchange="updateCurrencyLabels(this.value)">
                                @foreach (var c in currencies)
                                {
                                    <!option value="@c.Code" @(c.Code.Equals("VND", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@c.Code — @c.Name (@(c.Symbol ?? c.Code))</!option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Thuế suất VAT</label>
                            <select name="vatRateCode" class="form-select form-select-sm">
                                @if (vatRates.Count > 0)
                                {
                                    foreach (var vr in vatRates)
                                    {
                                        <!option value="@vr.VATRateCode" @(vr.VATRateCode == "VAT10" ? "selected" : "")>@vr.VATRateCode - @vr.Rate.ToString("F1")% (@vr.VATDesc)</!option>
                                    }
                                }
                                else
                                {
                                    <option value="VAT10" selected>VAT 10% (Thuế GTGT 10%)</option>
                                    <option value="VAT8">VAT 8% (Thuế GTGT 8%)</option>
                                    <option value="VAT5">VAT 5% (Thuế GTGT 5%)</option>
                                    <option value="VAT0">VAT 0% (Thuế suất 0% xuất khẩu)</option>
                                    <option value="KCT">KCT (Không chịu thuế)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Hiệu lực từ ngày</label>
                            <input type="date" name="effectDTimeStart" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Hiệu lực đến ngày (tùy chọn)</label>
                            <input type="date" name="effectDTimeEnd" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Ghi chú / Kênh &amp; Phân khúc áp dụng</label>
                            <input type="text" name="remark" class="form-control form-control-sm" placeholder="vd: Áp dụng đại lý cấp 1 toàn quốc, xuất khẩu FOB..." />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="create_isActive" checked>
                                <label class="form-check-label small fw-semibold" for="create_isActive">Kích hoạt áp dụng bảng giá ngay</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Lưu bảng giá</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Bảng giá quy cách -->
<div class="modal fade" id="editSpecPriceModal" tabindex="-1" aria-labelledby="editSpecPriceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/SpecPrice/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit_id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editSpecPriceModalLabel"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật Bảng giá Quy cách</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Quy cách sản phẩm</label>
                            <input type="text" id="edit_specCodeDisplay" class="form-control form-control-sm bg-light" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đơn vị tính</label>
                            <input type="text" id="edit_unitCodeDisplay" class="form-control form-control-sm bg-light" readonly />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá mua / Giá vốn</label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" name="buyPrice" id="edit_buyPrice" class="form-control form-control-sm text-end" required oninput="calcEditPreview()" />
                                <span class="input-group-text editCurrencyLabel">VND</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá bán niêm yết <span class="text-danger">*</span></label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" name="sellPrice" id="edit_sellPrice" class="form-control form-control-sm text-end" required oninput="calcEditPreview()" />
                                <span class="input-group-text editCurrencyLabel">VND</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Chiết khấu định mức</label>
                            <div class="input-group input-group-sm">
                                <input type="number" step="any" name="discountVND" id="edit_discountVND" class="form-control form-control-sm text-end" oninput="calcEditPreview()" />
                                <span class="input-group-text editCurrencyLabel">VND</span>
                            </div>
                        </div>

                        <!-- Hộp tính toán xem trước lợi nhuận -->
                        <div class="col-12">
                            <div class="p-2 rounded bg-light border d-flex justify-content-around text-center small">
                                <div>
                                    <span class="text-muted d-block">Giá bán sau chiết khấu (Net):</span>
                                    <span id="edit_previewNet" class="fw-bold text-success fs-6">0</span>
                                </div>
                                <div class="border-start ps-3">
                                    <span class="text-muted d-block">Lợi nhuận gộp định mức:</span>
                                    <span id="edit_previewProfit" class="fw-bold text-primary fs-6">0</span>
                                </div>
                                <div class="border-start ps-3">
                                    <span class="text-muted d-block">Tỷ suất biên lợi nhuận %:</span>
                                    <span id="edit_previewMargin" class="fw-bold fs-6">0.0%</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Loại tiền tệ</label>
                            <select name="currencyCode" id="edit_currencyCode" class="form-select form-select-sm" onchange="updateEditCurrencyLabels(this.value)">
                                @foreach (var c in currencies)
                                {
                                    <option value="@c.Code">@c.Code — @c.Name (@(c.Symbol ?? c.Code))</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Thuế suất VAT</label>
                            <select name="vatRateCode" id="edit_vatRateCode" class="form-select form-select-sm">
                                @if (vatRates.Count > 0)
                                {
                                    foreach (var vr in vatRates)
                                    {
                                        <option value="@vr.VATRateCode">@vr.VATRateCode - @vr.Rate.ToString("F1")% (@vr.VATDesc)</option>
                                    }
                                }
                                else
                                {
                                    <option value="VAT10">VAT 10% (Thuế GTGT 10%)</option>
                                    <option value="VAT8">VAT 8% (Thuế GTGT 8%)</option>
                                    <option value="VAT5">VAT 5% (Thuế GTGT 5%)</option>
                                    <option value="VAT0">VAT 0% (Thuế suất 0% xuất khẩu)</option>
                                    <option value="KCT">KCT (Không chịu thuế)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Hiệu lực từ ngày</label>
                            <input type="date" name="effectDTimeStart" id="edit_effectDTimeStart" class="form-control form-control-sm" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Hiệu lực đến ngày</label>
                            <input type="date" name="effectDTimeEnd" id="edit_effectDTimeEnd" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Ghi chú / Kênh &amp; Phân khúc</label>
                            <input type="text" name="remark" id="edit_remark" class="form-control form-control-sm" />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" name="isActive" value="true" id="edit_isActive">
                                <label class="form-check-label small fw-semibold" for="edit_isActive">Đang áp dụng</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem Chi tiết & Bảng Định giá Ngoại tệ -->
<div class="modal fade" id="detailSpecPriceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"><i class="bi bi-info-circle text-primary me-2"></i>Chi tiết Bảng giá &amp; Định giá Ngoại tệ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailModalBody">
                <div class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-1"></i> Đang tải dữ liệu...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    function updateCurrencyLabels(code) {
        document.querySelectorAll('.currencyLabel').forEach(el => el.textContent = code);
        calcCreatePreview();
    }

    function updateEditCurrencyLabels(code) {
        document.querySelectorAll('.editCurrencyLabel').forEach(el => el.textContent = code);
        calcEditPreview();
    }

    function onSpecSelectChange(sel) {
        const opt = sel.options[sel.selectedIndex];
        if (opt && opt.dataset.unit) {
            document.getElementById('create_unitCode').value = opt.dataset.unit;
        }
    }

    function calcCreatePreview() {
        const buy = parseFloat(document.getElementById('create_buyPrice').value) || 0;
        const sell = parseFloat(document.getElementById('create_sellPrice').value) || 0;
        const disc = parseFloat(document.getElementById('create_discountVND').value) || 0;
        const cur = document.getElementById('create_currencyCode').value;

        const net = Math.max(0, sell - disc);
        const profit = net - buy;
        const margin = net > 0 ? (profit / net * 100).toFixed(1) : "0.0";

        document.getElementById('create_previewNet').textContent = net.toLocaleString('en-US', { minimumFractionDigits: cur === 'VND' ? 0 : 2 }) + ' ' + cur;
        document.getElementById('create_previewProfit').textContent = profit.toLocaleString('en-US', { minimumFractionDigits: cur === 'VND' ? 0 : 2 }) + ' ' + cur;
        
        const marginEl = document.getElementById('create_previewMargin');
        marginEl.textContent = (profit >= 0 ? '+' : '') + margin + '%';
        marginEl.className = profit >= 0 ? 'fw-bold text-success fs-6' : 'fw-bold text-danger fs-6';
    }

    function calcEditPreview() {
        const buy = parseFloat(document.getElementById('edit_buyPrice').value) || 0;
        const sell = parseFloat(document.getElementById('edit_sellPrice').value) || 0;
        const disc = parseFloat(document.getElementById('edit_discountVND').value) || 0;
        const cur = document.getElementById('edit_currencyCode').value;

        const net = Math.max(0, sell - disc);
        const profit = net - buy;
        const margin = net > 0 ? (profit / net * 100).toFixed(1) : "0.0";

        document.getElementById('edit_previewNet').textContent = net.toLocaleString('en-US', { minimumFractionDigits: cur === 'VND' ? 0 : 2 }) + ' ' + cur;
        document.getElementById('edit_previewProfit').textContent = profit.toLocaleString('en-US', { minimumFractionDigits: cur === 'VND' ? 0 : 2 }) + ' ' + cur;
        
        const marginEl = document.getElementById('edit_previewMargin');
        marginEl.textContent = (profit >= 0 ? '+' : '') + margin + '%';
        marginEl.className = profit >= 0 ? 'fw-bold text-success fs-6' : 'fw-bold text-danger fs-6';
    }

    function openEditPriceModal(id, specCode, unitCode, buyPrice, sellPrice, discountVND, currencyCode, vatRateCode, startDate, endDate, isActive, remark) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_specCodeDisplay').value = specCode;
        document.getElementById('edit_unitCodeDisplay').value = unitCode;
        document.getElementById('edit_buyPrice').value = buyPrice;
        document.getElementById('edit_sellPrice').value = sellPrice;
        document.getElementById('edit_discountVND').value = discountVND;
        document.getElementById('edit_currencyCode').value = currencyCode;
        document.getElementById('edit_vatRateCode').value = vatRateCode || "VAT10";
        document.getElementById('edit_effectDTimeStart').value = startDate;
        document.getElementById('edit_effectDTimeEnd').value = endDate || '';
        document.getElementById('edit_isActive').checked = isActive;
        document.getElementById('edit_remark').value = remark || '';

        updateEditCurrencyLabels(currencyCode);
        calcEditPreview();

        new bootstrap.Modal(document.getElementById('editSpecPriceModal')).show();
    }

    async function showPriceDetail(id) {
        const modal = new bootstrap.Modal(document.getElementById('detailSpecPriceModal'));
        modal.show();

        const body = document.getElementById('detailModalBody');
        body.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-1"></i> Đang tải dữ liệu...</div>';

        try {
            const res = await fetch('/SpecPrice/Detail?id=' + id);
            if (!res.ok) throw new Error('Không thể tải dữ liệu chi tiết.');
            const data = await res.json();
            const it = data.item;
            const sp = data.spec;
            const cur = data.currency;
            const vals = data.valuations || [];

            const isVnd = it.currencyCode.toUpperCase() === 'VND';
            const priceDec = isVnd ? 0 : 2;

            let valRows = '';
            vals.forEach(v => {
                const isBase = v.currencyCode === 'VND';
                const dec = isBase ? 0 : 2;
                valRows += `
                    <tr>
                        <td class="fw-bold">${v.currencyCode} <span class="badge bg-light text-secondary border">${v.symbol}</span></td>
                        <td>${v.currencyName}</td>
                        <td class="text-end">${v.buyPriceInCurrency.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec })} ${v.symbol}</td>
                        <td class="text-end fw-bold text-primary">${v.sellPriceInCurrency.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec })} ${v.symbol}</td>
                        <td class="text-end fw-bold text-success">${v.netPriceInCurrency.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec })} ${v.symbol}</td>
                        <td class="text-end text-muted small">${v.appliedRate.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 4 })}</td>
                    </tr>
                `;
            });

            body.innerHTML = `
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border">
                            <h6 class="fw-bold text-primary mb-2"><i class="bi bi-card-checklist me-1"></i> Thông tin Quy cách</h6>
                            <table class="table table-sm table-borderless mb-0 small">
                                <tr><th style="width:130px;" class="text-muted">Mã quy cách:</th><td class="fw-bold">${it.specCode}</td></tr>
                                <tr><th class="text-muted">Tên quy cách:</th><td>${sp ? sp.name : '—'}</td></tr>
                                <tr><th class="text-muted">Dòng Model:</th><td>${sp && sp.modelCode ? sp.modelCode : '—'}</td></tr>
                                <tr><th class="text-muted">Màu sắc:</th><td>${sp && sp.color ? sp.color : '—'}</td></tr>
                                <tr><th class="text-muted">Đơn vị tính:</th><td><span class="badge bg-light text-dark border">${it.unitCode}</span></td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded border">
                            <h6 class="fw-bold text-success mb-2"><i class="bi bi-cash-coin me-1"></i> Chính sách Giá niêm yết</h6>
                            <table class="table table-sm table-borderless mb-0 small">
                                <tr><th style="width:130px;" class="text-muted">Giá mua / vốn:</th><td class="fw-bold">${it.buyPrice.toLocaleString('en-US', { minimumFractionDigits: priceDec })} ${it.currencyCode}</td></tr>
                                <tr><th class="text-muted">Giá bán niêm yết:</th><td class="fw-bold text-primary fs-6">${it.sellPrice.toLocaleString('en-US', { minimumFractionDigits: priceDec })} ${it.currencyCode}</td></tr>
                                <tr><th class="text-muted">Chiết khấu:</th><td class="text-danger">-${it.discountVND.toLocaleString('en-US', { minimumFractionDigits: priceDec })} ${it.currencyCode}</td></tr>
                                <tr><th class="text-muted">Giá ròng sau CK:</th><td class="fw-bold text-success fs-6">${(it.sellPrice - it.discountVND).toLocaleString('en-US', { minimumFractionDigits: priceDec })} ${it.currencyCode}</td></tr>
                                <tr><th class="text-muted">Thuế suất VAT:</th><td><span class="badge bg-info text-dark">${it.vatRateCode || 'VAT10'}</span></td></tr>
                                <tr><th class="text-muted">Trạng thái:</th><td>${it.isActive ? '<span class="badge bg-success">Đang áp dụng</span>' : '<span class="badge bg-secondary">Tạm dừng</span>'}</td></tr>
                            </table>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold mb-2"><i class="bi bi-currency-exchange text-info me-1"></i> Bảng Định giá quy đổi Ngoại tệ theo Tỷ giá kho hiện hành</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered table-hover align-middle mb-0" style="font-size: 12px;">
                        <thead class="table-light">
                            <tr>
                                <th>Mã ngoại tệ</th>
                                <th>Tên đồng tiền</th>
                                <th class="text-end">Giá mua quy đổi</th>
                                <th class="text-end">Giá bán quy đổi</th>
                                <th class="text-end">Giá ròng quy đổi</th>
                                <th class="text-end">Tỷ giá tham chiếu</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${valRows}
                        </tbody>
                    </table>
                </div>

                ${it.remark ? `<div class="mt-3 small text-muted"><i class="bi bi-info-circle me-1"></i> <strong>Ghi chú:</strong> ${it.remark}</div>` : ''}
            `;
        } catch (e) {
            body.innerHTML = `<div class="alert alert-danger mb-0">${e.message}</div>`;
        }
    }
</script>
