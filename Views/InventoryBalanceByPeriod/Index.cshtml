@model InventoryBalanceByPeriodReport
@{
    ViewData["Title"] = "Báo cáo Tồn kho theo thời điểm";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var selectedWid = (int?)ViewBag.WarehouseId;
    var asOfDate = (string)ViewBag.AsOfDate;
    var keyword = (string)ViewBag.Keyword;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Kho hàng</label>
                <select name="warehouseId" class="form-select form-select-sm">
                    <option value="">— Tất cả kho —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Mốc thời điểm <span class="text-danger">*</span></label>
                <input type="date" id="inputAsOf" name="asOfDate" value="@asOfDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Tìm mặt hàng</label>
                <input type="text" name="q" value="@keyword" placeholder="Mã hoặc tên..." class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc báo cáo
                </button>
                <a href="/InventoryBalanceByPeriod" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
                <a href="/InventoryBalanceByPeriod/ExportCsv?warehouseId=@selectedWid&asOfDate=@asOfDate&q=@Uri.EscapeDataString(keyword ?? "")"
                   class="btn btn-sm btn-outline-success" title="Xuất file CSV / Excel">
                    <i class="bi bi-file-earmark-excel"></i> Xuất
                </a>
                <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark" title="In báo cáo">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
            <div class="col-12 mt-2 pt-1 border-top d-flex gap-2 align-items-center flex-wrap">
                <span class="small text-muted me-1">Chọn nhanh mốc:</span>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setAsOf(0)">Hôm nay</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setAsOf(-1)">Hôm qua</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setAsOf(-7)">Cách đây 7 ngày</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setAsOf(-30)">Cách đây 30 ngày</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setAsOf('monthStart')">Đầu tháng này</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỒN TẠI THỜI ĐIỂM</span>
                    <i class="bi bi-boxes text-primary fs-5"></i>
                </div>
                <div class="stat-num text-primary">@Model.TotalQtyTotalOK.ToString("N0")</div>
                <div class="small text-muted">Mốc @Model.AsOfDate.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỒN BỊ KHÓA</span>
                    <i class="bi bi-lock text-warning fs-5"></i>
                </div>
                <div class="stat-num text-warning">@Model.TotalQtyBlockOK.ToString("N0")</div>
                <div class="small text-muted">Giữ chỗ / tạm khóa</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỒN KHẢ DỤNG</span>
                    <i class="bi bi-check2-circle text-success fs-5"></i>
                </div>
                <div class="stat-num text-success">@Model.TotalQtyAvailOK.ToString("N0")</div>
                <div class="small text-muted">Sẵn sàng xuất bán</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">SỐ BÚT TOÁN</span>
                    <i class="bi bi-journal-bookmark text-secondary fs-5"></i>
                </div>
                <div class="stat-num text-secondary">@Model.TotalTxnCount.ToString("N0")</div>
                <div class="small text-muted">@Model.TotalItems dòng tồn</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold fs-6"><i class="bi bi-table me-2 text-primary"></i>Tồn kho theo thời điểm</span>
            <span class="badge bg-light text-dark border">@Model.Rows.Count dòng</span>
        </div>
        <div class="small text-muted">
            <i class="bi bi-building me-1"></i>Kho: <strong class="text-dark">@Model.WarehouseName</strong>
            <span class="ms-3"><i class="bi bi-clock-history me-1"></i>Mốc: <strong class="text-dark">@Model.AsOfDate.ToString("dd/MM/yyyy")</strong></span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:45px">#</th>
                    <th style="width:110px">Mã hàng</th>
                    <th>Tên hàng hoá</th>
                    <th class="text-center" style="width:70px">ĐVT</th>
                    <th style="width:150px">Kho</th>
                    <th class="text-end text-primary" style="width:120px">Tồn tại thời điểm</th>
                    <th class="text-end text-warning" style="width:110px">Tồn bị khóa</th>
                    <th class="text-end text-success" style="width:110px">Tồn khả dụng</th>
                    <th class="text-center" style="width:90px">Bút toán</th>
                    <th style="width:150px">Giao dịch gần nhất</th>
                    <th class="text-end" style="width:100px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count > 0)
            {
                int stt = 1;
                foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="text-center text-muted small">@(stt++)</td>
                        <td><span class="badge bg-light text-dark border fw-medium">@r.ProductCode</span></td>
                        <td class="fw-semibold">@r.ProductName</td>
                        <td class="text-center text-muted small">@r.Uom</td>
                        <td><i class="bi bi-building text-muted me-1"></i>@r.WarehouseName</td>
                        <td class="text-end fw-bold text-primary">@r.QtyTotalOK.ToString("N0")</td>
                        <td class="text-end fw-semibold text-warning">@(r.QtyBlockOK != 0 ? r.QtyBlockOK.ToString("N0") : "0")</td>
                        <td class="text-end fw-semibold text-success">@r.QtyAvailOK.ToString("N0")</td>
                        <td class="text-center text-muted small">@r.TxnCount</td>
                        <td class="text-muted small">@(r.LastTxnAt.HasValue ? r.LastTxnAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")</td>
                        <td class="text-end">
                            <a href="/WarehouseCard?productId=@r.ProductId&warehouseId=@r.WarehouseId&toDate=@Model.AsOfDate.ToString("yyyy-MM-dd")"
                               class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size:12px" title="Xem chi tiết Thẻ kho đến mốc báo cáo">
                                <i class="bi bi-journal-text me-1"></i>Thẻ kho
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="11" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                        Không có tồn kho hoặc biến động nào phù hợp với bộ lọc tại mốc thời điểm đã chọn.
                    </td>
                </tr>
            }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot class="table-group-divider fw-bold bg-light">
                    <tr>
                        <td colspan="5" class="text-end text-uppercase small">Tổng cộng:</td>
                        <td class="text-end text-primary">@Model.TotalQtyTotalOK.ToString("N0")</td>
                        <td class="text-end text-warning">@Model.TotalQtyBlockOK.ToString("N0")</td>
                        <td class="text-end text-success">@Model.TotalQtyAvailOK.ToString("N0")</td>
                        <td class="text-center text-secondary">@Model.TotalTxnCount.ToString("N0")</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<script>
    function fmtDate(d) {
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function setAsOf(offset) {
        const input = document.getElementById('inputAsOf');
        const today = new Date();
        if (offset === 'monthStart') {
            input.value = fmtDate(new Date(today.getFullYear(), today.getMonth(), 1));
        } else {
            const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() + offset);
            input.value = fmtDate(d);
        }
        document.getElementById('filterForm').submit();
    }
</script>