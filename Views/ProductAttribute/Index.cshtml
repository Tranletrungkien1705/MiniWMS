@model ProductAttributeReport
@{
    ViewData["Title"] = "Thuộc tính hàng hóa";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-sliders text-primary me-2"></i>Danh mục Thuộc tính / Đặc tính kỹ thuật hàng hóa kho</h5>
        <div class="text-muted small">Port từ <code>Mst_Attribute</code> (Skycic) — Quản lý tập thuộc tính & đặc tính kỹ thuật dùng để mô tả mặt hàng trong kho (AttributeCode, AttributeName, NetworkID), chuẩn hóa bộ thuộc tính dùng chung (Màu sắc, Kích cỡ, Chất liệu, Khối lượng, Xuất xứ, Bảo hành, Đóng gói...), theo dõi số lượng mặt hàng và tổng tồn kho gắn với từng thuộc tính</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/ProductAttribute/ExportCsv?q=@keyword&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/Product" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> Danh sách mặt hàng
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createAttributeModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Thuộc tính
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG THUỘC TÍNH</span>
                    <i class="bi bi-sliders text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalAttributes</div>
                <div class="small text-muted">Thuộc tính mô tả hàng hóa trong hệ thống</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Khả dụng gán cho mặt hàng và phiếu kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">NGỪNG ÁP DỤNG</span>
                    <i class="bi bi-pause-circle text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-muted">@Model.InactiveCount</div>
                <div class="small text-muted">Tạm ngưng dùng cho mặt hàng mới</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">MẶT HÀNG ĐÃ GẮN</span>
                    <i class="bi bi-boxes text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary">@Model.TotalProductsMapped</div>
                <div class="small text-muted">Sản phẩm trong kho đã gắn thuộc tính</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-7">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Tìm kiếm theo mã, tên thuộc tính hoặc mạng sở hữu..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Ngừng áp dụng</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/ProductAttribute" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Thuộc tính -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th style="width: 160px;">Mã thuộc tính</th>
                        <th>Tên thuộc tính / đặc tính kỹ thuật</th>
                        <th style="width: 140px;">Mạng sở hữu</th>
                        <th class="text-center" style="width: 140px;">Số mặt hàng</th>
                        <th class="text-end" style="width: 140px;">Tổng tồn kho</th>
                        <th class="text-center" style="width: 140px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy thuộc tính nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@(stt++)</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-dark border-primary-subtle font-monospace px-2 py-1">@row.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@row.Name</div>
                                    <div class="small text-muted">Ngày tạo: @row.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="text-secondary small font-monospace">@(string.IsNullOrWhiteSpace(row.NetworkId) ? "—" : row.NetworkId)</span>
                                </td>
                                <td class="text-center">
                                    @if (row.ProductCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-0" onclick="viewAttributeProducts(@row.Id, '@row.Code', '@row.Name')">
                                            <i class="bi bi-box me-1"></i>@row.ProductCount sp
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">0 sp</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(row.TotalStockQty > 0 ? "text-dark" : "text-muted")">@row.TotalStockQty.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-dash-circle me-1"></i>Ngừng áp dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" title="Sửa thông tin" onclick="editAttribute(@row.Id, '@row.Code', '@row.Name', '@(row.NetworkId?.Replace("'", "\\'") ?? "")', @(row.IsActive.ToString().ToLower()))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="Toggle" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái thuộc tính @row.Code?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-@(row.IsActive ? "warning" : "success")" title="@(row.IsActive ? "Ngừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(row.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa thuộc tính @row.Code? (Nếu đã có sản phẩm sẽ chuyển sang Ngừng áp dụng)');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa thuộc tính">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Thuộc tính -->
<div class="modal fade" id="createAttributeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Thuộc tính mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã thuộc tính (AttributeCode)</label>
                        <input type="text" name="code" class="form-control font-monospace" placeholder="VD: COLOR, SIZE, MATERIAL, WEIGHT, ORIGIN... (để trống tự sinh)" />
                        <div class="form-text">Mã định danh viết hoa không dấu, duy nhất trong hệ thống kho.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên thuộc tính / đặc tính kỹ thuật (AttributeName) <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="VD: Màu sắc, Kích cỡ, Chất liệu cấu thành, Khối lượng..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mạng / đơn vị sở hữu (NetworkID)</label>
                        <input type="text" name="networkId" class="form-control font-monospace" placeholder="VD: WH01, NET-HN..." />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="createIsActive" value="true" checked>
                        <label class="form-check-label fw-semibold small" for="createIsActive">Kích hoạt áp dụng ngay (FlagActive)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu thuộc tính</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Thuộc tính -->
<div class="modal fade" id="editAttributeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Update" id="editAttributeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editAttributeId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật Thuộc tính</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã thuộc tính</label>
                        <input type="text" id="editAttributeCode" class="form-control font-monospace bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên thuộc tính / đặc tính kỹ thuật <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editAttributeName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mạng / đơn vị sở hữu (NetworkID)</label>
                        <input type="text" name="networkId" id="editAttributeNetworkId" class="form-control font-monospace" />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isActive" id="editAttributeIsActive" value="true">
                        <label class="form-check-label fw-semibold small" for="editAttributeIsActive">Đang áp dụng (FlagActive)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem danh sách sản phẩm gắn thuộc tính -->
<div class="modal fade" id="attributeProductsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold mb-0"><i class="bi bi-boxes text-primary me-2"></i>Mặt hàng gắn thuộc tính: <span id="modalAttributeTitle" class="text-primary font-monospace"></span></h5>
                    <div class="text-muted small">Danh sách các mặt hàng trong kho gắn với thuộc tính này</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="d-flex justify-content-between align-items-center p-3 bg-light border-bottom">
                    <div>
                        <span class="fw-semibold">Tổng số mặt hàng:</span> <span id="modalTotalProducts" class="badge bg-primary">0</span>
                    </div>
                    <div>
                        <span class="fw-semibold">Tổng tồn kho vật lý:</span> <span id="modalTotalStock" class="badge bg-success">0</span>
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3" style="width: 50px;">STT</th>
                                <th style="width: 140px;">Mã hàng</th>
                                <th>Tên hàng</th>
                                <th style="width: 90px;">ĐVT</th>
                                <th style="width: 110px;">Loại SP</th>
                                <th style="width: 110px;">Thương hiệu</th>
                                <th class="text-end" style="width: 90px;">Tồn Min</th>
                                <th class="text-end" style="width: 90px;">Tồn Max</th>
                                <th class="text-end pe-3" style="width: 120px;">Giá vốn</th>
                            </tr>
                        </thead>
                        <tbody id="modalAttributeProductsBody">
                            <tr><td colspan="9" class="text-center py-4 text-muted">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editAttribute(id, code, name, networkId, isActive) {
        document.getElementById('editAttributeId').value = id;
        document.getElementById('editAttributeCode').value = code;
        document.getElementById('editAttributeName').value = name;
        document.getElementById('editAttributeNetworkId').value = networkId || '';
        document.getElementById('editAttributeIsActive').checked = !!isActive;
        document.getElementById('editAttributeForm').action = '/ProductAttribute/Update/' + id;
        new bootstrap.Modal(document.getElementById('editAttributeModal')).show();
    }

    async function viewAttributeProducts(id, code, name) {
        document.getElementById('modalAttributeTitle').textContent = name + ' (' + code + ')';
        document.getElementById('modalTotalProducts').textContent = '...';
        document.getElementById('modalTotalStock').textContent = '...';
        const tbody = document.getElementById('modalAttributeProductsBody');
        tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</td></tr>';

        new bootstrap.Modal(document.getElementById('attributeProductsModal')).show();

        try {
            const res = await fetch('/ProductAttribute/Detail/' + id);
            if (!res.ok) throw new Error('Không thể tải chi tiết');
            const data = await res.json();

            document.getElementById('modalTotalProducts').textContent = data.totalProducts;
            document.getElementById('modalTotalStock').textContent = Number(data.totalStockQty).toLocaleString();

            if (!data.products || data.products.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">Chưa có mặt hàng nào gắn thuộc tính này.</td></tr>';
                return;
            }

            let html = '';
            data.products.forEach((p, idx) => {
                const costPriceFormatted = Number(p.costPrice || 0).toLocaleString() + ' đ';
                const ptBadge = p.partTypeCode ? `<span class="badge bg-info-subtle text-info border-info-subtle">${p.partTypeCode}</span>` : '—';
                const brandBadge = p.brandCode ? `<span class="badge bg-secondary-subtle text-secondary border-secondary-subtle">${p.brandCode}</span>` : '—';
                html += `
                    <tr>
                        <td class="ps-3 text-muted">${idx + 1}</td>
                        <td class="fw-semibold font-monospace">${p.code}</td>
                        <td>${p.name}</td>
                        <td><span class="badge bg-light text-dark border font-monospace">${p.uom || ''}</span></td>
                        <td>${ptBadge}</td>
                        <td>${brandBadge}</td>
                        <td class="text-end text-muted">${p.minStock > 0 ? p.minStock : '—'}</td>
                        <td class="text-end text-muted">${p.maxStock > 0 ? p.maxStock : '—'}</td>
                        <td class="text-end pe-3 fw-semibold text-dark">${costPriceFormatted}</td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Lỗi khi tải dữ liệu: ${err.message}</td></tr>`;
        }
    }
</script>
}
