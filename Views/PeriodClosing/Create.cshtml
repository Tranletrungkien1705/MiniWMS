@model MiniWMS.Models.PeriodClosingPreviewReport
@{
    ViewData["Title"] = "Chốt sổ kỳ tồn kho mới";
    var warehouses = ViewBag.Warehouses as List<MiniWMS.Models.Warehouse> ?? [];
    int? selectedWh = ViewBag.WarehouseId as int?;
    int currentYear = DateTime.Today.Year;
    int targetYear = ViewBag.Year is int y ? y : currentYear;
    int targetMonth = ViewBag.Month is int m ? m : (DateTime.Today.Month == 1 ? 12 : DateTime.Today.Month - 1);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-lock text-primary me-2"></i>Chốt sổ kỳ tồn kho mới</h4>
        <small class="text-muted">Tính toán tự động và chụp Snapshot số dư tồn kho tháng (port từ <code>20200407.ChotTonKho.sql</code>)</small>
    </div>
    <div>
        <a href="/PeriodClosing" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    </div>
</div>

<!-- Form chọn kỳ và kho để xem trước -->
<div class="card mb-4 shadow-sm border-top border-4 border-primary">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-sliders me-2 text-primary"></i>Chọn kỳ và phạm vi chốt kho</h6>
    </div>
    <div class="card-body p-3">
        <form method="get" action="/PeriodClosing/Create" class="row g-3 align-items-end" id="filterForm">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Tháng chốt sổ</label>
                <select name="month" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                    @for (int mo = 1; mo <= 12; mo++)
                    {
                        <option value="@mo" selected="@(targetMonth == mo)">Tháng @mo.ToString("D2")</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">Năm chốt sổ</label>
                <select name="year" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                    @for (int yr = currentYear; yr >= currentYear - 3; yr--)
                    {
                        <option value="@yr" selected="@(targetYear == yr)">Năm @yr</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-muted mb-1">Kho lưu trữ áp dụng</label>
                <select name="warehouseId" class="form-select form-select-sm" onchange="document.getElementById('filterForm').submit()">
                    <option value="">-- Toàn bộ hệ thống kho --</option>
                    @foreach (var w in warehouses)
                    {
                        <option value="@w.Id" selected="@(selectedWh == w.Id)">@w.Code — @w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary btn-sm w-100"><i class="bi bi-arrow-repeat me-1"></i>Tính toán lại</button>
            </div>
        </form>
    </div>
</div>

<!-- Thẻ tóm tắt số liệu xem trước -->
<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card p-3 bg-white h-100 shadow-sm border-start border-4 border-secondary">
            <div class="text-muted small fw-semibold text-uppercase">Mặt hàng</div>
            <div class="stat-num text-dark mt-1">@Model.TotalProducts</div>
            <small class="text-muted">có tồn/phát sinh</small>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 bg-white h-100 shadow-sm border-start border-4 border-info">
            <div class="text-muted small fw-semibold text-uppercase">Tồn đầu kỳ</div>
            <div class="stat-num text-info mt-1">@Model.TotalOpeningQty.ToString("N0")</div>
            <small class="text-muted">tính trước ngày @Model.FromDate.ToString("dd/MM/yyyy")</small>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 bg-white h-100 shadow-sm border-start border-4 border-primary">
            <div class="text-muted small fw-semibold text-uppercase">Nhập trong kỳ</div>
            <div class="stat-num text-primary mt-1">+@Model.TotalInQty.ToString("N0")</div>
            <small class="text-muted">từ phiếu nhập/chuyển</small>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 bg-white h-100 shadow-sm border-start border-4 border-danger">
            <div class="text-muted small fw-semibold text-uppercase">Xuất trong kỳ</div>
            <div class="stat-num text-danger mt-1">-@Model.TotalOutQty.ToString("N0")</div>
            <small class="text-muted">từ phiếu xuất/chuyển</small>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 bg-white h-100 shadow-sm border-start border-4 border-success">
            <div class="text-muted small fw-semibold text-uppercase">Tồn cuối kỳ</div>
            <div class="stat-num text-success mt-1">@Model.TotalClosingQty.ToString("N0")</div>
            <small class="text-muted">snapshot chốt sổ</small>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card p-3 bg-white h-100 shadow-sm border-start border-4 border-warning">
            <div class="text-muted small fw-semibold text-uppercase">Tổng giá trị tồn</div>
            <div class="stat-num text-warning fs-5 mt-1">@Model.TotalClosingValue.ToString("N0") <span class="fs-6">đ</span></div>
            <small class="text-muted">theo giá vốn kho</small>
        </div>
    </div>
</div>

<!-- Bảng xem trước chi tiết từng mặt hàng -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <div>
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-table me-2 text-primary"></i>Bảng xem trước tính toán chốt kỳ: @Model.PeriodName</h6>
            <small class="text-muted">Khoảng thời gian: Từ @Model.FromDate.ToString("dd/MM/yyyy") đến @Model.ToDate.ToString("dd/MM/yyyy")</small>
        </div>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@Model.Items.Count dòng dữ liệu</span>
    </div>
    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light sticky-top">
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th style="width: 140px;">Kho lưu trữ</th>
                    <th style="width: 110px;">Mã hàng</th>
                    <th>Tên mặt hàng</th>
                    <th class="text-center" style="width: 80px;">ĐVT</th>
                    <th class="text-end" style="width: 100px;">Tồn đầu</th>
                    <th class="text-end text-primary" style="width: 100px;">Nhập kỳ</th>
                    <th class="text-end text-danger" style="width: 100px;">Xuất kỳ</th>
                    <th class="text-end text-success fw-bold" style="width: 100px;">Tồn cuối</th>
                    <th class="text-end" style="width: 120px;">Đơn giá vốn</th>
                    <th class="text-end fw-bold" style="width: 140px;">Giá trị tồn</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="text-center py-4 text-muted">
                            <i class="bi bi-info-circle fs-3 d-block mb-1 text-secondary"></i>
                            Không có phát sinh hoặc tồn kho nào trong kỳ này.
                        </td>
                    </tr>
                }
                else
                {
                    int idx = 1;
                    foreach (var it in Model.Items)
                    {
                        <tr>
                            <td>@(idx++)</td>
                            <td><span class="badge bg-light text-dark border">@it.WarehouseName</span></td>
                            <td class="fw-bold text-dark">@it.ProductCode</td>
                            <td>@it.ProductName</td>
                            <td class="text-center text-muted">@it.Uom</td>
                            <td class="text-end">@it.OpeningQty.ToString("N0")</td>
                            <td class="text-end text-primary fw-semibold">+@it.InQty.ToString("N0")</td>
                            <td class="text-end text-danger fw-semibold">-@it.OutQty.ToString("N0")</td>
                            <td class="text-end text-success fw-bold fs-6">@it.ClosingQty.ToString("N0")</td>
                            <td class="text-end text-muted">@it.CostPrice.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-dark">@it.ClosingValue.ToString("N0") đ</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot class="table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end text-uppercase">TỔNG CỘNG:</td>
                    <td class="text-end">@Model.TotalOpeningQty.ToString("N0")</td>
                    <td class="text-end text-primary">+@Model.TotalInQty.ToString("N0")</td>
                    <td class="text-end text-danger">-@Model.TotalOutQty.ToString("N0")</td>
                    <td class="text-end text-success fs-6">@Model.TotalClosingQty.ToString("N0")</td>
                    <td></td>
                    <td class="text-end text-success">@Model.TotalClosingValue.ToString("N0") đ</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- Form Xác nhận chốt sổ -->
<div class="card shadow-sm border-start border-4 border-success">
    <div class="card-body p-4">
        <form method="post" action="/PeriodClosing/Create">
            @Html.AntiForgeryToken()
            <input type="hidden" name="warehouseId" value="@(selectedWh?.ToString() ?? "")" />
            <input type="hidden" name="year" value="@targetYear" />
            <input type="hidden" name="month" value="@targetMonth" />

            <h5 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-success me-2"></i>Xác nhận chốt sổ & Khóa kỳ tồn kho</h5>
            <p class="text-muted small mb-3">
                Khi thực hiện chốt sổ, hệ thống sẽ lưu vết toàn bộ số liệu snapshot tồn đầu, nhập, xuất, tồn cuối và giá trị tồn kho của các mặt hàng trong kỳ <strong>Tháng @targetMonth.ToString("D2")/@targetYear</strong>.
                Dữ liệu sẽ được khóa lại để bảo đảm tính toàn vẹn số liệu kế toán kho.
            </p>

            <div class="mb-3">
                <label class="form-label fw-semibold small text-muted">Ghi chú chốt kỳ (tùy chọn)</label>
                <input type="text" name="note" class="form-control" placeholder="Ví dụ: Chốt sổ tồn kho định kỳ cuối tháng, khớp số liệu với kiểm kê..." value="Chốt sổ kỳ kho Tháng @targetMonth.ToString("D2")/@targetYear" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="/PeriodClosing" class="btn btn-light btn-sm"><i class="bi bi-x me-1"></i>Hủy bỏ</a>
                <button type="submit" class="btn btn-success btn-sm px-4 fw-bold">
                    <i class="bi bi-lock-fill me-1"></i>Xác nhận chốt sổ & Lưu Snapshot
                </button>
            </div>
        </form>
    </div>
</div>
