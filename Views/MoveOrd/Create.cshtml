@{
    ViewData["Title"] = "Tạo mới điều chuyển kho";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var prods = (List<Product>)ViewBag.Products;
}
@*
    Port 1:1 Views/InvF_MoveOrd/Create.cshtml (2020.3.Skycic.Inventory).
    Header: IF_MONo readonly (:81), InvCodeOut bắt buộc (:88), InvCodeIn bắt buộc (:107), Remark (:127).
    Lưới 14 cột: Create.cshtml:219-234. Tiền tệ theo _CommonJs.cshtml:2891-2894:
      ValMove = Qty*UPMove; ValVAT = ValMove*VAT/100; ValAfterVAT = ValMove + ValVAT.
    Guard: InvF_MoveOrd.js:30-31 (chưa chọn kho xuất/nhập), :43-48 (lưới hàng hoá trống).
*@
<h1 class="h5 fw-bold mb-3">
    Tạo mới điều chuyển kho
    <span class="text-muted fw-normal" style="font-size:12px">(port 1:1 InvF_MoveOrd/Create.cshtml — InvF_MoveOrd)</span>
</h1>
<div class="card"><div class="card-body">
    <form method="post" action="/MoveOrd/Create">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Số phiếu điều chuyển <span class="text-danger">*</span></label>
                <input class="form-control" value="(hệ thống tự cấp khi lưu)" readonly />
            </div>
            <div class="col-md-3">
                @* nguồn: Create.cshtml:88-104 — Kho xuất (InvCodeOut) *@
                <label class="form-label">Kho xuất <span class="text-danger">*</span></label>
                <select name="outWarehouseId" class="form-select" required>
                    <option value="">--Chọn kho xuất--</option>
                    @foreach (var w in whs) { <option value="@w.Id">@w.Name</option> }
                </select>
            </div>
            <div class="col-md-3">
                @* nguồn: Create.cshtml:107-123 — Kho nhập (InvCodeIn) *@
                <label class="form-label">Kho nhập <span class="text-danger">*</span></label>
                <select name="inWarehouseId" class="form-select" required>
                    <option value="">--Chọn kho nhập--</option>
                    @foreach (var w in whs) { <option value="@w.Id">@w.Name</option> }
                </select>
            </div>
            <div class="col-md-3">
                @* nguồn: InvF_MoveOrd.cs:17 MoveOrdType — Loại điều chuyển *@
                <label class="form-label">Loại điều chuyển</label>
                <input name="moveOrdType" class="form-control" placeholder="VD: NOIBO" />
            </div>
            <div class="col-md-3">
                @* nguồn: InvF_MoveOrd.cs:23 IF_InvAudNo — số phiếu kiểm kê liên quan *@
                <label class="form-label">Số phiếu kiểm kê</label>
                <input name="auditCode" class="form-control" placeholder="(nếu điều chuyển do kiểm kê)" />
            </div>
            <div class="col-md-9">
                @* nguồn: Create.cshtml:127 — nhãn nguồn là "Nội dung xuất", cột DB là Remark *@
                <label class="form-label">Nội dung xuất</label>
                <textarea name="remark" class="form-control" rows="1"></textarea>
            </div>
        </div>

        <p class="fw-bold mt-4 mb-2">Danh mục hàng hóa <span class="text-danger">*</span></p>
        <div class="table-responsive">
        <table class="table table-bordered align-middle" id="tblLines">
            <thead><tr>
                <th>Mã hàng hoá</th>
                <th>Tên hàng hoá</th>
                <th>Đơn vị</th>
                <th class="text-end" style="width:130px">Số lượng điều chuyển</th>
                <th class="text-end" style="width:150px">Giá nhập trước VAT</th>
                <th class="text-end" style="width:110px">Thuế suất (%)</th>
                <th style="width:220px">Ghi chú</th>
            </tr></thead>
            <tbody>
            @* Nguồn thêm dòng bằng ô tìm/quét mã vạch (Create.cshtml:141-153); đích dựng sẵn 5 dòng chọn mặt hàng. *@
            @for (var i = 0; i < 5; i++)
            {
                <tr>
                    <td>
                        <select name="productId" class="form-select form-select-sm">
                            <option value="0">— chọn —</option>
                            @foreach (var p in prods) { <option value="@p.Id">@p.Code</option> }
                        </select>
                    </td>
                    <td class="text-muted small">theo mã đã chọn</td>
                    <td class="text-muted small">theo danh mục</td>
                    <td><input name="qty" type="number" step="0.01" min="0" value="0" class="form-control form-control-sm text-end" /></td>
                    <td><input name="upMove" type="number" step="1" min="0" value="0" class="form-control form-control-sm text-end" /></td>
                    <td><input name="vat" type="number" step="1" min="0" value="0" class="form-control form-control-sm text-end" /></td>
                    <td><input name="lineRemark" class="form-control form-control-sm" /></td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <div class="alert alert-info mb-0 small">
            <i class="bi bi-info-circle me-1"></i>
            Thành tiền tính lúc lưu: <code>ValMove = SL × đơn giá</code>, <code>ValVAT = ValMove × VAT/100</code>,
            <code>ValAfterVAT = ValMove + ValVAT</code> — đúng công thức nguồn <code>_CommonJs.cshtml:2891-2894</code>.
            Tồn kho chỉ đổi khi <b>duyệt</b> phiếu.
        </div>
        <div class="mt-3 d-flex gap-2">
            @* nguồn: Create.cshtml:69 — BTN_TAO_DIEUCHUYEN_LUU *@
            <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
            <a href="/MoveOrd" class="btn btn-light">Quay lại</a>
        </div>
    </form>
</div></div>
