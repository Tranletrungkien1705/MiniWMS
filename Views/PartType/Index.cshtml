@model PartTypeReport
@{
    ViewData["Title"] = "Loại mặt hàng";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-tags text-primary me-2"></i>Danh mục Phân loại Loại mặt hàng kho</h5>
        <div class="text-muted small">Port từ <code>Mst_PartType</code> (Skycic) — Chuẩn hóa phân loại danh mục hàng hóa (Thành phẩm, Bán thành phẩm, Nguyên vật liệu, Phụ tùng linh kiện, Bao bì đóng gói, Công cụ dụng cụ), quản lý tồn kho và quy cách bảo quản</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/PartType/ExportCsv?q=@keyword&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/Product" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> Danh sách mặt hàng
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createPartTypeModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Loại mặt hàng
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG LOẠI MẶT HÀNG</span>
                    <i class="bi bi-tags text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalTypes</div>
                <div class="small text-muted">Nhóm phân loại nghiệp vụ chuẩn WMS</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Khả dụng gán cho mặt hàng và phiếu kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">NGỪNG ÁP DỤNG</span>
                    <i class="bi bi-pause-circle text-warning fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-warning">@Model.InactiveCount</div>
                <div class="small text-muted">Tạm khóa / Hạn chế sử dụng mới</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">MẶT HÀNG ĐÃ PHÂN LOẠI</span>
                    <i class="bi bi-boxes text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-info">@Model.TotalProductsMapped</div>
                <div class="small text-muted">Sản phẩm đã gán mã loại mặt hàng</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Tìm kiếm theo mã loại, tên loại mặt hàng hoặc mô tả..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Ngừng áp dụng</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/PartType" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Đặt lại
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Loại mặt hàng -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 50px;">STT</th>
                        <th style="width: 130px;">Mã loại</th>
                        <th>Tên loại mặt hàng</th>
                        <th>Mô tả / Quy cách quản lý</th>
                        <th class="text-center" style="width: 140px;">Số mặt hàng</th>
                        <th class="text-end" style="width: 140px;">Tổng tồn kho</th>
                        <th class="text-center" style="width: 130px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy loại mặt hàng nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@(stt++)</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace px-2 py-1">@row.Code</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@row.Name</div>
                                    <div class="small text-muted">Ngày tạo: @row.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrWhiteSpace(row.Remark) ? "—" : row.Remark)</span>
                                </td>
                                <td class="text-center">
                                    @if (row.ProductCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-2 py-0" onclick="viewProducts(@row.Id, '@row.Code', '@row.Name')">
                                            <i class="bi bi-box me-1"></i>@row.ProductCount sp
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">0 sp</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold @(row.TotalStockQty > 0 ? "text-dark" : "text-muted")">@row.TotalStockQty.ToString("N0")</span>
                                </td>
                                <td class="text-center">
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-dash-circle me-1"></i>Ngừng áp dụng
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" title="Sửa thông tin" onclick="editPartType(@row.Id, '@row.Code', '@row.Name', '@(row.Remark?.Replace("'", "\\'") ?? "")', @(row.IsActive.ToString().ToLower()))">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="Toggle" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái loại mặt hàng @row.Code?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-@(row.IsActive ? "warning" : "success")" title="@(row.IsActive ? "Ngừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(row.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@row.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa loại mặt hàng @row.Code? (Nếu đã có sản phẩm sẽ chuyển sang Ngừng áp dụng)');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa loại mặt hàng">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Loại mặt hàng -->
<div class="modal fade" id="createPartTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm Loại mặt hàng mới</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã loại mặt hàng (PartType) <span class="text-danger">*</span></label>
                        <input type="text" name="code" class="form-control text-uppercase" placeholder="Ví dụ: TP, BTP, NVL, PTLK, BBDG, CCDC..." required maxlength="20" />
                        <div class="form-text small">Viết tắt in hoa, không trùng lặp trong hệ thống.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên loại mặt hàng (PartTypeName) <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: Thành phẩm sản xuất, Phụ tùng linh kiện..." required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô tả / Đặc tính quản lý (Remark)</label>
                        <textarea name="remark" class="form-control" rows="3" placeholder="Mô tả công dụng, tính chất mặt hàng, điều kiện kho bãi bảo quản..."></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="createIsActive" checked />
                        <label class="form-check-label small fw-semibold" for="createIsActive">Kích hoạt áp dụng ngay</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu loại mặt hàng</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Loại mặt hàng -->
<div class="modal fade" id="editPartTypeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="Update" id="editPartTypeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật Loại mặt hàng</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã loại mặt hàng (PartType)</label>
                        <input type="text" id="editCode" class="form-control text-uppercase bg-light" readonly />
                        <div class="form-text small">Mã định danh không thể thay đổi sau khi tạo.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tên loại mặt hàng <span class="text-danger">*</span></label>
                        <input type="text" name="name" id="editName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mô tả / Đặc tính quản lý (Remark)</label>
                        <textarea name="remark" id="editRemark" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editIsActive" />
                        <label class="form-check-label small fw-semibold" for="editIsActive">Đang áp dụng</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem danh sách sản phẩm thuộc loại -->
<div class="modal fade" id="viewProductsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h6 class="modal-title fw-bold">
                    <i class="bi bi-boxes text-info me-2"></i>Danh sách mặt hàng thuộc loại: <span id="viewTypeTitle" class="badge bg-primary ms-1"></span>
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small">Tổng số mặt hàng: </span><span id="viewTotalProds" class="fw-bold">0</span> | 
                        <span class="text-muted small">Tổng tồn kho vật lý: </span><span id="viewTotalStock" class="fw-bold text-primary">0</span>
                    </div>
                    <a href="/Product" class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg me-1"></i>Quản lý mặt hàng</a>
                </div>
                <div class="table-responsive" style="max-height: 400px;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3">Mã hàng</th>
                                <th>Tên hàng hoá</th>
                                <th>ĐVT</th>
                                <th class="text-end">Tồn Min</th>
                                <th class="text-end">Tồn Max</th>
                                <th class="text-end pe-3">Giá vốn (đ)</th>
                            </tr>
                        </thead>
                        <tbody id="viewProductsTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang tải danh sách mặt hàng...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function editPartType(id, code, name, remark, isActive) {
        document.getElementById('editId').value = id;
        document.getElementById('editCode').value = code;
        document.getElementById('editName').value = name;
        document.getElementById('editRemark').value = remark;
        document.getElementById('editIsActive').checked = isActive;
        var modal = new bootstrap.Modal(document.getElementById('editPartTypeModal'));
        modal.show();
    }

    function viewProducts(id, code, name) {
        document.getElementById('viewTypeTitle').innerText = code + ' — ' + name;
        document.getElementById('viewTotalProds').innerText = '...';
        document.getElementById('viewTotalStock').innerText = '...';
        var tbody = document.getElementById('viewProductsTableBody');
        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang tải danh sách mặt hàng...</td></tr>';

        var modal = new bootstrap.Modal(document.getElementById('viewProductsModal'));
        modal.show();

        fetch('/PartType/Detail?id=' + id)
            .then(res => res.json())
            .then(data => {
                document.getElementById('viewTotalProds').innerText = data.totalProducts;
                document.getElementById('viewTotalStock').innerText = Number(data.totalStockQty).toLocaleString('vi-VN');

                if (!data.products || data.products.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">Chưa có mặt hàng nào thuộc loại này.</td></tr>';
                    return;
                }

                var html = '';
                data.products.forEach(p => {
                    html += '<tr>' +
                        '<td class="ps-3 fw-semibold font-monospace">' + p.code + '</td>' +
                        '<td>' + p.name + '</td>' +
                        '<td>' + p.uom + '</td>' +
                        '<td class="text-end text-muted">' + (p.minStock > 0 ? p.minStock : '—') + '</td>' +
                        '<td class="text-end text-muted">' + (p.maxStock > 0 ? p.maxStock : '—') + '</td>' +
                        '<td class="text-end pe-3 fw-bold">' + Number(p.costPrice).toLocaleString('vi-VN') + ' đ</td>' +
                        '</tr>';
                });
                tbody.innerHTML = html;
            })
            .catch(err => {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Lỗi tải dữ liệu mặt hàng.</td></tr>';
            });
    }
</script>
}
