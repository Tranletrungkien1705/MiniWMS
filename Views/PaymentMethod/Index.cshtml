@model PaymentMethodReport
@{
    ViewData["Title"] = "Danh mục Phương thức thanh toán kho";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var activeOnly = (bool?)ViewBag.ActiveOnly;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1">
            <i class="bi bi-credit-card text-primary me-2"></i>Quản lý Danh mục Phương thức thanh toán Kho
        </h5>
        <div class="text-muted small">
            Port từ <code>Mst_PaymentMethods</code> (Skycic) — Chuẩn hóa hình thức thanh toán gắn với chứng từ mua bán hàng hóa (Tiền mặt, Chuyển khoản, Bù trừ công nợ, Ví điện tử, Thẻ tín dụng...), phục vụ hạch toán và đối chiếu công nợ NCC / khách hàng
        </div>
    </div>
    <div class="d-flex gap-2">
        <a href="/PaymentMethod/ExportCsv?q=@keyword&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In danh mục
        </button>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createPaymentMethodModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Phương thức mới
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm h-100">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG PHƯƠNG THỨC</span>
                    <i class="bi bi-credit-card-2-front text-secondary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalMethods</div>
                <div class="small text-muted">Hình thức thanh toán trong danh mục</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm h-100">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">@Model.InactiveCount phương thức tạm ngưng</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm h-100">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">PHIẾU NHẬP THAM CHIẾU</span>
                    <i class="bi bi-receipt text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-primary font-monospace">@Model.TotalMappedReceipts</div>
                <div class="small text-muted">Phiếu nhập kho mua hàng đang dùng</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm h-100">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">PHƯƠNG THỨC PHỔ THÔNG</span>
                    <i class="bi bi-cash-coin text-warning fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">
                    CK <span class="badge bg-light text-secondary border fs-6">Chuyển khoản</span>
                </div>
                <div class="small text-muted">Áp dụng phổ biến cho giao dịch mua bán</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" action="/PaymentMethod" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" class="form-control form-control-sm border-start-0" placeholder="Tìm theo mã (TM, CK, BU_TRU...), tên phương thức hoặc ghi chú..." value="@keyword" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="activeOnly" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Đang áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Ngưng áp dụng</!option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc dữ liệu
                </button>
                <a href="/PaymentMethod" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu danh mục phương thức thanh toán -->
<div class="card border-0 bg-white shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:13px">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:45px">STT</th>
                    <th class="text-center" style="width:110px">Thao tác</th>
                    <th style="width:150px">Mã phương thức</th>
                    <th>Tên phương thức thanh toán</th>
                    <th class="text-center" style="width:110px">Mạng/Đại lý</th>
                    <th class="text-center" style="width:150px">Phiếu nhập liên kết</th>
                    <th class="text-center" style="width:120px">Trạng thái</th>
                    <th style="width:250px">Ghi chú</th>
                    <th class="text-end" style="width:130px">Ngày tạo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            Không tìm thấy phương thức thanh toán nào phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
                else
                {
                    int stt = 1;
                    foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td class="text-center text-muted">@(stt++)</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-info" title="Xem chi tiết & phiếu nhập liên kết" onclick="openDetailModal(@r.Id)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-primary" title="Sửa phương thức" onclick="openEditModal(@r.Id, '@r.Code', '@Html.Raw(Html.Encode(r.Name))', '@Html.Raw(Html.Encode(r.NetworkID ?? ""))', '@Html.Raw(Html.Encode(r.Remark ?? ""))', @(r.FlagActive ? "true" : "false"))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form method="post" action="/PaymentMethod/Toggle" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn thay đổi trạng thái phương thức @r.Code?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-outline-@(r.FlagActive ? "warning" : "success")" title="@(r.FlagActive ? "Ngưng áp dụng" : "Kích hoạt áp dụng")">
                                            <i class="bi bi-@(r.FlagActive ? "pause-fill" : "play-fill")"></i>
                                        </button>
                                    </form>
                                    <form method="post" action="/PaymentMethod/Delete" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phương thức @r.Code?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-outline-danger" title="Xóa phương thức" @(r.MappedReceiptCount > 0 ? "disabled" : "")>
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1 fs-6">
                                    @r.Code
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@r.Name</div>
                            </td>
                            <td class="text-center">
                                <span class="text-muted small">@(string.IsNullOrWhiteSpace(r.NetworkID) ? "-" : r.NetworkID)</span>
                            </td>
                            <td class="text-center">
                                @if (r.MappedReceiptCount > 0)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="bi bi-receipt me-1"></i>@r.MappedReceiptCount phiếu nhập
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">0 phiếu nhập</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (r.FlagActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Đang áp dụng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                        <i class="bi bi-pause-circle me-1"></i>Ngưng áp dụng
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="text-muted small text-break">@(r.Remark ?? "-")</span>
                            </td>
                            <td class="text-end text-muted small">
                                @r.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL 1: THÊM MỚI PHƯƠNG THỨC THANH TOÁN -->
<div class="modal fade" id="createPaymentMethodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/PaymentMethod/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold text-primary">
                        <i class="bi bi-plus-circle me-1"></i> Thêm mới Phương thức thanh toán
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã phương thức <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control form-control-sm text-uppercase" placeholder="vd: TM, CK, BU_TRU..." required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mạng / Đại lý</label>
                            <input type="text" name="networkId" class="form-control form-control-sm" placeholder="vd: WMS" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Tên phương thức thanh toán <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="vd: Chuyển khoản ngân hàng..." required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Ghi chú / Diễn giải</label>
                            <textarea name="remark" class="form-control form-control-sm" rows="3" placeholder="vd: Áp dụng cho thanh toán mua hàng qua ngân hàng..."></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="flagActive" id="create_flagActive" value="true" checked />
                                <label class="form-check-label small" for="create_flagActive">Kích hoạt áp dụng ngay trong hệ thống kho</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-save me-1"></i> Lưu phương thức
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: SỬA PHƯƠNG THỨC THANH TOÁN -->
<div class="modal fade" id="editPaymentMethodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" action="/PaymentMethod/Update">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit_id" />
                <div class="modal-header py-2">
                    <h6 class="modal-title fw-bold text-primary">
                        <i class="bi bi-pencil-square me-1"></i> Cập nhật Phương thức thanh toán
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mã phương thức</label>
                            <input type="text" id="edit_code" class="form-control form-control-sm text-uppercase bg-light" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mạng / Đại lý</label>
                            <input type="text" name="networkId" id="edit_networkId" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Tên phương thức thanh toán <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="edit_name" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Ghi chú / Diễn giải</label>
                            <textarea name="remark" id="edit_remark" class="form-control form-control-sm" rows="3"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" name="flagActive" id="edit_flagActive" value="true" />
                                <label class="form-check-label small" for="edit_flagActive">Trạng thái áp dụng</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-save me-1"></i> Cập nhật thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 3: CHI TIẾT PHƯƠNG THỨC & PHIẾU NHẬP LIÊN KẾT -->
<div class="modal fade" id="detailPaymentMethodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title fw-bold text-primary">
                    <i class="bi bi-info-circle me-1"></i> Chi tiết Phương thức thanh toán & Phiếu nhập kho liên kết
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3" id="detailModalBody">
                <div class="text-center py-4 text-muted">
                    <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                    Đang tải dữ liệu chi tiết phương thức thanh toán...
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditModal(id, code, name, networkId, remark, flagActive) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_code').value = code;
        document.getElementById('edit_name').value = name;
        document.getElementById('edit_networkId').value = networkId;
        document.getElementById('edit_remark').value = remark;
        document.getElementById('edit_flagActive').checked = flagActive;
        new bootstrap.Modal(document.getElementById('editPaymentMethodModal')).show();
    }

    async function openDetailModal(id) {
        const modal = new bootstrap.Modal(document.getElementById('detailPaymentMethodModal'));
        modal.show();
        const body = document.getElementById('detailModalBody');
        body.innerHTML = `
            <div class="text-center py-4 text-muted">
                <div class="spinner-border text-primary spinner-border-sm me-2" role="status"></div>
                Đang tải chi tiết phương thức thanh toán...
            </div>`;

        try {
            const resp = await fetch(`/PaymentMethod/Detail?id=${id}`);
            if (!resp.ok) throw new Error('Không thể tải thông tin chi tiết');
            const data = await resp.json();
            const receipts = data.receipts || [];

            let receiptsHtml = '';
            if (receipts.length === 0) {
                receiptsHtml = `<tr><td colspan="7" class="text-center py-3 text-muted">Chưa có phiếu nhập kho nào áp dụng phương thức thanh toán này.</td></tr>`;
            } else {
                let stt = 1;
                receiptsHtml = receipts.map(p => `
                    <tr>
                        <td class="text-center text-muted">${stt++}</td>
                        <td class="font-monospace fw-bold">${p.code}</td>
                        <td>${p.warehouseName || '-'}</td>
                        <td>${p.supplierName || '-'}</td>
                        <td class="font-monospace">${p.invoiceNo || '-'}</td>
                        <td class="text-center">${new Date(p.date).toLocaleDateString('vi-VN')}</td>
                        <td class="text-end font-monospace text-primary fw-bold">${Number(p.totalAmountAfterVAT).toLocaleString('vi-VN')} đ</td>
                    </tr>
                `).join('');
            }

            body.innerHTML = `
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr><th class="text-muted" style="width:140px">Mã phương thức:</th><td><span class="badge bg-light text-dark border font-monospace fs-6">${data.code}</span></td></tr>
                            <tr><th class="text-muted">Tên phương thức:</th><td class="fw-semibold">${data.name}</td></tr>
                            <tr><th class="text-muted">Trạng thái:</th><td><span class="badge ${data.flagActive ? 'bg-success' : 'bg-secondary'}">${data.flagActive ? 'Đang áp dụng' : 'Ngưng áp dụng'}</span></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <table class="table table-sm table-borderless mb-0">
                            <tr><th class="text-muted" style="width:140px">Mạng / Đại lý:</th><td>${data.networkId || '-'}</td></tr>
                            <tr><th class="text-muted">Ghi chú:</th><td class="small">${data.remark || '-'}</td></tr>
                            <tr><th class="text-muted">Phiếu nhập liên kết:</th><td><strong class="text-primary">${data.totalMappedReceipts}</strong> phiếu nhập</td></tr>
                        </table>
                    </div>
                </div>

                <h6 class="fw-bold text-dark mb-2">Danh sách phiếu nhập kho mua hàng áp dụng (${data.totalMappedReceipts}):</h6>
                <div class="table-responsive border rounded" style="max-height:260px; overflow-y:auto;">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size:12px">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="text-center" style="width:40px">STT</th>
                                <th>Mã phiếu nhập</th>
                                <th>Kho nhập</th>
                                <th>Nhà cung cấp</th>
                                <th>Số hóa đơn</th>
                                <th class="text-center">Ngày</th>
                                <th class="text-end">Tổng sau VAT</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${receiptsHtml}
                        </tbody>
                    </table>
                </div>
            `;
        } catch (err) {
            body.innerHTML = `<div class="alert alert-danger mb-0">${err.message}</div>`;
        }
    }
</script>
}