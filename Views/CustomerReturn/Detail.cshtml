@model CustomerReturn
@{
    ViewData["Title"] = $"Phiếu khách hàng trả lại {Model.Code}";
    var (stText, stCss) = Ui.CusReturnStatusBadge(Model.Status);
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3"><div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-1">
                        @Model.Code
                        <span class="badge bg-@stCss ms-1">@stText</span>
                    </h5>
                    <div class="text-muted small">
                        <span>Kho nhận: <b class="text-dark">@Model.Warehouse.Name</b></span>
                        <span class="mx-2">·</span>
                        <span>Khách hàng: <b class="text-primary">@Model.CustomerName</b></span>
                        @if (!string.IsNullOrEmpty(Model.CustomerCode))
                        {
                            <span class="text-muted">(@Model.CustomerCode)</span>
                        }
                    </div>
                    <div class="text-muted small mt-1">
                        <span>Ngày trả: @Model.Date.ToString("dd/MM/yyyy")</span>
                        @if (!string.IsNullOrEmpty(Model.InvoiceNo))
                        {
                            <span class="mx-2">·</span>
                            <span>Hóa đơn bán gốc: <b>@Model.InvoiceNo</b></span>
                        }
                        @if (!string.IsNullOrEmpty(Model.RefOrderNo))
                        {
                            <span class="mx-2">·</span>
                            <span>Phiếu xuất / Đơn hàng gốc: <b>@Model.RefOrderNo</b></span>
                        }
                        @if (!string.IsNullOrEmpty(Model.CreatedBy))
                        {
                            <span class="mx-2">·</span>
                            <span>Người lập: @Model.CreatedBy</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Reason))
                    {
                        <div class="small text-muted mt-2 p-2 bg-light rounded">
                            <i class="bi bi-chat-left-quote me-1 text-primary"></i><b>Lý do khách trả:</b> @Model.Reason
                        </div>
                    }
                </div>
                <div class="text-end">
                    <span class="text-muted small d-block">Trạng thái</span>
                    <span class="badge bg-@stCss fs-6">@stText</span>
                </div>
            </div>

            <!-- Quy trình xử lý phiếu khách trả hàng -->
            <div class="p-3 bg-light rounded border mb-3">
                <div class="row text-center g-2">
                    <div class="col-6">
                        <div class="p-2 rounded @(Model.Status != CusReturnStatus.Cancelled ? "bg-white shadow-sm border" : "text-muted")">
                            <div class="small fw-semibold text-secondary"><i class="bi bi-1-circle me-1"></i>Lập phiếu nhận trả</div>
                            <div class="badge bg-secondary mt-1">Khởi tạo</div>
                            <div class="small text-muted mt-1" style="font-size:11px">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2 rounded @(Model.Status == CusReturnStatus.Finished ? "bg-white shadow-sm border" : "text-muted")">
                            <div class="small fw-semibold @(Model.Status == CusReturnStatus.Finished ? "text-success" : "text-muted")">
                                <i class="bi bi-2-circle me-1"></i>Duyệt & Nhập kho lại
                            </div>
                            @if (Model.FinishedAt.HasValue)
                            {
                                <div class="badge bg-success mt-1">Đã nhập kho</div>
                                <div class="small text-muted mt-1" style="font-size:11px">@Model.FinishedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                            else if (Model.Status == CusReturnStatus.Cancelled)
                            {
                                <div class="badge bg-dark mt-1">Đã hủy</div>
                            }
                            else
                            {
                                <div class="badge bg-light text-muted border mt-1">Chờ nhận hàng</div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <h6 class="fw-bold mb-2">Chi tiết mặt hàng khách trả</h6>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Mã hàng</th>
                            <th>Tên mặt hàng</th>
                            <th>ĐVT</th>
                            <th class="text-end">SL nhận trả</th>
                            <th class="text-end">Đơn giá hoàn</th>
                            <th class="text-end">Thành tiền</th>
                            <th>Ghi chú lỗi/đổi</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in Model.Lines)
                    {
                        <tr>
                            <td class="font-monospace fw-semibold text-muted small">@l.Product.Code</td>
                            <td class="fw-medium">@l.Product.Name</td>
                            <td class="small text-muted">@l.Product.Uom</td>
                            <td class="text-end fw-bold text-dark">@l.Quantity.ToString("N0")</td>
                            <td class="text-end">@l.UnitPrice.ToString("N0") đ</td>
                            <td class="text-end fw-semibold text-success">@l.Amount.ToString("N0") đ</td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(l.Note) ? "—" : l.Note)</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold bg-light">
                            <td colspan="3" class="text-end">Tổng cộng:</td>
                            <td class="text-end text-primary">@Model.TotalQty.ToString("N0")</td>
                            <td></td>
                            <td class="text-end text-success">@Model.TotalAmount.ToString("N0") đ</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div></div>

        <div class="d-flex gap-2">
            <a href="/CustomerReturn" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-gear me-1 text-primary"></i>Thao tác xử lý</h6>

            @if (Model.Status == CusReturnStatus.Draft)
            {
                <div class="mb-3">
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xác nhận nhận hàng và nhập kho hàng khách trả? Thao tác này sẽ tự động sinh phiếu nhập kho và tăng tồn kho ngay lập tức.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-check-circle me-1"></i>Duyệt & Nhập kho lại
                        </button>
                    </form>
                    <div class="form-text small text-muted">
                        Khi duyệt, hệ thống tự động sinh phiếu nhập kho (PN) vào kho <b>@Model.Warehouse.Name</b> và cộng tồn kho ngay.
                    </div>
                </div>

                <hr />
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn hủy phiếu khách hàng trả lại này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                        <i class="bi bi-x-circle me-1"></i>Hủy phiếu
                    </button>
                </form>
            }
            else if (Model.Status == CusReturnStatus.Finished)
            {
                <div class="alert alert-success small mb-3">
                    <i class="bi bi-check2-circle me-1"></i><b>Đã nhập kho thành công.</b> Hàng hóa khách trả đã được cộng vào kho và phiếu nhập kho đã được ghi sổ tự động.
                </div>
                @if (Model.StockDoc != null)
                {
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="small text-muted mb-1">Phiếu nhập kho liên kết:</div>
                        <a href="/Doc/Detail/@Model.StockDocId" class="fw-bold text-decoration-none">
                            <i class="bi bi-box-arrow-in-down me-1 text-success"></i>@Model.StockDoc.Code
                        </a>
                        <div class="small text-muted mt-1">Đã ghi sổ vào lúc @(Model.FinishedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                    </div>
                }
            }
            else if (Model.Status == CusReturnStatus.Cancelled)
            {
                <div class="alert alert-secondary small mb-0">
                    <i class="bi bi-x-circle me-1"></i>Phiếu nhận trả hàng này đã bị hủy.
                </div>
            }
        </div></div>
    </div>
</div>
