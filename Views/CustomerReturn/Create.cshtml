@{
    ViewData["Title"] = "Lập phiếu khách hàng trả lại";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var products = (List<Product>)ViewBag.Products;
    var selectedWhId = (int)ViewBag.SelectedWarehouseId;
}
<form asp-action="Create" method="post" id="cusReturnForm">
    @Html.AntiForgeryToken()
    <div class="card mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3"><i class="bi bi-arrow-return-left me-1 text-primary"></i>Thông tin phiếu nhận hàng khách trả lại (Customer Return)</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Kho nhận hàng trả *</label>
                <select name="warehouseId" id="whSelect" class="form-select" required>
                    <option value="">— Chọn kho nhận hàng —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWhId == w.Id)">@w.Name (@w.Code)</option>
                    }
                </select>
                <div class="form-text">Hàng trả lại sẽ được nhập vào kho này sau khi duyệt.</div>
            </div>
            @{
                var custList = (List<Customer>?)ViewBag.Customers ?? new List<Customer>();
            }
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Chọn từ danh mục KH</label>
                <select class="form-select" onchange="onSelectCustomer(this)">
                    <option value="">— Khách hàng trong danh mục —</option>
                    @foreach (var c in custList)
                    {
                        <option value="@c.Code" data-name="@c.Name">@c.Code — @c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Tên khách hàng *</label>
                <input name="customerName" id="txtCustomerName" class="form-control" placeholder="Tên khách hàng trả..." required />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Mã khách hàng</label>
                <input name="customerCode" id="txtCustomerCode" class="form-control" placeholder="KH-001..." />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Hóa đơn bán gốc</label>
                <input name="invoiceNo" class="form-control" placeholder="HD-2026-..." />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Đơn hàng / Phiếu xuất</label>
                <input name="refOrderNo" class="form-control" placeholder="PX260330-001..." />
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold text-muted">Lý do khách trả hàng</label>
                <input name="reason" class="form-control" placeholder="Khách đổi size, hàng lỗi bao bì, khách trả do không ưng mẫu..." />
            </div>
        </div>
    </div></div>

    <div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h6 class="fw-bold mb-0">Danh sách mặt hàng nhận trả</h6>
                <div class="small text-muted">Chọn mặt hàng, số lượng khách trả và đơn giá hoàn lại.</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addLine()">
                <i class="bi bi-plus-lg me-1"></i>Thêm dòng hàng
            </button>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width:35%">Mặt hàng *</th>
                        <th style="width:10%">ĐVT</th>
                        <th class="text-end" style="width:15%">SL nhận trả *</th>
                        <th class="text-end" style="width:15%">Đơn giá hoàn (đ)</th>
                        <th class="text-end" style="width:15%">Thành tiền</th>
                        <th style="width:15%">Ghi chú lỗi/đổi</th>
                        <th style="width:3%" class="text-center"></th>
                    </tr>
                </thead>
                <tbody id="linesBody">
                    <tr>
                        <td>
                            <select name="productId" class="form-select form-select-sm prod-select" onchange="onProdChange(this)" required>
                                <option value="">— Chọn mặt hàng —</option>
                                @foreach (var p in products)
                                {
                                    <option value="@p.Id" data-code="@p.Code" data-uom="@p.Uom">@p.Name (@p.Code)</option>
                                }
                            </select>
                        </td>
                        <td class="text-muted small uom-cell">—</td>
                        <td>
                            <input type="number" name="qty" class="form-control form-control-sm text-end qty-input" min="1" value="1" required oninput="calcTotals()" />
                        </td>
                        <td>
                            <input type="number" name="unitPrice" class="form-control form-control-sm text-end price-input" min="0" step="1000" value="0" oninput="calcTotals()" />
                        </td>
                        <td class="text-end fw-semibold line-amount">0 đ</td>
                        <td>
                            <input type="text" name="lineNote" class="form-control form-control-sm" placeholder="Ví dụ: Đổi từ size M lên L..." />
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-link btn-sm text-danger p-0" onclick="removeLine(this)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="fw-bold bg-light">
                        <td colspan="2" class="text-end">Tổng cộng:</td>
                        <td class="text-end text-primary" id="totalQtySum">1</td>
                        <td></td>
                        <td class="text-end text-success" id="totalAmountSum">0 đ</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <a href="/CustomerReturn" class="btn btn-sm btn-outline-secondary">Hủy bỏ</a>
            <button type="submit" class="btn btn-sm btn-primary px-4"><i class="bi bi-check-lg me-1"></i>Lập phiếu (Chờ nhận hàng)</button>
        </div>
    </div></div>
</form>

@section Scripts {
<script>
    function onSelectCustomer(sel) {
        var opt = sel.options[sel.selectedIndex];
        if (opt && opt.value) {
            document.getElementById('txtCustomerCode').value = opt.value;
            document.getElementById('txtCustomerName').value = opt.getAttribute('data-name') || '';
        }
    }

    function onProdChange(sel) {
        const row = sel.closest('tr');
        const opt = sel.selectedOptions[0];
        const uomCell = row.querySelector('.uom-cell');
        uomCell.innerText = opt ? (opt.getAttribute('data-uom') || 'cái') : '—';
        calcTotals();
    }

    function removeLine(btn) {
        const tbody = document.getElementById('linesBody');
        if (tbody.children.length <= 1) {
            alert('Phiếu cần ít nhất 1 dòng hàng.');
            return;
        }
        btn.closest('tr').remove();
        calcTotals();
    }

    function addLine() {
        const tbody = document.getElementById('linesBody');
        const first = tbody.querySelector('tr');
        const clone = first.cloneNode(true);
        clone.querySelector('.prod-select').value = '';
        clone.querySelector('.uom-cell').innerText = '—';
        clone.querySelector('.qty-input').value = '1';
        clone.querySelector('.price-input').value = '0';
        clone.querySelector('.line-amount').innerText = '0 đ';
        clone.querySelector('input[name="lineNote"]').value = '';
        tbody.appendChild(clone);
        calcTotals();
    }

    function calcTotals() {
        let totalQty = 0;
        let totalAmount = 0;
        document.querySelectorAll('#linesBody tr').forEach(row => {
            const q = parseInt(row.querySelector('.qty-input').value) || 0;
            const p = parseFloat(row.querySelector('.price-input').value) || 0;
            const amt = q * p;
            row.querySelector('.line-amount').innerText = amt.toLocaleString('vi-VN') + ' đ';
            totalQty += q;
            totalAmount += amt;
        });
        document.getElementById('totalQtySum').innerText = totalQty.toLocaleString('vi-VN');
        document.getElementById('totalAmountSum').innerText = totalAmount.toLocaleString('vi-VN') + ' đ';
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.prod-select').forEach(sel => {
            if (sel.value) onProdChange(sel);
        });
        calcTotals();
    });
</script>
}
