@{
    string Nav(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() == c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniWMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#0891b2; --accent2:#0e7490; --sidebar:#0c1a1f; }
        body { font-size:14px; background:#f1f6f7; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:230px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#67e8f9; }
        .sidebar .nav-link { color:#9db4b9; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(8,145,178,.3); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#48626a; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #e2ebed; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(2,20,24,.07); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); color:#fff; }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #e5e7eb; }
        .stat-num { font-size:26px; font-weight:800; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-hdd-stack"></i> Mini<span>WMS</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan & Báo cáo</div>
            <a class="nav-link @(Nav("Home"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <a class="nav-link @(Nav("Inventory"))" href="/Inventory"><i class="bi bi-clipboard-data"></i> Tồn kho</a>
            <a class="nav-link @(Nav("StockMinimum"))" href="/StockMinimum"><i class="bi bi-shield-exclamation"></i> Cảnh báo tồn tối thiểu</a>
            <a class="nav-link @(Nav("LotExpiry"))" href="/LotExpiry"><i class="bi bi-hourglass-split"></i> Lô & Hạn sử dụng</a>
            <a class="nav-link @(Nav("StockSerial"))" href="/StockSerial"><i class="bi bi-upc-scan"></i> Serial / IMEI</a>
            <a class="nav-link @(Nav("WarehouseCard"))" href="/WarehouseCard"><i class="bi bi-journal-text"></i> Thẻ kho</a>
            <a class="nav-link @(Nav("InventoryInOut"))" href="/InventoryInOut"><i class="bi bi-graph-up-arrow"></i> Nhập - Xuất - Tồn</a>
            <a class="nav-link @(Nav("InventoryValuation"))" href="/InventoryValuation"><i class="bi bi-cash-stack"></i> Đánh giá giá trị tồn</a>
            <a class="nav-link @(Nav("StockExtend"))" href="/StockExtend"><i class="bi bi-layers-half"></i> Tồn kho mở rộng</a>
            <a class="nav-link @(Nav("SummaryMonthly"))" href="/SummaryMonthly"><i class="bi bi-calendar3-range"></i> Ma trận Nhập - Xuất 12T</a>
            <a class="nav-link @(Nav("MapDeliveryOrder"))" href="/MapDeliveryOrder"><i class="bi bi-calendar2-range"></i> Bản đồ lệnh giao hàng</a>
            <a class="nav-link @(Nav("StorageTime"))" href="/StorageTime"><i class="bi bi-clock-history"></i> Báo cáo tuổi kho</a>
            <a class="nav-link @(Nav("CostPrice"))" href="/CostPrice"><i class="bi bi-calculator"></i> Giá vốn kho</a>
            <a class="nav-link @(Nav("PeriodClosing"))" href="/PeriodClosing"><i class="bi bi-calendar-check"></i> Chốt kỳ tồn kho</a>
            <a class="nav-link @(Nav("SummaryInReturnSup"))" href="/SummaryInReturnSup"><i class="bi bi-truck-flatbed"></i> B/C Nhập - Trả NCC</a>
            <a class="nav-link @(Nav("InventoryInDtl"))" href="/InventoryInDtl"><i class="bi bi-box-arrow-in-down-right"></i> B/C Chi tiết nhập kho</a>
            <a class="nav-link @(Nav("InventoryOutDtl"))" href="/InventoryOutDtl"><i class="bi bi-box-arrow-up-right"></i> B/C Chi tiết xuất kho</a>
            <div class="nav-section">Đóng gói & Kiện hàng</div>
            <a class="nav-link @(Nav("Carton"))" href="/Carton"><i class="bi bi-box-seam-fill"></i> Thùng carton / Đóng kiện</a>
            <a class="nav-link @(Nav("Box"))" href="/Box"><i class="bi bi-boxes"></i> Hộp hàng & Đóng hộp</a>
            <div class="nav-section">Phiếu kho</div>
            <a class="nav-link @(Nav("Doc"))" href="/Doc"><i class="bi bi-journals"></i> Danh sách phiếu</a>
            <a class="nav-link" href="/Doc/Create?type=0"><i class="bi bi-box-arrow-in-down"></i> Nhập kho</a>
            <a class="nav-link" href="/Doc/Create?type=1"><i class="bi bi-box-arrow-up"></i> Xuất kho</a>
            <a class="nav-link" href="/Doc/Create?type=2"><i class="bi bi-arrow-left-right"></i> Chuyển kho</a>
            <div class="nav-section">Thành phẩm sản xuất</div>
            <a class="nav-link @(Nav("InventoryInFG"))" href="/InventoryInFG"><i class="bi bi-box-arrow-in-down-right"></i> Nhập thành phẩm SX</a>
            <a class="nav-link @(Nav("InventoryOutFG"))" href="/InventoryOutFG"><i class="bi bi-box-arrow-up-right"></i> Xuất thành phẩm</a>
            <div class="nav-section">Điều chuyển</div>
            <a class="nav-link @(Nav("MoveOrder"))" href="/MoveOrder"><i class="bi bi-shuffle"></i> Lệnh điều chuyển</a>
            <a class="nav-link @(Nav("MoveOrdType"))" href="/MoveOrdType"><i class="bi bi-diagram-3"></i> Loại điều chuyển</a>
            <div class="nav-section">Trả hàng NCC</div>
            <a class="nav-link @(Nav("ReturnSup"))" href="/ReturnSup"><i class="bi bi-arrow-counterclockwise"></i> Trả hàng NCC</a>
            <div class="nav-section">Khách trả hàng</div>
            <a class="nav-link @(Nav("CustomerReturn"))" href="/CustomerReturn"><i class="bi bi-arrow-return-left"></i> Khách trả hàng</a>
            <div class="nav-section">Kiểm kê</div>
            <a class="nav-link @(Nav("Audit"))" href="/Audit"><i class="bi bi-clipboard-check"></i> Kiểm kê kho</a>
            <div class="nav-section">Danh mục</div>
            <a class="nav-link @(Nav("Warehouse"))" href="/Warehouse"><i class="bi bi-building"></i> Kho</a>
            <a class="nav-link @(Nav("Area"))" href="/Area"><i class="bi bi-geo-alt"></i> Vùng & Khu vực kho</a>
            <a class="nav-link @(Nav("UserMapInventory"))" href="/UserMapInventory"><i class="bi bi-person-check-fill"></i> Phân quyền kho</a>
            <a class="nav-link @(Nav("InventoryType"))" href="/InventoryType"><i class="bi bi-diagram-2-fill"></i> Loại kho</a>
            <a class="nav-link @(Nav("InventoryLevelType"))" href="/InventoryLevelType"><i class="bi bi-layers-half"></i> Cấp kho</a>
            <a class="nav-link @(Nav("InventoryInType"))" href="/InventoryInType"><i class="bi bi-box-arrow-in-down-right"></i> Loại nhập kho</a>
            <a class="nav-link @(Nav("InventoryOutType"))" href="/InventoryOutType"><i class="bi bi-box-arrow-up-right"></i> Loại xuất kho</a>
            <a class="nav-link @(Nav("MoveOrdType"))" href="/MoveOrdType"><i class="bi bi-diagram-3"></i> Loại điều chuyển</a>
            <a class="nav-link @(Nav("InventoryBlock"))" href="/InventoryBlock"><i class="bi bi-grid-3x3-gap"></i> Vị trí kho (Kệ/Ô)</a>
            <a class="nav-link @(Nav("Brand"))" href="/Brand"><i class="bi bi-award"></i> Thương hiệu</a>
            <a class="nav-link @(Nav("ProductGroup"))" href="/ProductGroup"><i class="bi bi-collection"></i> Nhóm hàng hóa</a>
            <a class="nav-link @(Nav("ProductModel"))" href="/ProductModel"><i class="bi bi-diagram-3"></i> Dòng sản phẩm (Model)</a>
            <a class="nav-link @(Nav("PartType"))" href="/PartType"><i class="bi bi-tags"></i> Loại mặt hàng</a>
            <a class="nav-link @(Nav("PartMaterialType"))" href="/PartMaterialType"><i class="bi bi-palette2"></i> Nhóm chất liệu</a>
            <a class="nav-link @(Nav("PartUnit"))" href="/PartUnit"><i class="bi bi-rulers"></i> Đơn vị tính</a>
            <a class="nav-link @(Nav("Product"))" href="/Product"><i class="bi bi-box-seam"></i> Mặt hàng</a>
            <a class="nav-link @(Nav("Supplier"))" href="/Supplier"><i class="bi bi-people-fill"></i> Nhà cung cấp</a>
            <a class="nav-link @(Nav("Dealer"))" href="/Dealer"><i class="bi bi-shop"></i> Đại lý phân phối</a>
            <a class="nav-link @(Nav("Customer"))" href="/Customer"><i class="bi bi-person-badge"></i> Khách hàng / Đại lý</a>
            <a class="nav-link @(Nav("CustomerGroup"))" href="/CustomerGroup"><i class="bi bi-person-lines-fill"></i> Nhóm khách hàng</a>
            <a class="nav-link @(Nav("CustomerSource"))" href="/CustomerSource"><i class="bi bi-diagram-3"></i> Nguồn khách hàng</a>
            <a class="nav-link @(Nav("Department"))" href="/Department"><i class="bi bi-diagram-3-fill"></i> Bộ phận / Phòng ban</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Org"))" href="/Org"><i class="bi bi-diagram-2"></i> Tổ chức</a>
        </div>
        <div class="mt-auto p-3" style="color:#48626a;font-size:11px">Bản đồ lệnh giao hàng · Đại lý phân phối · Nguồn khách hàng · Bộ phận / Phòng ban · Nhóm khách hàng · Vùng & Khu vực kho · Nhóm hàng hóa · Phân quyền kho · Cấp kho · Loại xuất kho · Loại nhập kho · Loại kho · Dòng sản phẩm (Model) · Nhóm chất liệu · Đơn vị tính · Thương hiệu · Loại mặt hàng · Khách hàng / Đại lý · Định giá tồn kho · Tồn kho mở rộng · Ma trận 12T · Chi tiết nhập kho · Chi tiết xuất kho · Nhập - Trả NCC · Nhà cung cấp · Hộp đóng gói · Thùng carton · Xuất thành phẩm · Nhập thành phẩm · Chốt kỳ kho · Giá vốn · NXT · Serial/IMEI · Vị trí kho · Tuổi kho · Lô & Hạn dùng · Cảnh báo tồn · Thẻ kho · Điều chuyển · Trả NCC · Khách trả · Kiểm kê</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-building me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo WMS")</a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
