</div>

<!-- Modal Tổng hợp tình trạng phân công theo kho -->
<div class="modal fade" id="warehouseSummaryModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold"><i class="bi bi-buildings text-info me-2"></i>Tổng hợp Tình trạng Phân công Nhân sự theo Kho</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 50px;">STT</th>
                                <th style="width: 140px;">Mã kho</th>
                                <th>Tên kho hàng</th>
                                <th class="text-center" style="width: 130px;">Số thủ kho</th>
                                <th>Danh sách nhân sự đang phụ trách</th>
                                <th class="text-end pe-3" style="width: 100px;">Lọc kho</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int sumIdx = 1;
                            }
                            @foreach (var s in summaries)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@(sumIdx++)</td>
                                    <td><code class="fw-bold">@s.WarehouseCode</code></td>
                                    <td class="fw-semibold">@s.WarehouseName</td>
                                    <td class="text-center">
                                        @if (s.AssignedUsersCount > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">@s.AssignedUsersCount nhân sự</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Chưa phân công</span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.AssignedUserNames.Count > 0)
                                        {
                                            <div class="d-flex gap-1 flex-wrap">
                                                @foreach (var un in s.AssignedUserNames)
                                                {
                                                    <span class="badge bg-light text-dark border small">@un</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>Cần bổ nhiệm thủ kho phụ trách</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <a href="/UserMapInventory?warehouseId=@s.WarehouseId" class="btn btn-sm btn-outline-primary py-0 px-2" title="Xem phân quyền kho này">
                                            <i class="bi bi-arrow-right-short"></i> Xem
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditModal(id, userName, userRole, email, phone, remark, isActive) {
        document.getElementById('editId').value = id;
        document.getElementById('editUserName').value = userName;
        document.getElementById('editUserRole').value = userRole;
        document.getElementById('editEmail').value = email;
        document.getElementById('editPhone').value = phone;
        document.getElementById('editRemark').value = remark;
        document.getElementById('editIsActive').checked = isActive;

        var modal = new bootstrap.Modal(document.getElementById('editUserMapModal'));
        modal.show();
    }

    function toggleAllBatch(source) {
        var checkboxes = document.querySelectorAll('.batch-user-cb');
        for (var i = 0; i < checkboxes.length; i++) {
            checkboxes[i].checked = source.checked;
        }
    }
</script>
}
