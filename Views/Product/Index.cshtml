@model List<Product>
@{
    ViewData["Title"] = "Mặt hàng";
    var partTypes = ViewBag.PartTypes as List<PartType> ?? [];
    var brands = ViewBag.Brands as List<Brand> ?? [];
}
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm mặt hàng</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên hàng *" required /></div>
            <div class="mb-2"><input name="code" class="form-control" placeholder="Mã (tự sinh)" /></div>
            <div class="mb-2">
                <select name="partTypeCode" class="form-select">
                    <option value="">-- Chọn loại mặt hàng (Mst_PartType) --</option>
                    @foreach (var pt in partTypes)
                    {
                        <option value="@pt.Code">@pt.Code — @pt.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <select name="brandCode" class="form-select">
                    <option value="">-- Chọn thương hiệu (Mst_Brand) --</option>
                    @foreach (var b in brands)
                    {
                        <option value="@b.Code">@b.Code — @b.Name</option>
                    }
                </select>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-12"><input name="uom" class="form-control" placeholder="ĐVT" value="cái" /></div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6"><input name="minStock" type="number" class="form-control" placeholder="Tồn tối thiểu (Min)" value="0" /></div>
                <div class="col-6"><input name="maxStock" type="number" class="form-control" placeholder="Tồn tối đa (Max)" value="0" /></div>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo mặt hàng</button>
        </form>
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle"><thead><tr><th>Mã</th><th>Tên</th><th>Loại hàng</th><th>Thương hiệu</th><th>ĐVT</th><th class="text-end">Tồn Min</th><th class="text-end">Tồn Max</th></tr></thead><tbody>
        @foreach (var p in Model) {
            <tr>
                <td class="fw-semibold">@p.Code</td>
                <td>@p.Name</td>
                <td>
                    @if (!string.IsNullOrEmpty(p.PartTypeCode)) {
                        <span class="badge bg-info-subtle text-info border border-info-subtle">@p.PartTypeCode</span>
                    } else {
                        <span class="text-muted small">—</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(p.BrandCode)) {
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">@p.BrandCode</span>
                    } else {
                        <span class="text-muted small">—</span>
                    }
                </td>
                <td>@p.Uom</td>
                <td class="text-end text-muted">@(p.MinStock > 0 ? p.MinStock.ToString() : "—")</td>
                <td class="text-end text-muted">@(p.MaxStock > 0 ? p.MaxStock.ToString() : "—")</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có mặt hàng.</td></tr> }
        </tbody></table>
    </div></div></div>
</div>
