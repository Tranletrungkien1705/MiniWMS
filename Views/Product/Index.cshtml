@model List<Product>
@{ ViewData["Title"] = "Mặt hàng"; }
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm mặt hàng</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên hàng *" required /></div>
            <div class="mb-2"><input name="code" class="form-control" placeholder="Mã (tự sinh)" /></div>
            <div class="row g-2 mb-3">
                <div class="col-6"><input name="uom" class="form-control" placeholder="ĐVT" value="cái" /></div>
                <div class="col-6"><input name="minStock" type="number" class="form-control" placeholder="Định mức" value="0" /></div>
            </div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo mặt hàng</button>
        </form>
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle"><thead><tr><th>Mã</th><th>Tên</th><th>ĐVT</th><th class="text-end">Định mức</th></tr></thead><tbody>
        @foreach (var p in Model) { <tr><td class="fw-semibold">@p.Code</td><td>@p.Name</td><td>@p.Uom</td><td class="text-end text-muted">@(p.MinStock > 0 ? p.MinStock.ToString() : "—")</td></tr> }
        @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có mặt hàng.</td></tr> }
        </tbody></table>
    </div></div></div>
</div>
