@model List<StockDoc>
@{ ViewData["Title"] = "Phiếu kho"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div class="btn-group btn-group-sm">
            <a href="/Doc" class="btn btn-outline-primary">Tất cả</a>
            <a href="/Doc?type=0" class="btn btn-outline-primary">Nhập</a>
            <a href="/Doc?type=1" class="btn btn-outline-primary">Xuất</a>
            <a href="/Doc?type=2" class="btn btn-outline-primary">Chuyển</a>
        </div>
        <div class="btn-group btn-group-sm">
            <a href="/Doc/Create?type=0" class="btn btn-primary">+ Nhập</a>
            <a href="/Doc/Create?type=1" class="btn btn-primary">+ Xuất</a>
            <a href="/Doc/Create?type=2" class="btn btn-primary">+ Chuyển</a>
        </div>
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>Số phiếu</th><th>Loại</th><th>Từ kho</th><th>Đến kho</th><th class="text-end">SL</th><th>Ngày</th><th>TT</th></tr></thead>
        <tbody>
        @foreach (var d in Model)
        {
            var (tt, tcss) = Ui.DocTypeBadge(d.Type);
            var (st, scss) = Ui.StatusBadge(d.Status);
            <tr style="cursor:pointer" onclick="location.href='/Doc/Detail/@d.Id'">
                <td class="fw-semibold">@d.Code</td><td><span class="badge bg-@tcss">@tt</span></td>
                <td class="small">@(d.FromWarehouse?.Name ?? "—")</td><td class="small">@(d.ToWarehouse?.Name ?? "—")</td>
                <td class="text-end">@d.TotalQty</td><td class="small text-muted">@d.Date.ToString("dd/MM/yyyy")</td>
                <td><span class="badge bg-@scss">@st</span></td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Không có phiếu.</td></tr> }
        </tbody>
    </table>
</div></div>
