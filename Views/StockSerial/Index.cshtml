@model StockSerialReport
@{
    ViewData["Title"] = "Quản lý & Tra cứu Serial / IMEI hàng hóa";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var prods = (List<Product>)ViewBag.Products;
    var selectedWid = (int?)ViewBag.WarehouseId;
    var selectedPid = (int?)ViewBag.ProductId;
    var selectedStatus = (StockSerialStatus?)ViewBag.Status;
    var keyword = (string)ViewBag.Keyword;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Kho lưu trữ</label>
                <select name="warehouseId" class="form-select form-select-sm">
                    <option value="">— Tất cả kho —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Mặt hàng</label>
                <select name="productId" class="form-select form-select-sm">
                    <option value="">— Tất cả mặt hàng —</option>
                    @foreach (var p in prods)
                    {
                        <option value="@p.Id" selected="@(selectedPid == p.Id)">@p.Code — @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Trạng thái Serial</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">— Tất cả —</option>
                    <option value="@((int)StockSerialStatus.Available)" selected="@(selectedStatus == StockSerialStatus.Available)">Khả dụng / Sẵn sàng</option>
                    <option value="@((int)StockSerialStatus.Locked)" selected="@(selectedStatus == StockSerialStatus.Locked)">Tạm khóa / Giữ hàng</option>
                    <option value="@((int)StockSerialStatus.DamagedNG)" selected="@(selectedStatus == StockSerialStatus.DamagedNG)">Lỗi hỏng / NG</option>
                    <option value="@((int)StockSerialStatus.Exported)" selected="@(selectedStatus == StockSerialStatus.Exported)">Đã xuất kho</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Tìm kiếm Serial</label>
                <input type="text" name="q" value="@keyword" placeholder="Mã Serial, Lô, CT..." class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill" title="Lọc dữ liệu">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                <a href="/StockSerial" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
                <a href="/StockSerial/ExportCsv?warehouseId=@selectedWid&productId=@selectedPid&status=@(selectedStatus.HasValue ? (int)selectedStatus.Value : "")&q=@Uri.EscapeDataString(keyword ?? "")"
                   class="btn btn-sm btn-outline-success" title="Xuất file CSV / Excel">
                    <i class="bi bi-file-earmark-excel"></i>
                </a>
                <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark" title="In danh sách">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG SỐ SERIAL</span>
                    <i class="bi bi-upc-scan text-primary fs-5"></i>
                </div>
                <div class="stat-num text-primary">@Model.TotalSerials.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">Tổng số mã Serial/IMEI trong hệ thống</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">KHẢ DỤNG / SẴN SÀNG</span>
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                </div>
                <div class="stat-num text-success">@Model.AvailableCount.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">Hàng trong kho, đủ điều kiện xuất bán</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TẠM KHÓA / GIỮ HÀNG</span>
                    <i class="bi bi-lock-fill text-warning fs-5"></i>
                </div>
                <div class="stat-num text-warning">@Model.LockedCount.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">Khóa giữ đơn / chờ duyệt giao hàng</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">LỖI HỎNG / BẢO HÀNH (NG)</span>
                    <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
                </div>
                <div class="stat-num text-danger">@Model.DamagedNGCount.ToString("N0")</div>
                <div class="text-muted" style="font-size:11px">Cần thẩm định lỗi hoặc trả về NCC</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <h6 class="mb-0 fw-bold"><i class="bi bi-upc-scan text-primary me-2"></i>Chi tiết Danh sách Serial / IMEI Hàng Hóa Tồn Kho</h6>
            <span class="text-muted small">Kho: <b>@Model.WarehouseName</b> — Mặt hàng: <b>@Model.ProductName</b> — Hiển thị <b>@Model.Rows.Count</b> Serial</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createSerialModal">
                <i class="bi bi-plus-circle me-1"></i> Đăng ký Serial mới
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width:40px">#</th>
                        <th>Mã Serial / IMEI</th>
                        <th>Kho hàng</th>
                        <th>Mã hàng</th>
                        <th>Tên hàng hoá</th>
                        <th>ĐVT</th>
                        <th>Số Lô (Lot)</th>
                        <th class="text-center">Ngày nhập</th>
                        <th class="text-center">Ngày xuất</th>
                        <th>Số chứng từ</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Ghi chú</th>
                        <th class="text-end" style="width:130px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count > 0)
                    {
                        int stt = 1;
                        foreach (var r in Model.Rows)
                        {
                            var rowClass = r.Status switch
                            {
                                StockSerialStatus.DamagedNG => "table-danger",
                                StockSerialStatus.Locked => "table-warning",
                                StockSerialStatus.Exported => "table-light text-muted",
                                _ => ""
                            };

                            <tr class="@rowClass">
                                <td class="text-center text-muted small">@(stt++)</td>
                                <td>
                                    <span class="font-monospace fw-bold text-dark px-2 py-1 rounded bg-light border">
                                        <i class="bi bi-upc me-1 text-muted"></i>@r.SerialNo
                                    </span>
                                </td>
                                <td><i class="bi bi-building me-1 text-muted"></i>@r.WarehouseName</td>
                                <td class="fw-semibold">
                                    <a href="/WarehouseCard?productId=@r.ProductId&warehouseId=@r.WarehouseId" class="text-decoration-none">
                                        @r.ProductCode
                                    </a>
                                </td>
                                <td>@r.ProductName</td>
                                <td><span class="badge bg-light text-dark border">@r.Uom</span></td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.LotNo))
                                    {
                                        <span class="badge bg-dark-subtle text-dark border font-monospace">@r.LotNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center text-muted small">@r.InDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-center text-muted small">
                                    @(r.OutDate.HasValue ? r.OutDate.Value.ToString("dd/MM/yyyy") : "—")
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.RefNo))
                                    {
                                        <span class="badge bg-light text-dark border">@r.RefNo</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @r.BadgeClass px-2 py-1">@r.StatusLabel</span>
                                </td>
                                <td class="small text-muted" style="max-width:200px">@(r.Note ?? "—")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                            onclick="openChangeStatusModal(@r.Id, '@r.SerialNo', @((int)r.Status), '@(r.Note?.Replace("'", "\\'") ?? "")')">
                                        <i class="bi bi-arrow-repeat me-1"></i>Đổi TT
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                Không có mã Serial/IMEI nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Rows.Count > 0)
    {
        <div class="card-footer bg-white py-2 text-muted small d-flex justify-content-between align-items-center">
            <span>Hiển thị <b>@Model.Rows.Count</b> / @Model.TotalSerials serial</span>
            <span>Khả dụng: <b>@Model.AvailableCount</b> | Đang khóa: <b>@Model.LockedCount</b> | Lỗi NG: <b>@Model.DamagedNGCount</b> | Đã xuất: <b>@Model.ExportedCount</b></span>
        </div>
    }
</div>

<!-- Modal Đăng ký Serial mới -->
<div class="modal fade" id="createSerialModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/StockSerial/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Đăng ký Serial / IMEI Mới</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Kho lưu trữ <span class="text-danger">*</span></label>
                        <select name="warehouseId" class="form-select" required>
                            <option value="">— Chọn kho hàng —</option>
                            @foreach (var w in whs)
                            {
                                <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name (@w.Code)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mặt hàng áp dụng <span class="text-danger">*</span></label>
                        <select name="productId" class="form-select" required>
                            <option value="">— Chọn mặt hàng —</option>
                            @foreach (var p in prods)
                            {
                                <option value="@p.Id" selected="@(selectedPid == p.Id)">@p.Code — @p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã Serial / IMEI / Barcode <span class="text-danger">*</span></label>
                        <input type="text" name="serialNo" class="form-control font-monospace" placeholder="VD: SN-AO26-0099" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Số Lô sản xuất (Lot)</label>
                            <input type="text" name="lotNo" class="form-control font-monospace" placeholder="VD: LOT-AO26-01" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-muted">Số chứng từ / Phiếu kho</label>
                            <input type="text" name="refNo" class="form-control" placeholder="VD: PN260330-001" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Ghi chú kiểm định / vị trí</label>
                        <textarea name="note" class="form-control" rows="2" placeholder="Ghi chú tình trạng, vị trí khay kệ..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-save me-1"></i> Lưu đăng ký</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Cập nhật trạng thái Serial -->
<div class="modal fade" id="changeStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="/StockSerial/ChangeStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalSerialId" />
                <input type="hidden" name="warehouseId" value="@selectedWid" />
                <input type="hidden" name="productId" value="@selectedPid" />
                <input type="hidden" name="filterStatus" value="@(selectedStatus.HasValue ? (int)selectedStatus.Value : "")" />
                <input type="hidden" name="q" value="@keyword" />

                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-arrow-repeat text-primary me-2"></i>Cập nhật Trạng thái Serial</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-light border mb-3 py-2">
                        <span class="text-muted small">Đang cập nhật Serial:</span>
                        <div class="fw-bold font-monospace fs-6" id="modalSerialNo"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Trạng thái mới <span class="text-danger">*</span></label>
                        <select name="status" id="modalSerialStatus" class="form-select" required>
                            <option value="@((int)StockSerialStatus.Available)">Khả dụng / Sẵn sàng xuất bán (Available)</option>
                            <option value="@((int)StockSerialStatus.Locked)">Tạm khóa / Giữ hàng theo đơn (Locked)</option>
                            <option value="@((int)StockSerialStatus.DamagedNG)">Báo lỗi hỏng / Thẩm định bảo hành (Damaged NG)</option>
                            <option value="@((int)StockSerialStatus.Exported)">Đã xuất kho (Exported)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Ghi chú bổ sung lý do thay đổi</label>
                        <textarea name="note" id="modalSerialNote" class="form-control" rows="2" placeholder="Nhập lý do đổi trạng thái (VD: Khóa giữ cho đơn VIP, Báo lỗi mạ kim loại...)"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check2-circle me-1"></i> Cập nhật trạng thái</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openChangeStatusModal(id, serialNo, status, note) {
        document.getElementById('modalSerialId').value = id;
        document.getElementById('modalSerialNo').textContent = serialNo;
        document.getElementById('modalSerialStatus').value = status;
        document.getElementById('modalSerialNote').value = '';
        var modal = new bootstrap.Modal(document.getElementById('changeStatusModal'));
        modal.show();
    }
</script>
}
