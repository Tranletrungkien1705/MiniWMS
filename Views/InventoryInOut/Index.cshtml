@model InventoryInOutReport
@{
    ViewData["Title"] = "Báo cáo Nhập - Xuất - Tồn";
    var whs = (List<Warehouse>)ViewBag.Warehouses;
    var selectedWid = (int?)ViewBag.WarehouseId;
    var fromDate = (string)ViewBag.FromDate;
    var toDate = (string)ViewBag.ToDate;
    var keyword = (string)ViewBag.Keyword;
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" id="filterForm" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Kho hàng</label>
                <select name="warehouseId" class="form-select form-select-sm">
                    <option value="">— Tất cả kho —</option>
                    @foreach (var w in whs)
                    {
                        <option value="@w.Id" selected="@(selectedWid == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Từ ngày <span class="text-danger">*</span></label>
                <input type="date" id="inputFromDate" name="fromDate" value="@fromDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Đến ngày <span class="text-danger">*</span></label>
                <input type="date" id="inputToDate" name="toDate" value="@toDate" class="form-control form-control-sm" required />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Tìm mặt hàng</label>
                <input type="text" name="q" value="@keyword" placeholder="Mã hoặc tên..." class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i> Lọc báo cáo
                </button>
                <a href="/InventoryInOut" class="btn btn-sm btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
                <a href="/InventoryInOut/ExportCsv?warehouseId=@selectedWid&fromDate=@fromDate&toDate=@toDate&q=@Uri.EscapeDataString(keyword ?? "")" 
                   class="btn btn-sm btn-outline-success" title="Xuất file CSV / Excel">
                    <i class="bi bi-file-earmark-excel"></i> Xuất
                </a>
                <button type="button" onclick="window.print()" class="btn btn-sm btn-outline-dark" title="In báo cáo">
                    <i class="bi bi-printer"></i>
                </button>
            </div>
            <div class="col-12 mt-2 pt-1 border-top d-flex gap-2 align-items-center flex-wrap">
                <span class="small text-muted me-1">Chọn nhanh kỳ:</span>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('today')">Hôm nay</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('last7days')">7 ngày qua</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('thisMonth')">Tháng này</button>
                <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" onclick="setPeriod('lastMonth')">Tháng trước</button>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỒN ĐẦU KỲ</span>
                    <i class="bi bi-archive text-secondary fs-5"></i>
                </div>
                <div class="stat-num text-secondary">@Model.TotalOpeningQty.ToString("N0")</div>
                <div class="small text-muted">Trước ngày @Model.FromDate.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG NHẬP TRONG KỲ</span>
                    <i class="bi bi-box-arrow-in-down text-success fs-5"></i>
                </div>
                <div class="stat-num text-success">+@Model.TotalInQty.ToString("N0")</div>
                <div class="small text-muted">Nhập kho, nhận chuyển, khách trả</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG XUẤT TRONG KỲ</span>
                    <i class="bi bi-box-arrow-up text-danger fs-5"></i>
                </div>
                <div class="stat-num text-danger">-@Model.TotalOutQty.ToString("N0")</div>
                <div class="small text-muted">Xuất bán, trả NCC, xuất chuyển</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100 border-0 bg-white">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỒN CUỐI KỲ</span>
                    <i class="bi bi-boxes text-primary fs-5"></i>
                </div>
                <div class="stat-num text-primary">@Model.TotalClosingQty.ToString("N0")</div>
                <div class="small text-muted">Tại ngày @Model.ToDate.ToString("dd/MM/yyyy")</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold fs-6"><i class="bi bi-table me-2 text-primary"></i>Biến động Nhập - Xuất - Tồn</span>
            <span class="badge bg-light text-dark border">@Model.Rows.Count dòng</span>
        </div>
        <div class="small text-muted">
            <i class="bi bi-building me-1"></i>Kho: <strong class="text-dark">@Model.WarehouseName</strong>
            <span class="ms-3"><i class="bi bi-calendar3 me-1"></i>Từ: <strong class="text-dark">@Model.FromDate.ToString("dd/MM/yyyy")</strong> đến <strong class="text-dark">@Model.ToDate.ToString("dd/MM/yyyy")</strong></span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:45px">#</th>
                    <th style="width:110px">Mã hàng</th>
                    <th>Tên hàng hoá</th>
                    <th class="text-center" style="width:70px">ĐVT</th>
                    <th style="width:150px">Kho</th>
                    <th class="text-end text-secondary" style="width:110px">Tồn đầu kỳ</th>
                    <th class="text-end text-success" style="width:110px">Nhập trong kỳ</th>
                    <th class="text-end text-danger" style="width:110px">Xuất trong kỳ</th>
                    <th class="text-end text-primary" style="width:110px">Tồn cuối kỳ</th>
                    <th class="text-end" style="width:100px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count > 0)
            {
                int stt = 1;
                foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="text-center text-muted small">@(stt++)</td>
                        <td><span class="badge bg-light text-dark border fw-medium">@r.ProductCode</span></td>
                        <td class="fw-semibold">@r.ProductName</td>
                        <td class="text-center text-muted small">@r.Uom</td>
                        <td><i class="bi bi-building text-muted me-1"></i>@r.WarehouseName</td>
                        <td class="text-end fw-semibold text-secondary">@r.OpeningQty.ToString("N0")</td>
                        <td class="text-end fw-semibold text-success">
                            @(r.InQty > 0 ? $"+{r.InQty:N0}" : "0")
                        </td>
                        <td class="text-end fw-semibold text-danger">
                            @(r.OutQty > 0 ? $"-{r.OutQty:N0}" : "0")
                        </td>
                        <td class="text-end fw-bold text-primary">@r.ClosingQty.ToString("N0")</td>
                        <td class="text-end">
                            <a href="/WarehouseCard?productId=@r.ProductId&warehouseId=@r.WarehouseId&fromDate=@Model.FromDate.ToString("yyyy-MM-dd")&toDate=@Model.ToDate.ToString("yyyy-MM-dd")"
                               class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size:12px" title="Xem chi tiết Thẻ kho">
                                <i class="bi bi-journal-text me-1"></i>Thẻ kho
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                        Không có biến động hoặc tồn kho nào phù hợp với bộ lọc trong khoảng thời gian đã chọn.
                    </td>
                </tr>
            }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot class="table-group-divider fw-bold bg-light">
                    <tr>
                        <td colspan="5" class="text-end text-uppercase small">Tổng cộng:</td>
                        <td class="text-end text-secondary">@Model.TotalOpeningQty.ToString("N0")</td>
                        <td class="text-end text-success">+@Model.TotalInQty.ToString("N0")</td>
                        <td class="text-end text-danger">-@Model.TotalOutQty.ToString("N0")</td>
                        <td class="text-end text-primary">@Model.TotalClosingQty.ToString("N0")</td>
                        <td></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>

<script>
    function formatDate(d) {
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
    }

    function setPeriod(type) {
        const today = new Date();
        const fromInput = document.getElementById('inputFromDate');
        const toInput = document.getElementById('inputToDate');
        
        if (type === 'today') {
            fromInput.value = formatDate(today);
            toInput.value = formatDate(today);
        } else if (type === 'last7days') {
            const past7 = new Date();
            past7.setDate(today.getDate() - 6);
            fromInput.value = formatDate(past7);
            toInput.value = formatDate(today);
        } else if (type === 'thisMonth') {
            const firstDay = new Date(today.getFullYear(), today.getMonth(), 1);
            fromInput.value = formatDate(firstDay);
            toInput.value = formatDate(today);
        } else if (type === 'lastMonth') {
            const firstDayLastMonth = new Date(today.getFullYear(), today.getMonth() - 1, 1);
            const lastDayLastMonth = new Date(today.getFullYear(), today.getMonth(), 0);
            fromInput.value = formatDate(firstDayLastMonth);
            toInput.value = formatDate(lastDayLastMonth);
        }
        document.getElementById('filterForm').submit();
    }
</script>
