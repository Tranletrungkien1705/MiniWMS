@model ProductSpecReport
@{
    ViewData["Title"] = "Quy cách sản phẩm";
    var keyword = (string)(ViewBag.Keyword ?? "");
    var modelCodeFilter = (string)(ViewBag.ModelCode ?? "");
    var specType1Filter = (string)(ViewBag.SpecType1 ?? "");
    var hasSerialFilter = (bool?)ViewBag.HasSerial;
    var hasLotFilter = (bool?)ViewBag.HasLot;
    var activeOnly = (bool?)ViewBag.ActiveOnly;
    var models = ViewBag.Models as List<ProductModel> ?? [];
    var units = ViewBag.Units as List<PartUnit> ?? [];
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1"><i class="bi bi-card-checklist text-primary me-2"></i>Danh mục Quy cách & Thuộc tính Kỹ thuật Sản phẩm Kho</h5>
        <div class="text-muted small">Port từ <code>OS_PrdCenter_Mst_Spec</code> / <code>Mst_Spec</code> (Skycic) — Quản lý phân định quy cách sản phẩm (SpecCode, SpecName, SpecDesc, ModelCode, SpecType1, Color, StandardUnitCode), cờ bắt buộc quản lý Serial/IMEI, cờ quản lý Lô sản xuất & Hạn sử dụng, theo dõi số lượng mặt hàng và tổng tồn kho thực tế</div>
    </div>
    <div class="d-flex gap-2">
        <a href="/ProductSpec/ExportCsv?q=@keyword&modelCode=@modelCodeFilter&specType1=@specType1Filter&hasSerial=@hasSerialFilter&hasLot=@hasLotFilter&activeOnly=@activeOnly" class="btn btn-sm btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất CSV
        </a>
        <a href="/ProductModel" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-diagram-3 me-1"></i> Dòng Model
        </a>
        <a href="/PartUnit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-rulers me-1"></i> Đơn vị tính
        </a>
        <a href="/Product" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-seam me-1"></i> Mặt hàng
        </a>
        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createSpecModal">
            <i class="bi bi-plus-lg me-1"></i> Thêm Quy cách
        </button>
    </div>
</div>

<!-- 4 Thẻ thống kê KPI -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">TỔNG SỐ QUY CÁCH</span>
                    <i class="bi bi-card-checklist text-primary fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalSpecs</div>
                <div class="small text-muted">Quy cách kỹ thuật thiết lập trong hệ thống</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">ĐANG ÁP DỤNG</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-success">@Model.ActiveCount</div>
                <div class="small text-muted">Khả dụng phân loại và kiểm soát xuất nhập</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">QUẢN LÝ SERIAL / IMEI</span>
                    <i class="bi bi-upc-scan text-info fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-info">@Model.HasSerialCount</div>
                <div class="small text-muted">Bắt buộc quét mã Serial khi xuất nhập kho</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 bg-white shadow-sm">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-semibold">QUẢN LÝ LÔ & HẠN DÙNG</span>
                    <i class="bi bi-calendar-event text-warning fs-5"></i>
                </div>
                <div class="fs-4 fw-bold text-warning">@Model.HasLotCount</div>
                <div class="small text-muted">Bắt buộc theo dõi số Lô và HSD FEFO/FIFO</div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 bg-white shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="q" value="@keyword" class="form-control border-start-0" placeholder="Mã, tên quy cách, màu, thông số..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="modelCode" class="form-select form-select-sm">
                    <option value="">-- Dòng Model --</option>
                    @foreach (var m in models)
                    {
                        <!option value="@m.Code" @(string.Equals(modelCodeFilter, m.Code, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@m.Code — @m.Name</!option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="specType1" class="form-select form-select-sm">
                    <option value="">-- Phân loại cấp 1 --</option>
                    <!option value="Tiêu chuẩn" @(specType1Filter == "Tiêu chuẩn" ? "selected" : "")>Tiêu chuẩn</!option>
                    <!option value="Cao cấp" @(specType1Filter == "Cao cấp" ? "selected" : "")>Cao cấp</!option>
                    <!option value="Công nghiệp" @(specType1Filter == "Công nghiệp" ? "selected" : "")>Công nghiệp</!option>
                    <!option value="Xuất khẩu" @(specType1Filter == "Xuất khẩu" ? "selected" : "")>Xuất khẩu</!option>
                </select>
            </div>
            <div class="col-md-1">
                <select name="hasSerial" class="form-select form-select-sm" title="Quản lý Serial">
                    <option value="">-- Serial --</option>
                    <!option value="true" @(hasSerialFilter == true ? "selected" : "")>Có Serial</!option>
                    <!option value="false" @(hasSerialFilter == false ? "selected" : "")>K.Serial</!option>
                </select>
            </div>
            <div class="col-md-1">
                <select name="hasLot" class="form-select form-select-sm" title="Quản lý Lô & HSD">
                    <option value="">-- Lô/Date --</option>
                    <!option value="true" @(hasLotFilter == true ? "selected" : "")>Có Lô</!option>
                    <!option value="false" @(hasLotFilter == false ? "selected" : "")>K.Lô</!option>
                </select>
            </div>
            <div class="col-md-1">
                <select name="activeOnly" class="form-select form-select-sm" title="Trạng thái">
                    <option value="">-- Trạng thái --</option>
                    <!option value="true" @(activeOnly == true ? "selected" : "")>Áp dụng</!option>
                    <!option value="false" @(activeOnly == false ? "selected" : "")>Tạm dừng</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a href="/ProductSpec" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Quy cách sản phẩm -->
<div class="card border-0 bg-white shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 45px;">STT</th>
                        <th style="width: 170px;">Mã quy cách</th>
                        <th>Tên quy cách / Phiên bản</th>
                        <th style="width: 160px;">Dòng Model</th>
                        <th style="width: 110px;">Phân loại</th>
                        <th style="width: 140px;">Màu sắc</th>
                        <th class="text-center" style="width: 80px;">ĐVT</th>
                        <th class="text-center" style="width: 95px;">QL Serial</th>
                        <th class="text-center" style="width: 95px;">QL Lô/Date</th>
                        <th class="text-center" style="width: 95px;">Mặt hàng</th>
                        <th class="text-end" style="width: 105px;">Tồn kho</th>
                        <th class="text-center" style="width: 105px;">Trạng thái</th>
                        <th class="text-end pe-3" style="width: 135px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr>
                            <td colspan="13" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy quy cách sản phẩm nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="ps-3 text-muted">@stt</td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace fw-semibold">@r.Code</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@r.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(r.SpecDesc))
                                    {
                                        <div class="text-muted small" title="@r.SpecDesc" style="max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <i class="bi bi-info-circle me-1"></i>@r.SpecDesc
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.ModelName))
                                    {
                                        <div class="small fw-semibold text-primary">@r.ModelName</div>
                                        <div class="text-muted small font-monospace">@r.ModelCode @(!string.IsNullOrEmpty(r.BrandName) ? $"({r.BrandName})" : "")</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(r.ModelCode))
                                    {
                                        <span class="badge bg-light text-secondary font-monospace">@r.ModelCode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.SpecType1))
                                    {
                                        var badgeColor = r.SpecType1 switch
                                        {
                                            "Cao cấp" => "bg-danger text-white",
                                            "Xuất khẩu" => "bg-success text-white",
                                            "Công nghiệp" => "bg-warning text-dark",
                                            _ => "bg-primary text-white"
                                        };
                                        <span class="badge @badgeColor">@r.SpecType1</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.Color))
                                    {
                                        <span class="small text-dark"><i class="bi bi-circle-fill text-secondary me-1" style="font-size: 8px;"></i>@r.Color</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                                <td class="text-center small">
                                    <span class="badge bg-light text-dark border">@(r.StandardUnitCode ?? "cái")</span>
                                </td>
                                <td class="text-center">
                                    @if (r.FlagHasSerial)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info" title="Bắt buộc quét mã Serial khi xuất nhập">
                                            <i class="bi bi-upc me-1"></i>Có
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-dash"></i></span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.FlagHasLOT)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning" title="Bắt buộc quản lý Lô & HSD FEFO">
                                            <i class="bi bi-calendar-check me-1"></i>Có
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-dash"></i></span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.ProductCount > 0)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold">@r.ProductCount SP</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (r.TotalStockQty > 0)
                                    {
                                        <span class="fw-bold text-success">@r.TotalStockQty.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">Đang áp dụng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Tạm dừng</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-info" title="Xem chi tiết" onclick="showSpecDetail(@r.Id)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" title="Sửa quy cách" onclick="openEditSpecModal(@r.Id, '@r.Code', '@Html.Raw(Html.Encode(r.Name))', '@Html.Raw(Html.Encode(r.SpecDesc ?? ""))', '@(r.ModelCode ?? "")', '@(r.SpecType1 ?? "")', '@Html.Raw(Html.Encode(r.Color ?? ""))', '@(r.StandardUnitCode ?? "cái")', @(r.FlagHasSerial ? "true" : "false"), @(r.FlagHasLOT ? "true" : "false"), @(r.IsActive ? "true" : "false"), '@Html.Raw(Html.Encode(r.Remark ?? ""))')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" action="/ProductSpec/ToggleStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-@(r.IsActive ? "warning" : "success")" title="@(r.IsActive ? "Tạm dừng áp dụng" : "Kích hoạt áp dụng")">
                                                <i class="bi bi-@(r.IsActive ? "pause-fill" : "play-fill")"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="/ProductSpec/Delete" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa quy cách \'@r.Code\'?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa quy cách">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm mới Quy cách -->
<div class="modal fade" id="createSpecModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/ProductSpec/Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Thêm mới Quy cách sản phẩm (Mst_Spec)</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Mã quy cách (SpecCode) <span class="text-danger">*</span></label>
                            <input type="text" name="code" class="form-control form-control-sm font-monospace text-uppercase" placeholder="vd: SPC-AO-SM-TRANG-L" required />
                            <div class="form-text text-muted small">Mã định danh duy nhất của phiên bản/quy cách</div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Tên quy cách / Phiên bản sản phẩm <span class="text-danger">*</span></label>
                            <input type="text" name="name" class="form-control form-control-sm" placeholder="vd: Áo sơ mi Slimfit Trắng - Size L" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Dòng sản phẩm (Model)</label>
                            <select name="modelCode" class="form-select form-select-sm">
                                <option value="">-- Chọn dòng Model --</option>
                                @foreach (var m in models)
                                {
                                    <option value="@m.Code">@m.Code — @m.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Phân loại cấp 1 (SpecType1)</label>
                            <select name="specType1" class="form-select form-select-sm">
                                <option value="">-- Phân loại cấp 1 --</option>
                                <option value="Tiêu chuẩn">Tiêu chuẩn</option>
                                <option value="Cao cấp">Cao cấp</option>
                                <option value="Công nghiệp">Công nghiệp</option>
                                <option value="Xuất khẩu">Xuất khẩu</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đơn vị tính tiêu chuẩn</label>
                            <select name="standardUnitCode" class="form-select form-select-sm">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Name">@u.Name (@u.Code)</option>
                                }
                                @if (units.Count == 0)
                                {
                                    <option value="cái">cái</option>
                                    <option value="chiếc">chiếc</option>
                                    <option value="bộ">bộ</option>
                                    <option value="can">can</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Phiên bản màu sắc (Color)</label>
                            <input type="text" name="color" class="form-control form-control-sm" placeholder="vd: Trắng Tinh (White), Đen Nhám (Matt Black)..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Điều kiện quản lý kho</label>
                            <div class="d-flex gap-3 pt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="flagHasSerial" value="true" id="addFlagHasSerial">
                                    <label class="form-check-label small fw-semibold text-info" for="addFlagHasSerial">
                                        <i class="bi bi-upc me-1"></i>Quản lý Serial/IMEI
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="flagHasLOT" value="true" id="addFlagHasLOT">
                                    <label class="form-check-label small fw-semibold text-warning" for="addFlagHasLOT">
                                        <i class="bi bi-calendar-check me-1"></i>Quản lý Lô & HSD
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="addIsActive" checked>
                                    <label class="form-check-label small" for="addIsActive">Áp dụng</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Mô tả thông số kỹ thuật (SpecDesc)</label>
                            <textarea name="specDesc" class="form-control form-control-sm" rows="2" placeholder="Form dáng, kích thước dài x rộng x cao, thông số vòng ngực, vòng eo, độ bền, tải trọng..."></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Ghi chú & Hướng dẫn lưu kho (Remark)</label>
                            <textarea name="remark" class="form-control form-control-sm" rows="2" placeholder="Tiêu chuẩn đóng gói, nhiệt độ bảo quản kho, dán tem nhãn QR/Barcode..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu Quy cách</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh sửa Quy cách -->
<div class="modal fade" id="editSpecModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" action="/ProductSpec/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editSpecId" />
                <div class="modal-header">
                    <h6 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa Quy cách sản phẩm</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Mã quy cách</label>
                            <input type="text" id="editSpecCode" class="form-control form-control-sm font-monospace bg-light" readonly />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Tên quy cách / Phiên bản sản phẩm <span class="text-danger">*</span></label>
                            <input type="text" name="name" id="editSpecName" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Dòng sản phẩm (Model)</label>
                            <select name="modelCode" id="editSpecModelCode" class="form-select form-select-sm">
                                <option value="">-- Chọn dòng Model --</option>
                                @foreach (var m in models)
                                {
                                    <option value="@m.Code">@m.Code — @m.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Phân loại cấp 1 (SpecType1)</label>
                            <select name="specType1" id="editSpecType1" class="form-select form-select-sm">
                                <option value="">-- Phân loại cấp 1 --</option>
                                <option value="Tiêu chuẩn">Tiêu chuẩn</option>
                                <option value="Cao cấp">Cao cấp</option>
                                <option value="Công nghiệp">Công nghiệp</option>
                                <option value="Xuất khẩu">Xuất khẩu</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Đơn vị tính tiêu chuẩn</label>
                            <select name="standardUnitCode" id="editSpecUnit" class="form-select form-select-sm">
                                @foreach (var u in units)
                                {
                                    <option value="@u.Name">@u.Name (@u.Code)</option>
                                }
                                @if (units.Count == 0)
                                {
                                    <option value="cái">cái</option>
                                    <option value="chiếc">chiếc</option>
                                    <option value="bộ">bộ</option>
                                    <option value="can">can</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Phiên bản màu sắc (Color)</label>
                            <input type="text" name="color" id="editSpecColor" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Điều kiện quản lý kho</label>
                            <div class="d-flex gap-3 pt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="flagHasSerial" value="true" id="editFlagHasSerial">
                                    <label class="form-check-label small fw-semibold text-info" for="editFlagHasSerial">
                                        <i class="bi bi-upc me-1"></i>Quản lý Serial
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="flagHasLOT" value="true" id="editFlagHasLOT">
                                    <label class="form-check-label small fw-semibold text-warning" for="editFlagHasLOT">
                                        <i class="bi bi-calendar-check me-1"></i>Quản lý Lô/Date
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="isActive" value="true" id="editIsActive">
                                    <label class="form-check-label small" for="editIsActive">Áp dụng</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Mô tả thông số kỹ thuật (SpecDesc)</label>
                            <textarea name="specDesc" id="editSpecDesc" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-semibold">Ghi chú & Hướng dẫn lưu kho (Remark)</label>
                            <textarea name="remark" id="editSpecRemark" class="form-control form-control-sm" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Xem chi tiết Quy cách -->
<div class="modal fade" id="detailSpecModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title fw-bold"><i class="bi bi-card-heading text-info me-2"></i>Chi tiết Quy cách & Danh sách Sản phẩm liên kết</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detailSpecContent">
                <div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditSpecModal(id, code, name, desc, modelCode, type1, color, unit, hasSerial, hasLot, active, remark) {
        document.getElementById('editSpecId').value = id;
        document.getElementById('editSpecCode').value = code;
        document.getElementById('editSpecName').value = name;
        document.getElementById('editSpecDesc').value = desc;
        document.getElementById('editSpecModelCode').value = modelCode;
        document.getElementById('editSpecType1').value = type1;
        document.getElementById('editSpecColor').value = color;
        document.getElementById('editSpecUnit').value = unit;
        document.getElementById('editFlagHasSerial').checked = hasSerial;
        document.getElementById('editFlagHasLOT').checked = hasLot;
        document.getElementById('editIsActive').checked = active;
        document.getElementById('editSpecRemark').value = remark;

        var modal = new bootstrap.Modal(document.getElementById('editSpecModal'));
        modal.show();
    }

    async function showSpecDetail(id) {
        var modalEl = document.getElementById('detailSpecModal');
        var modal = new bootstrap.Modal(modalEl);
        modal.show();

        var container = document.getElementById('detailSpecContent');
        container.innerHTML = '<div class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Đang tải dữ liệu...</div>';

        try {
            var res = await fetch('/ProductSpec/Detail?id=' + id);
            if (!res.ok) throw new Error('Không thể tải thông tin chi tiết');
            var data = await res.json();
            var spec = data.spec;
            var model = data.model;
            var brand = data.brand;
            var products = data.products || [];

            var serialBadge = spec.flagHasSerial
                ? '<span class="badge bg-info bg-opacity-10 text-info border border-info"><i class="bi bi-upc me-1"></i>Bắt buộc Serial/IMEI</span>'
                : '<span class="badge bg-light text-muted border">Không Serial</span>';

            var lotBadge = spec.flagHasLOT
                ? '<span class="badge bg-warning bg-opacity-10 text-dark border border-warning"><i class="bi bi-calendar-check me-1"></i>Bắt buộc Lô & HSD</span>'
                : '<span class="badge bg-light text-muted border">Không Lô</span>';

            var statusBadge = spec.isActive
                ? '<span class="badge bg-success bg-opacity-10 text-success border border-success">Đang áp dụng</span>'
                : '<span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary">Tạm dừng</span>';

            var productsHtml = '';
            if (products.length === 0) {
                productsHtml = '<tr><td colspan="5" class="text-center text-muted py-3">Chưa có mặt hàng nào liên kết với quy cách này.</td></tr>';
            } else {
                for (var i = 0; i < products.length; i++) {
                    var p = products[i];
                    productsHtml += '<tr>' +
                        '<td class="ps-3 text-muted">' + (i + 1) + '</td>' +
                        '<td><span class="badge bg-light text-dark font-monospace border">' + p.code + '</span></td>' +
                        '<td><div class="fw-semibold">' + p.name + '</div></td>' +
                        '<td class="text-center"><span class="badge bg-light text-secondary border">' + p.uom + '</span></td>' +
                        '<td class="text-end pe-3 fw-bold text-success">' + (p.costPrice ? p.costPrice.toLocaleString() + ' đ' : '--') + '</td>' +
                        '</tr>';
                }
            }

            var html = `
                <div class="card bg-light border-0 mb-3">
                    <div class="card-body py-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <span class="badge bg-primary font-monospace me-2">${spec.code}</span>
                                <span class="fw-bold fs-6">${spec.name}</span>
                            </div>
                            <div>${statusBadge}</div>
                        </div>
                        <div class="row g-2 small">
                            <div class="col-md-4">
                                <span class="text-muted">Dòng sản phẩm:</span>
                                <span class="fw-semibold text-dark">${model ? model.name + ' (' + model.code + ')' : (spec.modelCode || '--')}</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted">Thương hiệu:</span>
                                <span class="fw-semibold text-dark">${brand ? brand.name : '--'}</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted">Phân loại & Màu:</span>
                                <span class="fw-semibold text-dark">${spec.specType1 || '--'} / ${spec.color || '--'}</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted">ĐVT chuẩn:</span>
                                <span class="badge bg-white text-dark border">${spec.standardUnitCode || 'cái'}</span>
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted">Quản lý Serial:</span> ${serialBadge}
                            </div>
                            <div class="col-md-4">
                                <span class="text-muted">Quản lý Lô/Date:</span> ${lotBadge}
                            </div>
                            ${spec.specDesc ? '<div class="col-12"><span class="text-muted">Thông số kỹ thuật:</span> <span class="text-dark">' + spec.specDesc + '</span></div>' : ''}
                            ${spec.remark ? '<div class="col-12"><span class="text-muted">Ghi chú lưu kho:</span> <span class="text-dark">' + spec.remark + '</span></div>' : ''}
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0"><i class="bi bi-box-seam text-primary me-2"></i>Danh sách mặt hàng áp dụng quy cách (${data.totalProducts} SP)</h6>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success fw-bold">Tổng tồn kho: ${data.totalStockQty.toLocaleString()}</span>
                </div>

                <div class="table-responsive border rounded bg-white">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 40px;">STT</th>
                                <th style="width: 140px;">Mã mặt hàng</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-center" style="width: 80px;">ĐVT</th>
                                <th class="text-end pe-3" style="width: 130px;">Giá vốn</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${productsHtml}
                        </tbody>
                    </table>
                </div>
            `;

            container.innerHTML = html;
        } catch (err) {
            container.innerHTML = '<div class="alert alert-danger mb-0"><i class="bi bi-exclamation-triangle me-2"></i>' + err.message + '</div>';
        }
    }
</script>
}
